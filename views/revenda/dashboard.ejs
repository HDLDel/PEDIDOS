<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Painel - <%= reseller.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
  <style>
    .revenda-header {
      background: #050505;
      padding: 1rem 2rem;
      border-bottom: 1px solid #1a1a1a;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .revenda-header .logo { font-size: 1.2rem; font-weight: 900; }
    .revenda-header .logo span { color: var(--accent-red); }
    .revenda-header .user-info {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 0.85rem;
    }
    .revenda-header .btn-solicitar {
      background: var(--accent-red);
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 0.5rem;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
    }
    .revenda-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }
    .revenda-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1rem;
      margin-bottom: 2rem;
    }
    .revenda-stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 1.25rem;
      text-align: center;
    }
    .revenda-stat-card .number {
      font-size: 2rem;
      font-weight: 900;
      margin-bottom: 0.25rem;
    }
    .revenda-stat-card .label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .revenda-stat-card.pending .number { color: var(--accent-red); }
    .revenda-stat-card.approved .number { color: #10b981; }
    .revenda-stat-card.rejected .number { color: #6b7280; }
    
    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .requests-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 1.25rem;
    }
    .request-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      overflow: hidden;
      transition: border-color 0.2s;
      display: flex;
      flex-direction: column;
    }
    .request-card:hover { border-color: var(--accent-red); }
    .poster-container {
      width: 100%;
      aspect-ratio: 2/3;
      background: #111;
      position: relative;
      border-bottom: 1px solid var(--border);
    }
    .poster-container .poster {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }
    .request-card .info {
      padding: 1rem;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }
    .request-card .title {
      font-weight: 700;
      font-size: 0.95rem;
      margin-bottom: 0.5rem;
    }
    .request-card .meta {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 0.25rem;
    }
    .request-card .status-badge {
      display: inline-block;
      padding: 0.35rem 0.75rem;
      border-radius: 0.5rem;
      font-size: 0.75rem;
      font-weight: 700;
      text-transform: uppercase;
      margin-top: 0.75rem;
    }
    .status-badge.pending { background: rgba(220, 38, 38, 0.15); color: #ef4444; border: 1px solid rgba(220, 38, 38, 0.3); }
    .status-badge.approved { background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); }
    .status-badge.rejected { background: rgba(107, 114, 128, 0.15); color: #9ca3af; border: 1px solid rgba(107, 114, 128, 0.3); }
    
    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
    }
    .empty-state .icon { font-size: 3rem; margin-bottom: 1rem; opacity: 0.5; }
  </style>
</head>
<body>
  <header class="revenda-header">
    <div class="logo">PORTAL <span>VOD</span></div>
    <div class="user-info">
      <span>👤 <%= reseller.name %> | <%= reseller.whatsapp %></span>
      <a href="/revenda/solicitar" class="btn-solicitar">+ Nova Solicitação</a>
      <a href="/revenda/logout" style="color: var(--text-muted); font-size: 0.8rem; text-decoration: none;">Sair</a>
    </div>
  </header>

  <main class="revenda-container">
    <div class="revenda-stats">
      <div class="revenda-stat-card pending">
        <div class="number"><%= stats.pending %></div>
        <div class="label">Pendentes</div>
      </div>
      <div class="revenda-stat-card approved">
        <div class="number"><%= stats.approved %></div>
        <div class="label">Aprovados</div>
      </div>
      <div class="revenda-stat-card rejected">
        <div class="number"><%= stats.rejected %></div>
        <div class="label">Rejeitados</div>
      </div>
      <div class="revenda-stat-card" style="border-color: var(--accent-red);">
        <div class="number" style="color: var(--accent-red);"><%= requests.length %></div>
        <div class="label">Total</div>
      </div>
    </div>

    <h2 class="section-title">📋 Meus Pedidos</h2>
    
    <% if (requests.length === 0) { %>
      <div class="empty-state">
        <div class="icon">📭</div>
        <h3>Nenhum pedido ainda</h3>
        <p>Clique em "Nova Solicitação" para fazer seu primeiro pedido.</p>
      </div>
    <% } else { %>
      <div class="requests-list">
        <% requests.forEach(req => { %>
          <article class="request-card">
            <div class="poster-container">
              <img src="<%= req.poster %>" 
                   alt="<%= req.title %>" class="poster">
            </div>
            <div class="info">
              <div class="title"><%= req.title %></div>
              <div class="meta">🎬 <%= req.type === 'series' ? 'Série' : 'Filme' %> 
                <% if (req.year) { %>| <%= req.year %><% } %>
              </div>
              <% if (req.season) { %>
                <div class="meta">📺 Temporada <%= req.season %></div>
              <% } %>
              <% if (req.episode) { %>
                <div class="meta">▶️ Episódio <%= req.episode %></div>
              <% } %>
              <div class="meta">📅 <%= req.date %> <%= req.time %></div>
              <div class="meta">📝 <%= req.action %></div>
              <% if (req.rejectionReason) { %>
                <div class="meta" style="color: #ef4444; margin-top: 0.5rem;">
                  ❌ <%= req.rejectionReason %>
                </div>
              <% } %>
              <span class="status-badge <%= req.status %>">
                <%= req.status === 'pending' ? '⏳ Pendente' : req.status === 'approved' ? '✅ Aprovado' : '❌ Rejeitado' %>
              </span>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>
