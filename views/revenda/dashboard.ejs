<!DOCTYPE html>
<html lang="pt-br">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Meu Painel - <%= reseller.name %>
  </title>
  <link rel="stylesheet" href="/css/style.css">
  <script>
      (function() {
          try {
              const theme = localStorage.getItem('theme');
              if (theme === 'light') {
                  document.documentElement.classList.add('light-theme');
                  document.addEventListener('DOMContentLoaded', () => {
                      document.body.classList.add('light-theme');
                  });
              }
          } catch (e) {
              console.error('Falha ao acessar o localStorage:', e);
          }
      })();
  </script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .revenda-header {
      background: rgba(11, 11, 15, 0.95);
      padding: 1rem 2rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      display: flex;
      justify-content: space-between;
      align-items: center;
      backdrop-filter: blur(10px);
      position: sticky;
      top: 0;
      z-index: 100;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    }

    .revenda-header .logo {
      font-size: 1.2rem;
      font-weight: 900;
      color: var(--text-primary);
    }

    .revenda-header .logo span {
      color: var(--btn-blue);
    }

    .revenda-header .user-info {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: var(--text-muted);
      font-size: 0.85rem;
    }

    .revenda-header .btn-solicitar {
      background: var(--btn-blue);
      color: white;
      border: none;
      padding: 0.6rem 1.2rem;
      border-radius: 8px;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      transition: all 0.2s ease;
    }

    .revenda-header .btn-solicitar:hover {
      background: var(--accent-blue-hover);
    }

    .revenda-container {
      max-width: 1400px;
      margin: 0 auto;
      padding: 2rem;
    }

    .revenda-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
      margin-bottom: 2rem;
    }

    .revenda-stat-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1rem;
      text-align: center;
      transition: all 0.2s ease;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
    }

    .revenda-stat-card:hover {
      border-color: var(--btn-blue);
    }

    .revenda-stat-card .number {
      font-size: 2rem;
      font-weight: 900;
      margin-bottom: 0.25rem;
      color: var(--text-primary);
    }

    .revenda-stat-card .label {
      font-size: 0.85rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .revenda-stat-card.pending .number {
      color: var(--status-pending);
    }

    .revenda-stat-card.approved .number {
      color: var(--status-approved);
    }

    .revenda-stat-card.rejected .number {
      color: var(--status-rejected);
    }

    .section-title {
      font-size: 1.1rem;
      font-weight: 700;
      margin-bottom: 1rem;
      display: flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--text-primary);
    }

    .requests-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }

    .request-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 16px;
      overflow: hidden;
      transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      display: flex;
      flex-direction: column;
      padding: 6px;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5);
    }

    .request-card:hover {
      transform: translateY(-4px);
      border-color: var(--btn-blue);
      box-shadow: 0 12px 30px rgba(0, 0, 0, 0.7), 0 0 15px rgba(47, 128, 237, 0.15);
    }

    .poster-container {
      width: 100%;
      aspect-ratio: 2/3;
      background: #0d0f13;
      position: relative;
      border-radius: 12px;
      overflow: hidden;
    }

    .poster-container .poster {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .request-card .info {
      padding: 8px 6px;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .request-card .title {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      color: var(--text-primary);
    }

    .info-item {
      font-size: 0.85rem;
      color: var(--text-muted);
      margin-bottom: 2px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .info-item i {
      width: 14px;
      text-align: center;
      color: var(--btn-blue);
    }

    .badge-status {
      position: absolute;
      top: 8px;
      right: 8px;
      padding: 4px 8px;
      border-radius: 6px;
      font-size: 11px;
      font-weight: 800;
      text-transform: uppercase;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(4px);
      border: 1px solid;
      z-index: 10;
    }

    .status-pending {
      border-color: var(--status-pending);
      color: var(--status-pending);
    }

    .status-approved {
      border-color: var(--status-approved);
      color: var(--status-approved);
    }

    .status-rejected {
      border-color: var(--status-rejected);
      color: var(--status-rejected);
    }

    .empty-state {
      text-align: center;
      padding: 4rem 2rem;
      color: var(--text-muted);
      grid-column: 1 / -1;
    }

    .empty-state .icon {
      font-size: 3rem;
      margin-bottom: 1rem;
      opacity: 0.5;
    }

    .btn {
      padding: 8px;
      border-radius: 8px;
      border: 1px solid transparent;
      font-weight: 800;
      cursor: pointer;
      font-size: 0.75rem;
      transition: all 0.2s;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      font-family: inherit;
      height: 34px;
    }

    /* Modal Styles */
    .modal-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0, 0, 0, 0.85);
      z-index: 3000;
      align-items: center;
      justify-content: center;
      backdrop-filter: blur(4px);
    }
  </style>
</head>

<body>
  <header class="revenda-header">
    <div class="logo">PORTAL <span>VOD</span></div>
    <div class="user-info" style="display: flex; align-items: center; gap: 15px;">
      <span><%= reseller.name %> | <%= reseller.whatsapp %></span>
      <button id="themeToggleBtn" style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s;" onclick="toggleTheme()" title="Alternar Tema">
          <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
      </button>
      <a href="/revenda/solicitar" class="btn-solicitar">+ Nova Solicitação</a>
      <a href="/revenda/logout" style="color: var(--text-muted); font-size: 0.8rem; text-decoration: none; margin-left: 5px;">Sair</a>
    </div>
  </header>

  <main class="revenda-container">
    <div class="revenda-stats">
      <div class="revenda-stat-card pending">
        <div class="number">
          <%= stats.pending %>/10
        </div>
        <div class="label">Pendentes</div>
      </div>
      <div class="revenda-stat-card approved">
        <div class="number">
          <%= stats.approved %>
        </div>
        <div class="label">Aprovados</div>
      </div>
      <div class="revenda-stat-card rejected">
        <div class="number">
          <%= stats.rejected %>
        </div>
        <div class="label">Rejeitados</div>
      </div>
      <div class="revenda-stat-card" style="border-color: var(--accent-red);">
        <div class="number" style="color: var(--accent-red);">
          <%= requests.length %>
        </div>
        <div class="label">Total</div>
      </div>
    </div>

    <!-- Banner de Alerta sobre Demora -->
    <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.3); padding: 12px 20px; border-radius: 8px; margin-bottom: 2rem; display: flex; align-items: center; justify-content: space-between; gap: 15px; cursor: pointer; transition: background 0.2s;" onclick="openDemoraModal()" onmouseover="this.style.background='rgba(245, 158, 11, 0.15)'" onmouseout="this.style.background='rgba(245, 158, 11, 0.1)'">
      <div style="display: flex; align-items: center; gap: 12px; color: #f59e0b; font-weight: 600; font-size: 0.9rem;">
        <i class="fas fa-exclamation-triangle" style="font-size: 1.2rem;"></i>
        <span>Por que meu pedido demora a ser atendido?</span>
      </div>
      <span style="color: #f59e0b; font-size: 0.8rem; font-weight: bold; background: rgba(245, 158, 11, 0.2); padding: 4px 8px; border-radius: 4px; text-transform: uppercase;">Clique aqui para saber mais</span>
    </div>

    <!-- Modal de Explicação de Demora de Pedidos -->
    <div id="demoraModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1200; align-items: center; justify-content: center;">
      <div style="background: #111; border: 1px solid #333; padding: 25px; border-radius: 12px; width: 95%; max-width: 600px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); max-height: 90vh; overflow-y: auto; text-align: left;">
        <h3 style="color: #f59e0b; margin-bottom: 20px; font-weight: 700; display: flex; align-items: center; gap: 10px; font-size: 1.2rem; border-bottom: 1px solid #222; padding-bottom: 12px;">
          <i class="fas fa-exclamation-triangle"></i> Por que é difícil achar alguns filmes, séries e novelas na internet?
        </h3>
        
        <div style="display: flex; flex-direction: column; gap: 15px; font-size: 0.9rem; line-height: 1.6; color: #ccc;">
          <div>
            <strong style="color: #fff; font-size: 0.95rem; display: block; margin-bottom: 4px;">📂 Coisas antigas somem:</strong>
            Muitas novelas e séries de antigamente são quase impossíveis de achar porque ninguém guardou os arquivos, ou as fitas estragaram com o tempo. Se ninguém salvou, não tem como baixar.
          </div>
          
          <div>
            <strong style="color: #fff; font-size: 0.95rem; display: block; margin-bottom: 4px;">🎤 Falta de dublagem:</strong>
            A maioria dos doramas (novelas asiáticas), novelas mexicanas e turcas não tem voz em português. Dublar um filme é muito caro, e as empresas só pagam por isso se tiver certeza de que muita gente vai assistir e dar lucro.
            <br>
            <span style="color: #f59e0b; font-weight: 600; display: block; margin-top: 5px;">Portanto, a maioria dos pedidos desses conteúdos se for atendido vai ser legendado, a não ser que a dublagem esteja disponível.</span>
          </div>
          
          <div>
            <strong style="color: #fff; font-size: 0.95rem; display: block; margin-bottom: 4px;">⚖️ Problemas com contratos:</strong>
            Às vezes, o filme existe, mas nenhuma empresa do Brasil pagou os direitos autorais para poder passar ele aqui de forma legal.
          </div>
          
          <div>
            <strong style="color: #fff; font-size: 0.95rem; display: block; margin-bottom: 4px;">📉 Falta de interesse:</strong>
            Se pouca gente procura por um conteúdo, os sites e aplicativos de streaming (como Netflix e Globoplay) simplesmente não gastam dinheiro nem espaço para colocar ele no ar.
            <br>
            <span style="color: #f59e0b; font-weight: 600; display: block; margin-top: 5px;">Portanto, alguns pedidos, principalmente de conteúdos exóticos, podem não ser atendidos.</span>
          </div>
          
          <div style="border-top: 1px solid #222; padding-top: 15px; margin-top: 5px;">
            <strong style="color: #f59e0b; font-size: 0.95rem; display: block; margin-bottom: 4px;">⚠️ Por que só posso manter 10 pedidos pendentes?</strong>
            Como trabalhamos com equipe limitada e alguns conteúdos são difíceis de encontrar, não podemos permitir que o número de pedidos pendentes seja infinito, pois isso poluiria o gestor de pedidos e tornaria o trabalho de busca impossível. Além disso, as constantes manutenções e atualizações do servidor demandam tempo da equipe, o que acaba desacelerando o fluxo do gestor de pedidos.
          </div>
          
          <div style="margin-top: 15px; font-weight: bold; text-align: center; color: #fff; font-size: 0.95rem;">
            Agradecemos a compreensão.
          </div>
        </div>
        
        <div style="display: flex; justify-content: flex-end; margin-top: 20px; border-top: 1px solid #222; padding-top: 15px;">
          <button onclick="closeDemoraModal()" style="background: #f59e0b; color: #000; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; transition: 0.2s;" onmouseover="this.style.background='#ffb74d'" onmouseout="this.style.background='#f59e0b'">ENTENDI</button>
        </div>
      </div>
    </div>

    <h2 class="section-title">📋 Meus Pedidos</h2>

    <% if (requests.length === 0) { %>
      <div class="empty-state">
        <div class="icon">📭</div>
        <h3>Nenhum pedido ainda</h3>
        <p>Clique em "Nova Solicitação" para fazer seu primeiro pedido.</p>
      </div>
    <% } else { %>
      <div class="requests-list">
        <% requests.forEach(req => { %>
          <article class="request-card">
            <div class="poster-container">
              <img src="<%= req.poster %>" alt="<%= req.title %>" class="poster">
              <span class="badge-status status-<%= req.status %>">
                <%= req.status==='pending' ? 'Pendente' : req.status==='approved' ? 'Aprovado' : 'Rejeitado' %>
              </span>
            </div>
            <div class="info">
              <div style="font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; letter-spacing: 0.5px; margin-bottom: 2px;">TÍTULO</div>
              <h4 class="title" title="<%= req.title %>">
                <%= req.title %>
              </h4>
              <div class="info-item"><i class="fas fa-calendar-day"></i> Lançamento: <%= req.year || 'N/A' %></div>
              
              <% if (req.season) { %>
                <div class="info-item"><i class="fas fa-list-ol"></i> Temporada <%= req.season %></div>
              <% } %>
              
              <% if (req.episode) { %>
                <div class="info-item"><i class="fas fa-list-ol"></i> Episódio <%= req.episode %></div>
              <% } %>
              
              <% if (req.audioPreference) { %>
                <div class="info-item"><i class="fas fa-volume-up"></i> Áudio: <strong><%= req.audioPreference %></strong></div>
              <% } %>
              
              <div class="info-item"><i class="far fa-calendar-alt"></i> <%= req.date %> às <%= req.time %></div>
              <div class="info-item"><i class="fas fa-tag"></i> <%= req.action %></div>
              
              <% 
                let hasChatHistory = !!(req.rejectionReason || req.description); 
                let replyCount = 0;
                if (req.description) {
                  replyCount = (req.description.match(/\[Resposta do Revendedor/g) || []).length;
                }
                let chatDescription = req.description || '';
                if (req.rejectionReason && !chatDescription.includes('[Rejeitado pelo Admin')) {
                  chatDescription = (chatDescription ? chatDescription + '\n' : '') + `[Rejeitado pelo Admin - Motivo: ${req.rejectionReason}]`;
                }
              %>
              
              <% if (hasChatHistory) { %>
                <button class="btn" style="margin-top: 10px; background: rgba(37, 99, 235, 0.15); border: 1px solid #2563eb; color: #3b82f6; width: 100%;" 
                        onclick="openChatModal('<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '<%= encodeURIComponent(chatDescription).replace(/'/g, "%27") %>')">
                  <i class="fas fa-comments"></i> Histórico de Conversa
                </button>
              <% } %>
              
              <% if (req.status !== 'approved' && replyCount < 2) { %>
                <button class="btn" style="margin-top: 5px; background: #2563eb; color: white; width: 100%;" 
                        onclick="openExplanationModal(<%= req.id %>, '<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '<%= encodeURIComponent(req.rejectionReason || '').replace(/'/g, "%27") %>')">
                  <i class="fas fa-comment-dots"></i> Responder / Explicar
                </button>
              <% } %>
              
              <% if (req.status !== 'approved' && replyCount >= 2) { %>
                <div style="color: #ef4444; font-size: 0.75rem; margin-top: 8px; font-weight: bold; text-align: center; display: flex; align-items: center; justify-content: center; gap: 5px; background: rgba(239, 68, 68, 0.05); padding: 6px; border-radius: 6px; border: 1px dashed rgba(239, 68, 68, 0.3);">
                  <i class="fas fa-ban"></i> Limite de contestações atingido (Máx: 2)
                </div>
              <% } %>
              
              <% if (req.status === 'pending') { %>
                <button class="btn" style="margin-top: 5px; background: rgba(220, 38, 38, 0.15); border: 1px solid #dc2626; color: #ef4444; width: 100%;" 
                        onclick="deleteRequest(<%= req.id %>, '<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>')">
                  <i class="fas fa-trash-alt"></i> Excluir Pedido
                </button>
              <% } %>
            </div>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>

  <!-- Modal de Explicação/Resposta do Revendedor -->
  <div id="explanationModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1000; align-items: center; justify-content: center;">
    <div style="background: #111; border: 1px solid #333; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); max-height: 90vh; overflow-y: auto;">
      <h3 style="color: #fff; margin-bottom: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px;">💬 Explicar / Responder</h3>
      <p style="font-size: 0.9rem; color: #aaa; margin-bottom: 10px;"><strong>Pedido:</strong> <span id="explainModalTitle" style="color: #fff;"></span></p>
      
      <div id="explainModalReasonContainer" style="background: rgba(245, 158, 11, 0.1); border: 1px solid rgba(245, 158, 11, 0.2); padding: 10px; border-radius: 6px; margin-bottom: 15px; font-size: 0.85rem; display: none; max-height: 300px; overflow-y: auto; white-space: pre-wrap;">
        <strong style="color: #f59e0b;">Nota/Dúvida do Admin:</strong> <span id="explainModalReason" style="color: #fff;"></span>
      </div>
      
      <textarea id="explanationText" rows="6" style="width: 100%; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; padding: 12px; font-family: inherit; font-size: 0.9rem; margin-bottom: 20px; resize: vertical;" placeholder="Escreva aqui a sua explicação detalhada, resposta ou correção para o administrador..."></textarea>
      
      <div style="display: flex; justify-content: flex-end; gap: 10px;">
        <button onclick="closeExplanationModal()" style="background: #333; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">Cancelar</button>
        <button onclick="submitExplanation()" style="background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">Enviar Resposta</button>
      </div>
    </div>
  </div>

  <!-- Modal de Histórico de Conversa (Chat) -->
  <div id="chatModal" class="modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); z-index: 1100; align-items: center; justify-content: center;">
    <div style="background: #111; border: 1px solid #333; padding: 25px; border-radius: 12px; width: 90%; max-width: 500px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
      <h3 style="color: #fff; margin-bottom: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px;"><i class="fas fa-comments" style="color: #3b82f6;"></i> Histórico de Conversa</h3>
      <p style="font-size: 0.95rem; margin-bottom: 15px; color: #aaa;"><strong>Pedido:</strong> <span id="chatModalTitle" style="color: #fff; font-weight: bold;"></span></p>
      
      <div id="chatMessagesContainer" style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 10px; background: #050505; border-radius: 8px; border: 1px solid #1a1a1a;">
        <!-- Mensagens injetadas dinamicamente -->
      </div>
      
      <div style="display: flex; justify-content: flex-end; margin-top: 20px; border-top: 1px solid #222; padding-top: 15px;">
        <button onclick="closeChatModal()" style="background: #333; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">FECHAR</button>
      </div>
    </div>
  </div>

  <script>
    let explainRequestId = null;

    function openExplanationModal(id, title, reason) {
      explainRequestId = id;
      document.getElementById('explainModalTitle').innerText = decodeURIComponent(title);
      
      const decodedReason = decodeURIComponent(reason);
      const reasonContainer = document.getElementById('explainModalReasonContainer');
      if (decodedReason && decodedReason.trim() !== '' && decodedReason !== 'null' && decodedReason !== 'undefined') {
        document.getElementById('explainModalReason').innerText = decodedReason;
        reasonContainer.style.display = 'block';
      } else {
        reasonContainer.style.display = 'none';
      }
      
      document.getElementById('explanationText').value = '';
      document.getElementById('explanationModal').style.display = 'flex';
    }

    function closeExplanationModal() {
      document.getElementById('explanationModal').style.display = 'none';
    }

    async function submitExplanation() {
      const explanation = document.getElementById('explanationText').value.trim();
      if (!explanation) {
        alert('Por favor, digite sua explicação antes de enviar.');
        return;
      }

      try {
        const response = await fetch(`/api/requests/${explainRequestId}/respond`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ explanation })
        });

        if (response.ok) {
          alert('Resposta enviada com sucesso! O pedido voltou para a fila de pendentes.');
          location.reload();
        } else {
          alert('Erro ao enviar resposta.');
        }
      } catch (error) {
        console.error('Erro:', error);
        alert('Falha na comunicação com o servidor.');
      }
    }

    function openChatModal(title, encodedDescription) {
      const description = decodeURIComponent(encodedDescription);
      document.getElementById('chatModalTitle').innerText = decodeURIComponent(title);
      
      const container = document.getElementById('chatMessagesContainer');
      container.innerHTML = '';
      
      // Separar as mensagens por bloco de resposta
      const blocks = description.split(/(?=\[Rejeitado pelo Admin|\[Resposta do Revendedor)/g);
      
      blocks.forEach(block => {
        const trimmed = block.trim();
        if (!trimmed) return;
        
        let isReseller = trimmed.startsWith('[Resposta do Revendedor');
        let isRejection = trimmed.startsWith('[Rejeitado pelo Admin');
        
        let bubbleStyle = '';
        let headerText = '';
        let contentText = '';
        
        if (isReseller) {
          bubbleStyle = 'background: rgba(37, 99, 235, 0.15); border-left: 3px solid #2563eb; color: #e2e8f0; align-self: flex-end; width: 90%;';
          const match = trimmed.match(/\[Resposta do Revendedor em ([^\]]+)\]:\s*([\s\S]*)/);
          if (match) {
            headerText = `👤 Revendedor (${match[1]})`;
            contentText = match[2];
          } else {
            headerText = `👤 Minha Resposta`;
            contentText = trimmed;
          }
        } else if (isRejection) {
          bubbleStyle = 'background: rgba(239, 68, 68, 0.15); border-left: 3px solid #ef4444; color: #e2e8f0; align-self: flex-start; width: 90%;';
          const match = trimmed.match(/\[Rejeitado pelo Admin - Motivo: ([^\]]+)\]\s*([\s\S]*)/);
          if (match) {
            headerText = `🚨 Rejeitado pelo Admin - Motivo: ${match[1]}`;
            contentText = match[2] || 'Sem detalhes adicionais.';
          } else {
            headerText = `🚨 Rejeitado pelo Admin`;
            contentText = trimmed;
          }
        } else {
          bubbleStyle = 'background: rgba(255, 255, 255, 0.05); border-left: 3px solid #555; color: #ccc; align-self: flex-start; width: 90%;';
          headerText = `📝 Observações do Pedido`;
          contentText = trimmed;
        }
        
        container.innerHTML += `
          <div style="padding: 10px 12px; border-radius: 8px; font-size: 0.85rem; word-break: break-word; line-height: 1.4; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); ${bubbleStyle}">
            <div style="font-weight: bold; font-size: 0.75rem; color: #fff; opacity: 0.9; margin-bottom: 2px;">${headerText}</div>
            <div style="white-space: pre-wrap;">${contentText}</div>
          </div>
        `;
      });
      
      if (container.innerHTML === '') {
        container.innerHTML = '<div style="color: #666; text-align: center; font-size: 0.85rem; padding: 20px;">Nenhuma observação registrada.</div>';
      }
      
      document.getElementById('chatModal').style.display = 'flex';
    }

    function closeChatModal() {
      document.getElementById('chatModal').style.display = 'none';
    }

    function openDemoraModal() {
      document.getElementById('demoraModal').style.display = 'flex';
    }

    function closeDemoraModal() {
      document.getElementById('demoraModal').style.display = 'none';
    }

    async function deleteRequest(id, title) {
      const decodedTitle = decodeURIComponent(title);
      if (!confirm(`Tem certeza de que deseja excluir o pedido de "${decodedTitle}"? Esta ação liberará espaço na sua fila de pendentes.`)) {
        return;
      }

      try {
        const response = await fetch(`/api/requests/revenda/${id}`, {
          method: 'DELETE'
        });

        if (response.ok) {
          alert('Pedido excluído com sucesso!');
          location.reload();
        } else {
          const data = await response.json();
          alert(data.error || 'Erro ao excluir pedido.');
        }
      } catch (error) {
        console.error('Erro:', error);
        alert('Falha na comunicação com o servidor.');
      }
    }

    function toggleTheme() {
      const isLight = document.documentElement.classList.toggle('light-theme');
      document.body.classList.toggle('light-theme', isLight);
      try {
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      } catch (e) {
        console.error('Falha ao salvar o tema:', e);
      }
      updateThemeIcon(isLight);
    }

    function updateThemeIcon(isLight) {
      const icon = document.getElementById('themeIcon');
      if (icon) {
        if (isLight) {
          icon.className = 'fas fa-moon';
          icon.style.color = '#374151';
        } else {
          icon.className = 'fas fa-sun';
          icon.style.color = '#f59e0b';
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
      const isLight = document.documentElement.classList.contains('light-theme');
      updateThemeIcon(isLight);
    });
  </script>
</body>
</html>