<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Revendedor - VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/reseller.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .request-form {
            background: #141414;
            padding: 2.5rem;
            border-radius: 1.2rem;
            border: 1px solid #2b2b2b;
            margin-top: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }
        .request-form label {
            display: block;
            font-size: 1rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
            color: #b3b3b3;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .request-form select, 
        .request-form input, 
        .request-form textarea {
            width: 100%;
            background: #050505;
            border: 2px solid #333;
            color: #fff;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 1.2rem; /* Fonte aumentada conforme solicitado */
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: 'Inter', sans-serif;
        }
        .request-form select:focus, 
        .request-form input:focus, 
        .request-form textarea:focus {
            border-color: #e50914;
            box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.15);
            outline: none;
            background: #000;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 1rem;
        }
        .form-group {
            margin-bottom: 2rem;
        }
        .form-actions {
            display: flex;
            gap: 1.5rem;
            margin-top: 3rem;
        }
        .btn-submit {
            flex: 2;
            background: linear-gradient(135deg, #e50914 0%, #991b1b 100%);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 900;
            font-size: 1.1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
        }
        .btn-submit:hover {
            transform: translateY(-2px) scale(1.01);
            filter: brightness(1.2);
            box-shadow: 0 8px 25px rgba(229, 9, 20, 0.5);
        }
        .btn-cancel {
            flex: 1;
            background: #262626;
            color: #a0a0a0;
            border: 1px solid #333;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-cancel:hover {
            background: #333;
            color: #fff;
            border-color: #444;
        }
        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; gap: 1rem; }
            .form-actions { flex-direction: column-reverse; }
            .request-form { padding: 1.5rem; }
        }
    </style>
</head>
<body class="dark-theme">
    <header class="header">
        <div class="logo">VOD<span>PREMIUM</span></div>
        <div class="user-info">
            <a href="/revenda/dashboard" style="background: #333; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 15px;"><i class="fas fa-arrow-left"></i> Voltar ao Painel</a>
            <span>Olá, <strong><%= reseller.name %></strong></span>
            <a href="/revenda/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </header>

    <main class="container">
        <section class="request-section">
            <h2><i class="fas fa-plus-circle"></i> Novo Pedido</h2>
            
            <div class="search-box">
                <input type="text" id="tmdbSearch" placeholder="Digite o nome do filme ou série...">
                <button id="btnSearch"><i class="fas fa-search"></i> Buscar</button>
            </div>

            <div id="tmdbResults" class="tmdb-results-grid">
                <!-- Resultados do TMDB aparecerão aqui -->
            </div>

            <form id="requestForm" class="request-form hidden">
                <input type="hidden" id="selectedId">
                <input type="hidden" id="selectedTitle">
                <input type="hidden" id="selectedType">
                <input type="hidden" id="selectedPoster">

                <div class="selected-preview">
                    <img id="previewPoster" src="" alt="">
                    <div class="preview-info">
                        <h3 id="previewTitle"></h3>
                        <span id="previewYear"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>O que deseja solicitar?</label>
                    <select id="requestAction" required>
                        <option value="content">Adicionar ao catálogo</option>
                        <option value="season">Solicitar nova temporada</option>
                        <option value="episode">Solicitar episódios faltando</option>
                        <option value="error">Reportar erro de reprodução</option>
                    </select>
                </div>

                <div id="extraFields" class="form-row">
                    <div class="form-group">
                        <label>Temporada</label>
                        <input type="text" id="reqSeason" placeholder="Ex: 2">
                    </div>
                    <div class="form-group">
                        <label>Episódio(s)</label>
                        <input type="text" id="reqEpisode" placeholder="Ex: 10 a 15">
                    </div>
                </div>

                <div id="errorField" class="form-group hidden">
                    <label>Detalhes técnicos do erro</label>
                    <textarea id="reqDescription" placeholder="Descreva o erro (ex: travamento aos 10:30, tela preta, sem áudio...)"></textarea>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="resetForm()">Cancelar</button>
                    <button type="submit" class="btn-submit">Enviar Solicitação</button>
                </div>
            </form>
        </section>

        <section class="my-requests">
            <h2><i class="fas fa-history"></i> Meus Pedidos Recentes</h2>
            <div class="requests-list">
                <% requests.slice(0, 5).forEach(req => { %>
                    <div class="mini-card">
                        <div class="status-indicator status-<%= req.status %>"></div>
                        <div class="mini-info">
                            <strong><%= req.title %></strong>
                            <span><%= req.date %> às <%= req.time %></span>
                        </div>
                        <span class="badge-status"><%= req.status.toUpperCase() %></span>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>

    <script>
        const API_KEY = '<TMDB_API_KEY>';

        document.getElementById('btnSearch').addEventListener('click', async () => {
            const query = document.getElementById('tmdbSearch').value;
            if (query.length < 3) return alert('Digite pelo menos 3 caracteres');

            const resultsDiv = document.getElementById('tmdbResults');
            resultsDiv.innerHTML = '<div class="loader">Buscando...</div>';

            try {
                const res = await fetch(`https://api.themoviedb.org/3/search/multi?api_key=${API_KEY}&query=${encodeURIComponent(query)}&language=pt-BR`);
                const data = await res.json();
                
                resultsDiv.innerHTML = '';
                data.results.filter(i => i.media_type !== 'person').slice(0, 20).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'tmdb-mini-card';
                    const title = item.title || item.name;
                    const date = item.release_date || item.first_air_date || '';
                    const year = date ? date.split('-')[0] : 'N/A';
                    const poster = item.poster_path ? `https://image.tmdb.org/t/p/w200${item.poster_path}` : 'https://via.placeholder.com/200x300?text=Sem+Poster';

                    card.innerHTML = `
                        <img src="${poster}" alt="${title}">
                        <div class="info">
                            <h4>${title}</h4>
                            <span>${year} • ${item.media_type === 'tv' ? 'Série' : 'Filme'}</span>
                        </div>
                    `;
                    card.onclick = () => selectWork(item, poster, title, year);
                    resultsDiv.appendChild(card);
                });
            } catch (e) {
                resultsDiv.innerHTML = 'Erro ao buscar dados.';
            }
        });

        function selectWork(item, poster, title, year) {
            document.getElementById('tmdbResults').classList.add('hidden');
            document.getElementById('requestForm').classList.remove('hidden');
            
            document.getElementById('selectedId').value = item.id;
            document.getElementById('selectedTitle').value = title;
            document.getElementById('selectedType').value = item.media_type;
            document.getElementById('selectedPoster').value = poster;

            document.getElementById('previewPoster').src = poster;
            document.getElementById('previewTitle').innerText = title;
            document.getElementById('previewYear').innerText = year;
        }

        document.getElementById('requestAction').addEventListener('change', (e) => {
            const isError = e.target.value === 'error';
            document.getElementById('errorField').classList.toggle('hidden', !isError);
            document.getElementById('extraFields').classList.toggle('hidden', isError);
        });

        function resetForm() {
            document.getElementById('requestForm').classList.add('hidden');
            document.getElementById('tmdbResults').classList.remove('hidden');
            document.getElementById('tmdbSearch').value = '';
        }

        document.getElementById('requestForm').onsubmit = async (e) => {
            e.preventDefault();
            
            const payload = {
                tmdbId: document.getElementById('selectedId').value,
                title: document.getElementById('selectedTitle').value,
                type: document.getElementById('selectedType').value === 'tv' ? 'series' : 'movie',
                requestType: document.getElementById('requestAction').value,
                season: document.getElementById('reqSeason').value,
                episode: document.getElementById('reqEpisode').value,
                description: document.getElementById('reqDescription').value,
                date: new Date().toLocaleDateString('pt-BR'),
                time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
            };

            try {
                const res = await fetch('/api/requests', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    alert('Pedido enviado com sucesso!');
                    window.location.href = '/revenda/dashboard';
                } else {
                    const data = await res.json();
                    alert(data.error || 'Erro ao enviar pedido.');
                    
                    // Se for erro de duplicidade (409), redireciona para a dashboard
                    if (res.status === 409) {
                        window.location.href = '/revenda/dashboard';
                    }
                }
            } catch (err) {
                alert('Erro ao enviar pedido.');
            }
        };
    </script>
</body>
</html>