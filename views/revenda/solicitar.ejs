<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Revendedor - VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/reseller.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .request-form {
            background: #141414;
            padding: 2.5rem;
            border-radius: 1.2rem;
            border: 1px solid #2b2b2b;
            margin-top: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }
        .request-form label {
            display: block;
            font-size: 1rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
            color: #b3b3b3;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .request-form select, 
        .request-form input, 
        .request-form textarea {
            width: 100%;
            background: #050505;
            border: 2px solid #333;
            color: #fff;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 1.2rem; /* Fonte aumentada conforme solicitado */
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: 'Inter', sans-serif;
        }
        .request-form select:focus, 
        .request-form input:focus, 
        .request-form textarea:focus {
            border-color: #e50914;
            box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.15);
            outline: none;
            background: #000;
        }
        #requestAction {
            width: fit-content;
            min-width: 280px;
            padding: 8px 14px;
            font-size: 1.0rem;
            border-width: 1px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 1rem;
        }
        .form-group {
            margin-bottom: 2rem;
        }
        .form-actions {
            display: flex;
            gap: 1.5rem;
            margin-top: 3rem;
        }
        .btn-submit {
            flex: 2;
            background: linear-gradient(135deg, #e50914 0%, #991b1b 100%);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 900;
            font-size: 1.1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
        }
        .btn-submit:hover {
            transform: translateY(-2px) scale(1.01);
            filter: brightness(1.2);
            box-shadow: 0 8px 25px rgba(229, 9, 20, 0.5);
        }
        .btn-submit:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
            filter: none;
        }
        .btn-cancel {
            flex: 1;
            background: #262626;
            color: #a0a0a0;
            border: 1px solid #333;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-cancel:hover {
            background: #333;
            color: #fff;
            border-color: #444;
        }
        .audio-preference-group {
            display: flex;
            gap: 1.2rem;
            background: #050505;
            padding: 5px 12px;
            border-radius: 10px;
            border: 1px solid #222;
            width: fit-content;
        }
        .radio-container {
            display: flex;
            align-items: center;
            cursor: pointer;
            color: #fff;
            font-weight: 600;
            gap: 6px;
            user-select: none;
            font-size: 0.8rem;
        }
        .radio-container input {
            display: none;
        }
        .radio-checkmark {
            height: 13px;
            width: 13px;
            background-color: #222;
            border-radius: 50%;
            border: 1px solid #444;
            display: inline-block;
            position: relative;
        }
        .radio-container input:checked ~ .radio-checkmark {
            background-color: #e50914;
            border-color: #e50914;
        }
        .radio-checkmark:after {
            content: "";
            position: absolute;
            display: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: white;
        }
        .radio-container input:checked ~ .radio-checkmark:after {
            display: block;
        }
        .limit-warning {
            background: rgba(229, 9, 20, 0.2);
            border: 1px solid var(--accent-red);
            color: #ffbaba;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .hidden {
            display: none !important;
        }
        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; gap: 1rem; }
            .form-actions { flex-direction: column-reverse; }
            .request-form { padding: 1.5rem; }
        }
    </style>
</head>
<body class="dark-theme">
    <header class="header">
        <div class="logo">VOD<span>PREMIUM</span></div>
        <div class="user-info">
            <a href="/revenda/dashboard" style="background: #333; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; margin-right: 15px;"><i class="fas fa-arrow-left"></i> Voltar ao Painel</a>
            <span>Olá, <strong><%= reseller.name %></strong></span>
            <a href="/revenda/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </header>

    <main class="container">
        <section class="request-section">
            <h2><i class="fas fa-plus-circle"></i> Novo Pedido</h2>

            <% const pendingCount = requests.filter(r => r.status === 'pending').length; %>
            <% if (pendingCount >= 10) { %>
                <div class="limit-warning">
                    <i class="fas fa-exclamation-triangle"></i> Você atingiu o limite de 10 pedidos pendentes. No momento, só é permitido reportar erros de reprodução.
                </div>
            <% } %>
            
            <div class="search-box">
                <input type="text" id="tmdbSearch" placeholder="Digite o nome do filme ou série...">
                <button id="btnSearch"><i class="fas fa-search"></i> Buscar</button>
            </div>

            <div id="tmdbResults" class="tmdb-results-grid">
                <!-- Resultados do TMDB aparecerão aqui -->
            </div>

            <form id="requestForm" class="request-form hidden">
                <input type="hidden" id="selectedId">
                <input type="hidden" id="selectedTitle">
                <input type="hidden" id="selectedType">
                <input type="hidden" id="selectedPoster">

                <div class="selected-preview">
                    <img id="previewPoster" src="" alt="">
                    <div class="preview-info">
                        <h3 id="previewTitle"></h3>
                        <span id="previewYear"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>O que deseja solicitar?</label>
                    <select id="requestAction" required>
                        <option value="content">Adicionar ao catálogo</option>
                        <option value="season">Solicitar nova temporada</option>
                        <option value="episode">Solicitar episódios faltando</option>
                        <option value="error">Reportar erro de reprodução</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Preferência de Áudio</label>
                    <div class="audio-preference-group">
                        <label class="radio-container">
                            <input type="radio" name="audioPreference" value="Dublado" checked>
                            <span class="radio-checkmark"></span>
                            Dublado
                        </label>
                        <label class="radio-container">
                            <input type="radio" name="audioPreference" value="Legendado">
                            <span class="radio-checkmark"></span>
                            Legendado
                        </label>
                    </div>
                </div>

                <div id="extraFields" class="form-row hidden">
                    <div class="form-group">
                        <label>Temporada <span id="labelSeasonReq" class="hidden" style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório)</span></label>
                        <input type="number" id="reqSeason" min="1" placeholder="Ex: 2" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                    <div class="form-group">
                        <label>Episódio(s) <span id="labelEpisodeReq" class="hidden" style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório)</span></label>
                        <input type="number" id="reqEpisode" min="1" placeholder="Ex: 10" oninput="this.value = this.value.replace(/[^0-9]/g, '')">
                    </div>
                </div>

                <div id="errorField" class="form-group hidden">
                    <label>Detalhes técnicos do erro <span style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório, mín. 10 caracteres)</span></label>
                    <textarea id="reqDescription" placeholder="Descreva o erro (ex: travamento aos 10:30, tela preta, sem áudio...)"></textarea>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="resetForm()">Cancelar</button>
                    <button type="submit" class="btn-submit" disabled>Enviar Solicitação</button>
                </div>
            </form>
        </section>

        <section class="my-requests">
            <h2><i class="fas fa-history"></i> Meus Pedidos Recentes</h2>
            <div class="requests-list">
                <% requests.slice(0, 5).forEach(req => { %>
                    <div class="mini-card">
                        <div class="status-indicator status-<%= req.status %>"></div>
                        <div class="mini-info">
                            <strong><%= req.title %></strong>
                            <span><%= req.date %> às <%= req.time %></span>
                        </div>
                        <span class="badge-status"><%= req.status.toUpperCase() %></span>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>

    <script>
        const pendingRequestsCount = <%= requests.filter(r => r.status === 'pending').length %>;

        document.getElementById('btnSearch').addEventListener('click', async () => {
            const query = document.getElementById('tmdbSearch').value;
            if (query.length < 3) return alert('Digite pelo menos 3 caracteres');

            const resultsDiv = document.getElementById('tmdbResults');
            resultsDiv.innerHTML = '<div class="loader">Buscando...</div>';

            try {
                // Agora usamos nossa própria API interna
                const res = await fetch(`/api/tmdb/search?query=${encodeURIComponent(query)}`);
                const data = await res.json();
                
                resultsDiv.innerHTML = '';
                data.results.filter(i => i.media_type !== 'person').slice(0, 20).forEach(item => {
                    const card = document.createElement('div');
                    card.className = 'tmdb-mini-card';
                    const title = item.title || item.name;
                    const date = item.release_date || item.first_air_date || '';
                    const fullDate = date ? date.split('-').reverse().join('/') : '';
                    const poster = item.poster_path ? `https://image.tmdb.org/t/p/w200${item.poster_path}` : 'https://via.placeholder.com/200x300?text=Sem+Poster';

                    card.innerHTML = `
                        <img src="${poster}" alt="${title}">
                        <div class="info">
                            <h4>${title}</h4>
                            <span>Lançamento: ${fullDate}</span>
                        </div>
                    `;
                    card.onclick = () => {
                        const today = new Date().toISOString().split('T')[0]; // Formato YYYY-MM-DD
                        const releaseDate = item.release_date || item.first_air_date;
                        
                        if (releaseDate && releaseDate > today) {
                            alert(`⚠️ Pedido Bloqueado: Este conteúdo tem lançamento previsto para ${fullDate}. Não é permitido solicitar filmes ou séries que ainda não foram lançados oficialmente.`);
                            window.location.href = '/revenda/dashboard';
                            return;
                        }
                        selectWork(item, poster, title, fullDate || 'N/A');
                    };
                    resultsDiv.appendChild(card);
                });
            } catch (e) {
                resultsDiv.innerHTML = 'Erro ao buscar dados.';
            }
        });

        function selectWork(item, poster, title, year) {
            document.getElementById('tmdbResults').classList.add('hidden');
            document.getElementById('requestForm').classList.remove('hidden');
            
            const actionSelect = document.getElementById('requestAction');
            const isSeries = item.media_type === 'tv';

            // Lógica de filtragem do Menu (Dropdown)
            Array.from(actionSelect.options).forEach(opt => {
                const isSerieOption = (opt.value === 'season' || opt.value === 'episode');
                
                if (pendingRequestsCount >= 10) {
                    // Regra 1: Limite de pendentes (Sempre prioridade)
                    opt.style.display = (opt.value === 'error') ? 'block' : 'none';
                    opt.disabled = (opt.value !== 'error');
                } else if (!isSeries) {
                    // Regra 2: Se for FILME, esconde opções de temporada/episódio
                    opt.style.display = isSerieOption ? 'none' : 'block';
                    opt.disabled = isSerieOption;
                } else {
                    // Regra 3: Se for SÉRIE, mostra tudo
                    opt.style.display = 'block';
                    opt.disabled = false;
                }
            });

            // Ajusta o valor selecionado caso a opção atual tenha ficado inválida
            if (pendingRequestsCount >= 10) {
                actionSelect.value = 'error';
            } else if (!isSeries && (actionSelect.value === 'season' || actionSelect.value === 'episode')) {
                actionSelect.value = 'content';
            }

            // Alerta de limite se necessário
            if (pendingRequestsCount >= 10) {
                alert('⚠️ Limite de Pedidos: Como você já possui 10 solicitações pendentes, agora você só pode reportar erros de reprodução.');
            }

            document.getElementById('selectedId').value = item.id;
            document.getElementById('selectedTitle').value = title;
            document.getElementById('selectedType').value = item.media_type;
            document.getElementById('selectedPoster').value = poster;

            document.getElementById('previewPoster').src = poster;
            document.getElementById('previewTitle').innerText = title;
            document.getElementById('previewYear').innerText = year;

            updateUIByAction();
        }

        document.getElementById('requestAction').addEventListener('change', (e) => {
            updateUIByAction();
        });

        function updateUIByAction() {
            const action = document.getElementById('requestAction').value;
            const type = document.getElementById('selectedType').value;
            const isSeries = (type === 'tv' || type === 'series');
            const isError = action === 'error';

            // Mostrar campos de erro
            document.getElementById('errorField').classList.toggle('hidden', !isError);
            
            const extraFields = document.getElementById('extraFields');
            const seasonGroup = document.getElementById('reqSeason').parentElement;
            const episodeGroup = document.getElementById('reqEpisode').parentElement;

            if (isSeries && !isError) {
                if (action === 'content') {
                    extraFields.classList.add('hidden');
                    document.getElementById('reqSeason').value = '';
                    document.getElementById('reqEpisode').value = '';
                } else if (action === 'season') {
                    extraFields.classList.remove('hidden');
                    seasonGroup.classList.remove('hidden');
                    episodeGroup.classList.add('hidden');
                    document.getElementById('reqEpisode').value = '';
                } else {
                    extraFields.classList.remove('hidden');
                    seasonGroup.classList.remove('hidden');
                    episodeGroup.classList.remove('hidden');
                }
            } else {
                extraFields.classList.add('hidden');
                document.getElementById('reqSeason').value = '';
                document.getElementById('reqEpisode').value = '';
            }

            if (!isError) {
                document.getElementById('reqDescription').value = '';
            }

            // Controle das labels de obrigatoriedade
            document.getElementById('labelSeasonReq').classList.toggle('hidden', action !== 'season');
            document.getElementById('labelEpisodeReq').classList.toggle('hidden', action !== 'episode');

            validateForm();
        }

        function validateForm() {
            const action = document.getElementById('requestAction').value;
            const btnSubmit = document.querySelector('.btn-submit');
            let isValid = true;

            if (action === 'error') {
                const desc = document.getElementById('reqDescription').value.trim();
                if (desc.length < 10) isValid = false;
            } else if (action === 'season') {
                const season = document.getElementById('reqSeason').value.trim();
                if (season.length === 0) isValid = false;
            } else if (action === 'episode') {
                const episode = document.getElementById('reqEpisode').value.trim();
                if (episode.length === 0) isValid = false;
            }

            btnSubmit.disabled = !isValid;
        }

        document.getElementById('reqDescription').addEventListener('input', validateForm);
        document.getElementById('reqSeason').addEventListener('input', validateForm);
        document.getElementById('reqEpisode').addEventListener('input', validateForm);

        function resetForm() {
            document.getElementById('requestForm').classList.add('hidden');
            document.getElementById('tmdbResults').classList.remove('hidden');
            document.getElementById('tmdbSearch').value = '';
        }

        document.getElementById('requestForm').onsubmit = async (e) => {
            e.preventDefault();
            
            const payload = {
                tmdbId: document.getElementById('selectedId').value,
                title: document.getElementById('selectedTitle').value,
                type: document.getElementById('selectedType').value === 'tv' ? 'series' : 'movie',
                requestType: document.getElementById('requestAction').value,
                season: document.getElementById('reqSeason').value,
                episode: document.getElementById('reqEpisode').value,
                description: document.getElementById('reqDescription').value,
                date: new Date().toLocaleDateString('pt-BR'),
                time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' }),
                audioPreference: document.querySelector('input[name="audioPreference"]:checked').value
            };

            try {
                const res = await fetch('/api/requests', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    alert('Pedido enviado com sucesso!');
                    window.location.href = '/revenda/dashboard';
                } else {
                    const data = await res.json();
                    alert(data.error || 'Erro ao enviar pedido.');
                    
                    // Se for erro de duplicidade (409), redireciona para a dashboard
                    if (res.status === 409) {
                        window.location.href = '/revenda/dashboard';
                    }
                }
            } catch (err) {
                alert('Erro ao enviar pedido.');
            }
        };
    </script>
</body>
</html>