<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Revendedor - VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/js/theme.js?v=<%= Date.now() %>"></script>
    <link rel="stylesheet" href="/css/reseller.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .request-form {
            background: #141414;
            padding: 2.5rem;
            border-radius: 1.2rem;
            border: 1px solid #2b2b2b;
            margin-top: 2rem;
            box-shadow: 0 15px 35px rgba(0,0,0,0.6);
        }
        .request-form label {
            display: block;
            font-size: 1rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
            color: #b3b3b3;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .request-form select, 
        .request-form input, 
        .request-form textarea {
            width: 100%;
            background: #050505;
            border: 2px solid #333;
            color: #fff;
            padding: 14px 18px;
            border-radius: 10px;
            font-size: 1.2rem; /* Fonte aumentada conforme solicitado */
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-family: 'Inter', sans-serif;
        }
        .request-form select:focus, 
        .request-form input:focus, 
        .request-form textarea:focus {
            border-color: #e50914;
            box-shadow: 0 0 0 4px rgba(229, 9, 20, 0.15);
            outline: none;
            background: #000;
        }
        #requestAction {
            width: fit-content;
            min-width: 280px;
            padding: 8px 14px;
            font-size: 1.0rem;
            border-width: 1px;
        }
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 2rem;
            margin-top: 1rem;
        }
        .form-group {
            margin-bottom: 2rem;
        }
        .form-actions {
            display: flex;
            gap: 1.5rem;
            margin-top: 3rem;
        }
        .btn-submit {
            flex: 2;
            background: linear-gradient(135deg, #e50914 0%, #991b1b 100%);
            color: white;
            border: none;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 900;
            font-size: 1.1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
        }
        .btn-submit:hover {
            transform: translateY(-2px) scale(1.01);
            filter: brightness(1.2);
            box-shadow: 0 8px 25px rgba(229, 9, 20, 0.5);
        }
        .btn-submit:disabled {
            background: #444;
            color: #888;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
            filter: none;
        }
        .btn-cancel {
            flex: 1;
            background: #262626;
            color: #a0a0a0;
            border: 1px solid #333;
            padding: 1.2rem;
            border-radius: 10px;
            font-weight: 700;
            font-size: 1rem;
            text-transform: uppercase;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .btn-cancel:hover {
            background: #333;
            color: #fff;
            border-color: #444;
        }
        .audio-preference-group {
            display: flex;
            gap: 1.2rem;
            background: #050505;
            padding: 5px 12px;
            border-radius: 10px;
            border: 1px solid #222;
            width: fit-content;
        }
        .radio-container {
            display: flex;
            align-items: center;
            cursor: pointer;
            color: #fff;
            font-weight: 600;
            gap: 6px;
            user-select: none;
            font-size: 0.8rem;
        }
        .radio-container input {
            display: none;
        }
        .radio-checkmark {
            height: 13px;
            width: 13px;
            background-color: #222;
            border-radius: 50%;
            border: 1px solid #444;
            display: inline-block;
            position: relative;
        }
        .radio-container input:checked ~ .radio-checkmark {
            background-color: #e50914;
            border-color: #e50914;
        }
        .radio-checkmark:after {
            content: "";
            position: absolute;
            display: none;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 4px;
            height: 4px;
            border-radius: 50%;
            background: white;
        }
        .radio-container input:checked ~ .radio-checkmark:after {
            display: block;
        }
        .limit-warning {
            background: rgba(229, 9, 20, 0.2);
            border: 1px solid var(--accent-red);
            color: #ffbaba;
            padding: 1rem;
            border-radius: 10px;
            margin-bottom: 2rem;
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
        }
        .hidden {
            display: none !important;
        }
        @media (max-width: 600px) {
            .form-row { grid-template-columns: 1fr; gap: 1rem; }
            .form-actions { flex-direction: column-reverse; }
            .request-form { padding: 1.5rem; }
        }
    </style>
</head>
<body class="dark-theme">
    <header class="header">
        <div class="logo">VOD<span>PREMIUM</span></div>
        <div class="user-info" style="display: flex; align-items: center; gap: 15px;">
            <a href="/revenda/dashboard" style="background: #333; color: white; border: none; padding: 0.6rem 1.2rem; border-radius: 0.5rem; font-weight: 700; font-size: 0.85rem; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem;"><i class="fas fa-arrow-left"></i> Voltar ao Painel</a>
            <span>Olá, <strong><%= reseller.name %></strong></span>
            <button id="themeToggleBtn" style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s;" onclick="toggleTheme()" title="Alternar Tema">
                <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
            </button>
            <a href="/revenda/logout" class="btn-logout" style="margin-left: 5px;"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </header>

    <main class="container">
        <section class="request-section">
            <h2><i class="fas fa-plus-circle"></i> Novo Pedido</h2>

            <% const pendingCount = requests.filter(r => r.status === 'pending').length; %>
            <% if (pendingCount >= 10) { %>
                <div class="limit-warning">
                    <i class="fas fa-exclamation-triangle"></i> Você atingiu o limite de 10 pedidos pendentes. No momento, só é permitido reportar erros de reprodução.
                </div>
            <% } %>
            
            <div class="search-box">
                <input type="text" id="tmdbSearch" placeholder="Digite o nome do filme ou série...">
                <button id="btnSearch"><i class="fas fa-search"></i> Buscar</button>
            </div>

            <div id="tmdbResults" class="tmdb-results-grid">
                <!-- Resultados do TMDB aparecerão aqui -->
            </div>

            <form id="requestForm" class="request-form hidden">
                <input type="hidden" id="selectedId">
                <input type="hidden" id="selectedTitle">
                <input type="hidden" id="selectedType">
                <input type="hidden" id="selectedPoster">

                <div class="selected-preview">
                    <img id="previewPoster" src="" alt="">
                    <div class="preview-info">
                        <h3 id="previewTitle"></h3>
                        <span id="previewYear"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label>O que deseja solicitar?</label>
                    <select id="requestAction" required>
                        <option value="content">Adicionar ao catálogo</option>
                        <option value="season">Solicitar nova temporada</option>
                        <option value="episode">Solicitar episódios faltando</option>
                        <option value="error">Reportar erro de reprodução</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Preferência de Áudio</label>
                    <div class="audio-preference-group">
                        <label class="radio-container">
                            <input type="radio" name="audioPreference" value="Dublado" checked>
                            <span class="radio-checkmark"></span>
                            Dublado
                        </label>
                        <label class="radio-container">
                            <input type="radio" name="audioPreference" value="Legendado">
                            <span class="radio-checkmark"></span>
                            Legendado
                        </label>
                    </div>
                </div>

                <div id="extraFields" class="form-row hidden">
                    <div class="form-group">
                        <label>Temporada <span id="labelSeasonReq" class="hidden" style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório)</span></label>
                        <div style="display: flex; gap: 8px;">
                            <select id="reqSeasonDigit1" style="flex: 1; text-align: center; font-size: 1.2rem; background: #050505; border: 2px solid #333; color: #fff; padding: 14px 18px; border-radius: 10px;">
                                <option value=""></option>
                                <% for (let i = 0; i <= 9; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                            <select id="reqSeasonDigit2" style="flex: 1; text-align: center; font-size: 1.2rem; background: #050505; border: 2px solid #333; color: #fff; padding: 14px 18px; border-radius: 10px;">
                                <option value=""></option>
                                <% for (let i = 0; i <= 9; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Episódio <span id="labelEpisodeReq" class="hidden" style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório)</span></label>
                        <div style="display: flex; gap: 8px;">
                            <select id="reqEpisodeDigit1" style="flex: 1; text-align: center; font-size: 1.2rem; background: #050505; border: 2px solid #333; color: #fff; padding: 14px 18px; border-radius: 10px;">
                                <option value=""></option>
                                <% for (let i = 0; i <= 9; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                            <select id="reqEpisodeDigit2" style="flex: 1; text-align: center; font-size: 1.2rem; background: #050505; border: 2px solid #333; color: #fff; padding: 14px 18px; border-radius: 10px;">
                                <option value=""></option>
                                <% for (let i = 0; i <= 9; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                            <select id="reqEpisodeDigit3" style="flex: 1; text-align: center; font-size: 1.2rem; background: #050505; border: 2px solid #333; color: #fff; padding: 14px 18px; border-radius: 10px;">
                                <option value=""></option>
                                <% for (let i = 0; i <= 9; i++) { %>
                                    <option value="<%= i %>"><%= i %></option>
                                <% } %>
                            </select>
                        </div>
                    </div>
                </div>

                <div id="errorField" class="form-group hidden">
                    <label>Detalhes técnicos do erro <span style="color: var(--accent-red); font-size: 0.8rem; text-transform: lowercase;">(obrigatório, mín. 10 caracteres)</span></label>
                    <textarea id="reqDescription" placeholder="Descreva o erro (ex: travamento aos 10:30, tela preta, sem áudio...)"></textarea>
                </div>

                <div class="form-actions">
                    <button type="button" class="btn-cancel" onclick="resetForm()">Cancelar</button>
                    <button type="submit" class="btn-submit" disabled>Enviar Solicitação</button>
                </div>
            </form>
        </section>

        <section class="my-requests">
            <h2><i class="fas fa-history"></i> Meus Pedidos Recentes</h2>
            <div class="requests-list">
                <% requests.slice(0, 5).forEach(req => { %>
                    <div class="mini-card">
                        <div class="status-indicator status-<%= req.status %>"></div>
                        <div class="mini-info">
                            <strong><%= req.title %></strong>
                            <span><%= req.date %> às <%= req.time %></span>
                        </div>
                        <span class="badge-status"><%= req.status.toUpperCase() %></span>
                    </div>
                <% }) %>
            </div>
        </section>
    </main>

    <script src="/js/revenda-solicitar.js?v=<%= Date.now() %>"></script>
</body>
</html>