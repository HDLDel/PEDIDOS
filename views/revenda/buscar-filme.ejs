<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Solicitar Filme - Portal VOD</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
  <style>
    .busca-container {
      min-height: 100vh;
      background: var(--bg-main);
    }
    .busca-header {
      background: #050505;
      padding: 1rem 2rem;
      border-bottom: 1px solid #1a1a1a;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .busca-header .logo { font-size: 1.2rem; font-weight: 900; }
    .busca-header .logo span { color: var(--accent-red); }
    .busca-header a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: 0.85rem;
    }
    
    .busca-content {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    
    .busca-box {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      padding: 2rem;
      margin-bottom: 2rem;
    }
    .busca-box h2 {
      font-size: 1.25rem;
      font-weight: 700;
      margin-bottom: 1rem;
    }
    .busca-input-group {
      display: flex;
      gap: 0.75rem;
    }
    .busca-input {
      flex: 1;
      padding: 0.9rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: 0.75rem;
      background: #111;
      color: var(--text);
      font-size: 1rem;
    }
    .busca-input:focus {
      outline: none;
      border-color: var(--accent-red);
    }
    .busca-btn {
      padding: 0.9rem 1.75rem;
      border: none;
      border-radius: 0.75rem;
      background: var(--accent-red);
      color: white;
      font-weight: 700;
      font-size: 0.95rem;
      cursor: pointer;
    }
    
    .results-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 1.25rem;
    }
    .result-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 1rem;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.2s;
      text-decoration: none;
      color: var(--text);
    }
    .result-card:hover {
      border-color: var(--accent-red);
      transform: translateY(-3px);
      box-shadow: 0 8px 25px rgba(220, 38, 38, 0.12);
    }
    .result-card .poster {
      width: 100%;
      aspect-ratio: 2/3;
      object-fit: cover;
    }
    .result-card .info {
      padding: 1rem;
    }
    .result-card .title {
      font-weight: 700;
      font-size: 0.9rem;
      margin-bottom: 0.3rem;
    }
    .result-card .year {
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    
    .loading {
      text-align: center;
      padding: 3rem;
      color: var(--text-muted);
    }
    .empty {
      text-align: center;
      padding: 3rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="busca-container">
    <header class="busca-header">
      <div class="logo">PORTAL <span>VOD</span></div>
      <a href="/revenda/solicitar">← Voltar</a>
    </header>

    <main class="busca-content">
      <div class="busca-box">
        <h2>🎬 Buscar Filme</h2>
        <p style="color: var(--text-muted); margin-bottom: 1rem; font-size: 0.9rem;">
          Digite o nome do filme que deseja solicitar. Você verá resultados do TMDB para escolher o correto.
        </p>
        <form class="busca-input-group" onsubmit="buscarFilme(event)">
          <input type="text" id="searchInput" class="busca-input" placeholder="Ex: Duna, Oppenheimer, The Batman..." required>
          <button type="submit" class="busca-btn">🔍 Buscar</button>
        </form>
      </div>

      <div id="resultsContainer">
        <!-- Resultados aparecem aqui -->
      </div>
    </main>
  </div>

  <script>
    const API_KEY = '<TMDB_API_KEY>';
    
    async function buscarFilme(e) {
      e.preventDefault();
      const query = document.getElementById('searchInput').value.trim();
      const container = document.getElementById('resultsContainer');
      
      if (!query) return;
      
      container.innerHTML = '<div class="loading">🔍 Buscando no TMDB...</div>';
      
      try {
        const response = await fetch(`https://api.themoviedb.org/3/search/movie?api_key=${API_KEY}&query=${encodeURIComponent(query)}&language=pt-BR&page=1`);
        const data = await response.json();
        
        if (!data.results || data.results.length === 0) {
          container.innerHTML = '<div class="empty">😕 Nenhum filme encontrado. Tente outro título.</div>';
          return;
        }
        
        const html = data.results.slice(0, 8).map(movie => {
          const poster = movie.poster_path 
            ? `https://image.tmdb.org/t/p/w500${movie.poster_path}`
            : 'https://via.placeholder.com/500x750/1a1a1a/666?text=Sem+Poster';
          const year = movie.release_date ? movie.release_date.split('-')[0] : 'N/A';
          
          return `
            <div class="result-card" onclick="selecionarFilme(${movie.id}, '${escapeHtml(movie.title)}', '${year}', '${poster}')">
              <img src="${poster}" alt="${escapeHtml(movie.title)}" class="poster">
              <div class="info">
                <div class="title">${escapeHtml(movie.title)}</div>
                <div class="year">📅 ${year} | ⭐ ${movie.vote_average ? movie.vote_average.toFixed(1) : 'N/A'}</div>
              </div>
            </div>
          `;
        }).join('');
        
        container.innerHTML = `<div class="results-grid">${html}</div>`;
        
      } catch (err) {
        container.innerHTML = '<div class="empty">❌ Erro ao buscar. Tente novamente.</div>';
        console.error(err);
      }
    }
    
    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML.replace(/'/g, "&apos;").replace(/"/g, """);
    }
    
    async function selecionarFilme(tmdbId, title, year, poster) {
      if (!confirm(`Deseja solicitar o filme "${title}" (${year})?`)) return;
      
      try {
        const response = await fetch('/revenda/api/solicitar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            type: 'movie',
            title: title,
            year: year,
            poster: poster,
            tmdbId: tmdbId,
            action: 'Adicionar ao catálogo',
            requestType: 'content'
          })
        });
        
        if (response.ok) {
          alert('✅ Solicitação enviada com sucesso! Você pode acompanhar o status no seu painel.');
          window.location.href = '/revenda/dashboard';
        } else {
          alert('❌ Erro ao enviar solicitação.');
        }
      } catch (err) {
        alert('❌ Erro de conexão.');
        console.error(err);
      }
    }
  </script>
</body>
</html>
