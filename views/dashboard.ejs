                <button class="btn"
                    style="background: #333; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer; transition: background 0.2s;"
                    onclick="closeSettingsModal()">FECHAR</button>
