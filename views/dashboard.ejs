                    <span id="palantirProgressEta">--</span>
                </div>
                <div id="palantirProgressQueue" style="max-height: 180px; overflow-y: auto; border-top: 1px solid var(--border); padding-top: 10px;">
                    <div style="font-size: 11px; color: var(--text-muted); font-weight: 600; margin-bottom: 6px;">Fila de Downloads</div>
