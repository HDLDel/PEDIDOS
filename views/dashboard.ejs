<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel VOD Premium</title>
    <link rel="icon" type="image/png" href="/favicon.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script>
        (function () {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light') {
                    document.documentElement.classList.add('light-theme');
                    document.addEventListener('DOMContentLoaded', () => {
                        document.body.classList.add('light-theme');
                    });
                }
            } catch (e) {
                console.error('Falha ao acessar o localStorage:', e);
            }
        })();
    </script>
    <style>
        :root {
            --bg-main: #0b0b0f;
            --bg-card: #161a20;
            --bg-nav: #0b0b0f;
            --accent-red: #ef4444;
            --text-primary: #f2f4f8;
            --text-muted: #a6adb8;
            --border: #2a2f3a;
            --status-pending: #f59e0b;
            --status-approved: #22c55e;
            --status-rejected: #ef4444;
            --btn-blue: #2f80ed;
            --btn-justwatch: #fbc02d;
            --shadow-card: 0 8px 24px rgba(255, 255, 255, 0.05);
            --shadow-hover: 0 12px 30px rgba(255, 255, 255, 0.1), 0 0 15px rgba(47, 128, 237, 0.25);
        }

        .light-theme {
            --shadow-card: 0 8px 24px rgba(0, 0, 0, 0.08) !important;
            --shadow-hover: 0 12px 30px rgba(0, 0, 0, 0.12), 0 0 15px rgba(47, 128, 237, 0.15) !important;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            padding-top: 80px;
            line-height: 1.5;
        }

        .header-fixed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: rgba(11, 11, 15, 0.95);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
            z-index: 2000;
        }

        .whatsapp-status-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 50px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--bg-card);
            transition: all 0.2s ease;
        }

        .wa-on {
            color: var(--status-approved);
            border-color: var(--status-approved);
        }

        .wa-off {
            color: var(--status-rejected);
            border-color: var(--status-rejected);
        }

        .wa-qr {
            color: var(--status-pending);
            border-color: var(--status-pending);
        }

        .wa-m3u {
            color: var(--btn-blue);
            border-color: var(--btn-blue);
        }

        .wa-m3u:hover {
            background: rgba(47, 128, 237, 0.1);
        }

        /* Settings Modal Custom Glassmorphism Styles */
        .settings-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
            margin-top: 15px;
            margin-bottom: 15px;
        }

        .settings-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .settings-card:hover {
            background: rgba(255, 255, 255, 0.07);
            border-color: rgba(255, 255, 255, 0.15);
            transform: translateY(-4px);
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        }

        .settings-card i {
            font-size: 2.2rem;
            color: var(--accent-red);
            transition: transform 0.5s ease;
        }

        .settings-card:hover i {
            transform: scale(1.1) rotate(15deg);
        }
        
        .settings-card.reseller-card i {
            color: #3b82f6;
        }
        
        .settings-card.reseller-card:hover i {
            transform: scale(1.1) translateY(-2px);
        }

        .settings-card h4 {
            margin: 0;
            font-size: 1rem;
            font-weight: 700;
            color: #fff;
        }

        .settings-card p {
            margin: 0;
            font-size: 0.8rem;
            color: var(--text-muted);
            line-height: 1.3;
        }

        .settings-section-container {
            max-height: 0;
            overflow: hidden;
            transition: max-height 0.4s ease-out, opacity 0.3s ease-out;
            opacity: 0;
        }

        .settings-section-container.open {
            max-height: 400px;
            opacity: 1;
            margin-top: 15px;
            border-top: 1px solid var(--border);
            padding-top: 15px;
        }

        /* Glassmorphism generic overlays */
        .glass-modal {
            backdrop-filter: blur(14px) !important;
            background: rgba(5, 5, 8, 0.7) !important;
        }

        .logo h2 {
            font-weight: 900;
            letter-spacing: -1px;
            font-size: 1.3rem;
        }

        .stats-summary {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px;
            padding: 0;
            background: transparent;
            margin-bottom: 12px;
        }

        .stat-pill {
            background: rgba(255, 255, 255, 0.02);
            padding: 6px 14px;
            border-radius: 50px;
            border: 1px solid var(--border);
            font-size: 0.8rem;
            font-weight: 600;
            cursor: pointer;
            color: var(--text-muted);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .stat-pill:hover {
            border-color: var(--text-primary);
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.05);
        }

        #stat-pending.active {
            border-color: var(--status-pending);
            background: rgba(245, 158, 11, 0.1);
            color: #ffb74d;
        }

        #stat-approved.active {
            border-color: var(--status-approved);
            background: rgba(34, 197, 94, 0.1);
            color: #81c784;
        }

        #stat-rejected.active {
            border-color: var(--status-rejected);
            background: rgba(239, 68, 68, 0.1);
            color: #e57373;
        }

        #stat-all.active {
            border-color: var(--text-muted);
            background: rgba(255, 255, 255, 0.1);
            color: var(--text-primary);
        }

        .stat-pill strong {
            color: inherit;
            font-weight: 700;
            margin-left: 2px;
        }

        .requests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 12px;
            padding: 15px 2rem;
            max-width: 100%;
            margin: 0 auto;
        }

        .request-card {
            background: var(--bg-card);
            border-radius: 16px;
            overflow: hidden;
            border: 1px solid var(--border);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            padding: 6px;
            box-shadow: var(--shadow-card);
        }

        .request-card:hover {
            transform: translateY(-4px);
            border-color: var(--btn-blue);
            box-shadow: var(--shadow-hover);
        }

        .poster-container {
            position: relative;
            width: 100%;
            aspect-ratio: 2/3;
            height: auto;
            background: #0d0f13;
            border-radius: 12px;
            overflow: hidden;
        }

        .poster-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-status {
            position: absolute;
            top: 8px;
            right: 8px;
            padding: 4px 8px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            background: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(4px);
            border: 1px solid;
            z-index: 10;
        }

        .status-pending {
            border-color: var(--status-pending);
            color: var(--status-pending);
        }

        .status-approved {
            border-color: var(--status-approved);
            color: var(--status-approved);
        }

        .status-rejected {
            border-color: var(--status-rejected);
            color: var(--status-rejected);
        }

        .card-body {
            padding: 8px 6px;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .card-title {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--text-primary);
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: normal;
            min-height: 2.8em;
            line-height: 1.35;
        }

        .info-item {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 2px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .info-item i {
            width: 14px;
            text-align: center;
            color: var(--btn-blue);
        }

        .card-actions {
            padding: 8px 0 0 0;
            border-top: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 6px;
            margin-top: auto;
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px;
        }

        .btn {
            padding: 6px 12px;
            border-radius: 8px;
            border: 1px solid var(--border);
            font-weight: 600;
            cursor: pointer;
            font-size: 0.72rem;
            transition: all 0.2s;
            text-transform: none;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            height: 30px;
            background: rgba(255, 255, 255, 0.03);
            color: var(--text-primary);
        }

        .btn-tmdb {
            border: 1px solid rgba(47, 128, 237, 0.25);
            background: rgba(47, 128, 237, 0.05);
            color: #82b1ff;
            width: 100%;
        }

        .btn-tmdb:hover {
            background: rgba(47, 128, 237, 0.15);
            color: #fff;
        }

        .btn-justwatch {
            border: 1px solid rgba(251, 192, 45, 0.25);
            background: rgba(251, 192, 45, 0.05);
            color: #ffd54f;
            width: 100%;
        }

        .btn-justwatch:hover {
            background: rgba(251, 192, 45, 0.15);
            color: #fff;
        }

        .btn-palantir {
            border: 1px solid rgba(139, 92, 246, 0.25);
            background: rgba(139, 92, 246, 0.05);
            color: #d1c4e9;
        }

        .btn-palantir:hover {
            background: rgba(139, 92, 246, 0.15);
            color: #fff;
        }

        .btn-approve {
            background: rgba(34, 197, 94, 0.08);
            border: 1px solid rgba(34, 197, 94, 0.3);
            color: #4ade80;
        }

        .btn-approve:hover {
            background: #22c55e;
            color: white;
            border-color: #22c55e;
        }

        .btn-reject {
            background: rgba(239, 68, 68, 0.08);
            border: 1px solid rgba(239, 68, 68, 0.3);
            color: #f87171;
        }

        .btn-reject:hover {
            background: #ef4444;
            color: white;
            border-color: #ef4444;
        }

        .dashboard-control-panel {
            background: var(--bg-card);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 16px;
            max-width: calc(100% - 6rem);
            margin: 20px auto;
            display: flex;
            flex-direction: column;
            gap: 12px;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .tabs {
            display: flex;
            gap: 4px;
            padding: 4px;
            background: rgba(0, 0, 0, 0.2);
            border-radius: 12px;
            justify-content: center;
            width: fit-content;
            margin: 0 auto 12px auto;
            border: 1px solid var(--border);
        }

        .tab {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 600;
            font-size: 0.8rem;
            padding: 6px 16px;
            border-radius: 8px;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .tab:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.02);
        }

        .tab.active {
            color: #fff;
            background: var(--btn-blue);
            box-shadow: 0 2px 8px rgba(47, 128, 237, 0.4);
        }

        .request-card.hidden {
            display: none;
        }

        /* Toolbar (Search & Sort) */
        .toolbar {
            display: flex;
            gap: 8px;
            padding: 0;
            width: 100%;
            margin: 0;
        }

        .toolbar input,
        .toolbar select {
            padding: 8px 12px;
            border-radius: 10px;
            border: 1px solid var(--border);
            background: #1a1a2e;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.85rem;
            outline: none;
            transition: all 0.2s;
            height: 38px;
            box-sizing: border-box;
        }

        .toolbar select option {
            background: #1a1a2e;
            color: #f2f4f8;
        }

        .toolbar input {
            flex: 2;
        }

        .toolbar input:focus,
        .toolbar select:focus {
            border-color: var(--btn-blue);
            box-shadow: 0 0 0 2px rgba(47, 128, 237, 0.15);
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 3000;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(4px);
        }

        .modal-content {
            background: var(--bg-card);
            padding: 0.6rem 1.2rem;
            border-radius: 16px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
            border: 1px solid var(--border);
            box-shadow: var(--shadow-hover);
            font-size: 1rem;
        }

        .modal-content p, 
        .modal-content td, 
        .modal-content th, 
        .modal-content label,
        .modal-content select,
        .modal-content option {
            font-size: 1rem;
        }

        .modal-content .btn, 
        .modal-content button {
            font-size: 0.85rem;
            padding: 8px 16px;
            font-weight: 700;
        }

        .modal-content textarea {
            font-size: 0.95rem;
        }

        .modal-header {
            margin-bottom: 0.4rem;
            font-weight: 900;
            color: var(--accent-red);
            font-size: 1.35rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            padding-bottom: 4px;
            display: flex !important;
            align-items: center !important;
            justify-content: flex-start !important;
            gap: 10px !important;
        }

        .modal-footer {
            display: flex !important;
            justify-content: flex-end !important;
            gap: 10px !important;
            margin-top: 0.6rem !important;
            padding: 0.4rem 0 0 0 !important;
            border-top: 1px solid rgba(255, 255, 255, 0.05) !important;
        }

        /* Classes de conversa de chat (Modais) */
        .chat-bubble {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 0.95rem;
            word-break: break-word;
            line-height: 1.4;
            display: flex;
            flex-direction: column;
            gap: 2px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            margin-bottom: 0;
        }
        .chat-bubble.reseller {
            background: rgba(37, 99, 235, 0.15);
            border-left: 2px solid #2563eb;
            color: #e2e8f0;
            align-self: flex-end;
            width: 90%;
        }
        .chat-bubble.rejection {
            background: rgba(239, 68, 68, 0.15);
            border-left: 2px solid #ef4444;
            color: #e2e8f0;
            align-self: flex-start;
            width: 90%;
        }
        .chat-bubble.observation {
            background: rgba(255, 255, 255, 0.05);
            border-left: 2px solid #555;
            color: #ccc;
            align-self: flex-start;
            width: 90%;
        }
        .chat-bubble-header {
            font-weight: bold;
            font-size: 0.85rem;
            color: #fff;
            opacity: 0.95;
            margin-bottom: 2px;
        }
        .chat-bubble-content {
            white-space: pre-wrap;
        }

        /* Otimizações para telas grandes (resoluções 2K/4K ou telas maiores que 1400px de largura) */
        @media (min-width: 1400px) {
            .modal-content {
                padding: 1.2rem 2rem;
                font-size: 1.35rem;
            }

            .modal-content p, 
            .modal-content td, 
            .modal-content th, 
            .modal-content label,
            .modal-content select,
            .modal-content option {
                font-size: 1.35rem !important;
            }

            .modal-content .btn, 
            .modal-content button {
                font-size: 1.15rem !important;
                padding: 14px 24px !important;
            }

            .modal-content textarea {
                font-size: 1.4rem !important;
            }

            .modal-header {
                font-size: 2.2rem;
                margin-bottom: 1rem;
                padding-bottom: 8px;
            }

            .chat-bubble {
                padding: 18px 24px;
                font-size: 1.35rem;
                gap: 8px;
            }
            .chat-bubble-header {
                font-size: 1.1rem;
                margin-bottom: 4px;
            }
        }

        /* Otimizações para Celular e Telas Pequenas */
        @media (max-width: 1024px) {
            body {
                padding-top: 65px;
            }
            .header-fixed {
                height: 55px;
                padding: 0 0.8rem;
            }
            .logo h2 {
                font-size: 1.05rem;
            }
            .whatsapp-status-btn span,
            .user-info a span {
                display: none !important;
            }
            .whatsapp-status-btn {
                padding: 6px !important;
                font-size: 0.9rem !important;
                border-radius: 50% !important;
                width: 32px;
                height: 32px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }
            .user-info {
                gap: 6px !important;
            }
            .user-info a[href="/admin/logout"] {
                font-size: 1.05rem !important;
                margin-left: 2px;
            }

            .dashboard-control-panel {
                max-width: calc(100% - 1.5rem) !important;
                margin: 10px auto !important;
                padding: 10px !important;
                border-radius: 12px;
                gap: 8px;
            }
            .tabs {
                gap: 8px 12px;
                flex-wrap: wrap !important;
                padding: 5px 0 !important;
                justify-content: center;
            }
            .tab {
                font-size: 0.78rem !important;
                padding-bottom: 4px;
            }
            .stats-summary {
                gap: 6px !important;
                padding: 8px 2px !important;
                flex-wrap: wrap !important;
            }
            .stat-pill {
                flex: 1 1 calc(50% - 8px);
                text-align: center;
                font-size: 0.78rem !important;
                padding: 6px 8px !important;
            }
            .toolbar {
                flex-direction: column !important;
                gap: 8px !important;
                padding: 0 !important;
            }
            .toolbar input, .toolbar select {
                width: 100% !important;
                font-size: 0.85rem !important;
                padding: 8px 12px !important;
            }

            .requests-grid {
                grid-template-columns: 1fr !important;
                padding: 10px 12px !important;
            }

            /* Modal mobile styles */
            .modal-overlay {
                padding: 10px !important;
            }
            .modal-content {
                padding: 0.5rem 1rem !important;
                width: 100% !important;
                max-height: 95vh !important;
                border-radius: 12px !important;
            }
            .modal-header {
                font-size: 1.2rem !important;
                margin-bottom: 0.4rem !important;
                padding-bottom: 4px !important;
            }
            .modal-content p, 
            .modal-content td, 
            .modal-content th, 
            .modal-content label,
            .modal-content select,
            .modal-content option {
                font-size: 0.85rem !important;
            }
            .modal-content .btn, 
            .modal-content button {
                font-size: 0.8rem !important;
                padding: 8px 12px !important;
                height: auto !important;
            }
            .modal-content textarea {
                font-size: 0.9rem !important;
                min-height: 120px !important;
            }
            .chat-bubble {
                padding: 10px 12px !important;
                font-size: 0.85rem !important;
                width: 95% !important;
            }
            .chat-bubble-header {
                font-size: 0.75rem !important;
            }
            .quick-buttons {
                gap: 6px !important;
                margin-bottom: 1rem !important;
            }
            .btn-quick {
                padding: 6px 10px !important;
                font-size: 0.7rem !important;
            }

            /* Responsive details table inside detailsModal */
            #detailsModal table, 
            #detailsModal thead, 
            #detailsModal tbody, 
            #detailsModal th, 
            #detailsModal td, 
            #detailsModal tr {
                display: block !important;
            }
            #detailsModal thead {
                display: none !important;
            }
            #detailsModal tr {
                border-bottom: 1px solid var(--border) !important;
                padding: 10px 12px !important;
                display: flex !important;
                flex-direction: column !important;
                gap: 6px !important;
            }
            #detailsModal td {
                padding: 4px 0 !important;
                border: none !important;
                display: flex !important;
                justify-content: space-between !important;
                align-items: center !important;
                width: 100% !important;
                text-align: right !important;
            }
            #detailsModal td::before {
                content: attr(data-label);
                font-weight: bold;
                color: var(--text-muted);
                font-size: 0.8rem;
                float: left;
                text-align: left;
            }
            #detailsModal td[data-label="Ações"] {
                justify-content: center !important;
                margin-top: 6px;
            }
        }

        .quick-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 1.5rem;
        }

        .btn-quick {
            background: var(--bg-data);
            color: var(--text-secondary);
            padding: 8px 12px;
            border-radius: 6px;
            font-size: 0.75rem;
            border: 1px solid var(--border);
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
        }

        .btn-quick:hover {
            background: var(--btn-blue);
            color: white;
            border-color: var(--btn-blue);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 1.5rem;
        }

        textarea {
            width: 100%;
            background: var(--bg-input);
            border: 1px solid var(--border);
            color: var(--text-primary);
            padding: 15px;
            border-radius: 8px;
            resize: vertical;
            min-height: 250px;
            font-family: inherit;
            font-size: 0.95rem;
            line-height: 1.6;
        }

        textarea:focus {
            border-color: var(--btn-blue);
            outline: none;
        }

        /* Botão Voltar ao Topo */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 45px;
            height: 45px;
            background-color: var(--btn-blue);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 16px;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 15px rgba(47, 128, 237, 0.4);
            z-index: 2500;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            transform: translateY(-5px);
            background-color: var(--btn-blue-hover);
        }

        @media (max-width: 600px) {
            .requests-grid {
                grid-template-columns: 1fr;
                padding: 10px 1rem;
            }

            .header-fixed {
                padding: 0 1rem;
            }
        }
    </style>
</head>

<body>
    <header class="header-fixed">
        <div class="logo">
            <h2 style="color: var(--accent-red);">IMPERIO <span style="color: white;">APPS</span></h2>
        </div>
        <div class="user-info" style="display: flex; align-items: center; gap: 20px;">
            <a href="/admin/whatsapp" id="waStatusBtn" class="whatsapp-status-btn wa-off"
                style="text-decoration: none;">
                <i class="fab fa-whatsapp"></i> <span>OFFLINE</span>
            </a>
            <a href="/admin/botbot" id="bbStatusBtn" class="whatsapp-status-btn wa-off" style="text-decoration: none;">
                <i class="fas fa-robot"></i> <span>BOTBOT</span>
            </a>
            <button id="m3uSyncBtn" class="whatsapp-status-btn wa-m3u"
                style="border: none; cursor: pointer; text-decoration: none;" onclick="openM3uModal()">
                <i class="fas fa-list-ul"></i> <span>M3U PLAYLIST</span>
            </button>
            <button id="configMenuBtn" class="whatsapp-status-btn"
                style="border: 1px solid var(--border); background: var(--bg-card); cursor: pointer; text-decoration: none; color: var(--text-primary);" onclick="openSettingsModal()">
                <i class="fas fa-cog"></i> <span>CONFIGURAÇÃO</span>
            </button>
            <button id="lockMenuBtn" class="whatsapp-status-btn"
                style="border: 1px solid var(--border); background: var(--bg-card); cursor: pointer; text-decoration: none; color: var(--text-primary);" onclick="openLockModal()">
                <i class="fas fa-lock"></i> <span id="lockBtnLabel">LOCK</span>
            </button>
            <button id="themeToggleBtn"
                style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s; margin-left: 5px;"
                onclick="toggleTheme()" title="Alternar Tema">
                <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
            </button>
            <a href="/admin/logout"
                style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fas fa-sign-out-alt"></i> Sair do Painel
            </a>
        </div>
    </header>

    <div class="dashboard-control-panel">
        <nav class="tabs">
            <a onclick="filterCategory('all')" id="tab-all" class="tab active">TODOS (<span id="count-all">0</span>)</a>
            <a onclick="filterCategory('series')" id="tab-series" class="tab">SÉRIES (<span id="count-series">0</span>)</a>
            <a onclick="filterCategory('movie')" id="tab-movie" class="tab">FILMES (<span id="count-movie">0</span>)</a>
            <a onclick="filterCategory('error')" id="tab-error" class="tab">ERROS (<span id="count-error">0</span>)</a>
        </nav>

        <div class="stats-summary">
            <div onclick="filterStatus('pending')" id="stat-pending" class="stat-pill active">📊 PENDENTES: <strong>
                    <%= stats.pending %>
                </strong></div>
            <div onclick="filterStatus('approved')" id="stat-approved" class="stat-pill">✅ APROVADOS: <strong>
                    <%= stats.approved %>
                </strong></div>
            <div onclick="filterStatus('rejected')" id="stat-rejected" class="stat-pill">❌ REJEITADOS: <strong>
                    <%= stats.rejected %>
                </strong></div>
            <div onclick="filterStatus('all')" id="stat-all" class="stat-pill">📋 TODOS</div>
        </div>

        <!-- Barra de Busca e Ordenação -->
        <div class="toolbar">
            <input type="text" id="searchInput" placeholder="Buscar por título do pedido ou nome da revenda..."
                onkeyup="debouncedApplyFilters()">
            <select id="m3uFilterSelect" onchange="applyFilters()">
                <option value="all" selected>Todos (M3U)</option>
                <option value="present">Presentes na M3U</option>
                <option value="absent">Ausentes na M3U</option>
            </select>
            <select id="sortSelect" onchange="sortCards()">
                <option value="yearDesc" selected>Ano de Lançamento (Novo - Antigo)</option>
                <option value="yearAsc">Ano de Lançamento (Antigo - Novo)</option>
                <option value="oldest">Mais Antigos (Data de Pedido)</option>
                <option value="newest">Mais Recentes (Data de Pedido)</option>
                <option value="resellerAsc">Revendedor (A - Z)</option>
                <option value="resellerDesc">Revendedor (Z - A)</option>
            </select>
        </div>
    </div>

    <main class="requests-grid">
        <% requests.forEach(req=> { 
            let allReqs = [req];
            if (req.subRequests) allReqs = allReqs.concat(req.subRequests);
            let statuses = [...new Set(allReqs.map(r => r.status))].join(',');
            let countDub = allReqs.filter(r => r.audioPreference === 'Dublado' && r.requestType !== 'error').length;
            let countLeg = allReqs.filter(r => r.audioPreference === 'Legendado' && r.requestType !== 'error').length;
            let countErr = allReqs.filter(r => r.requestType === 'error').length;
            let countPending = allReqs.filter(r => r.status === 'pending').length;
            let hasChatHistory = allReqs.some(r => r.rejectionReason || r.description);
            let chatDescription = '';
            allReqs.forEach(r => {
                let desc = r.description || '';
                if (r.rejectionReason && !desc.includes('[Rejeitado pelo Admin')) {
                    desc = (desc ? desc + '\n' : '') + `[Rejeitado pelo Admin - Motivo: ${r.rejectionReason}]`;
                }
                if (desc) {
                    chatDescription += (chatDescription ? '\n\n' : '') + desc;
                }
            });
            let hasAnyPending = allReqs.some(r => r.status === 'pending');
        %>
            <article class="request-card" id="card-<%= req.id %>" data-id="<%= req.id %>"
                data-category="<%= req.requestType === 'error' ? 'error' : req.type %>" 
                data-status="<%= req.status %>"
                data-statuses="<%= statuses %>"
                data-title="<%= (req.title || '').toLowerCase() %>"
                data-reseller="<%= (req.reseller || '').toLowerCase() %>" data-year="<%= req.year || 0 %>"
                data-in-m3u="<%= req.inM3u ? 'true' : 'false' %>"
                data-m3u-normalized="<%= req.m3uNormalized || '' %>"
                data-m3u-type="<%= req.type %>"
                data-tmdb-id="<%= req.tmdb_id || '' %>"
                data-all-requests="<%= encodeURIComponent(JSON.stringify(allReqs)) %>">

                    <div class="poster-container">
                        <img src="<%= req.poster || 'https://via.placeholder.com/500x750?text=Sem+Poster' %>"
                            class="poster-img" alt="Poster">
                        <span class="badge-status status-<%= req.status %>">
                            <%= req.status==='pending' ? 'Pendente' : (req.status==='approved' ? 'Aprovado'
                                : 'Rejeitado' ) %>
                        </span>
                        


                        <div class="audio-badges-container"
                            style="position: absolute; bottom: 8px; left: 8px; display: flex; flex-direction: column; gap: 5px; z-index: 10;">
                            <span class="badge-audio badge-dub"
                                     style="background: rgba(34, 197, 94, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #22c55e; <%= countDub > 0 ? '' : 'display: none;' %>">
                                     <i class="fas fa-microphone"></i>
                                     <span class="count-value"><%= countDub %></span> DUB
                            </span>
                            <span class="badge-audio badge-leg"
                                     style="background: rgba(245, 158, 11, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #f59e0b; <%= countLeg > 0 ? '' : 'display: none;' %>">
                                     <i class="fas fa-closed-captioning"></i>
                                     <span class="count-value"><%= countLeg %></span> LEG
                            </span>
                            <span class="badge-audio badge-err"
                                     style="background: rgba(239, 68, 68, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #ef4444; <%= countErr > 0 ? '' : 'display: none;' %>">
                                     <i class="fas fa-exclamation-triangle"></i>
                                     <span class="count-value"><%= countErr %></span> ERRO
                            </span>
                        </div>
                    </div>

                    <div class="card-body">
                        <div style="font-size: 0.65rem; text-transform: uppercase; color: var(--text-muted); font-weight: 800; letter-spacing: 0.5px; margin-bottom: 2px;">TÍTULO</div>
                        <h4 class="card-title" title="<%= req.title %>">
                            <%= req.title %>
                        </h4>
                        <% if (req.requestType !=='error' && typeof hasM3uData !=='undefined' && hasM3uData) { %>
                            <div style="margin-bottom: 10px;">
                                <% if (req.inM3u) { %>
                                    <span onclick="showM3uDetails(this)"
                                        style="display: inline-flex; align-items: center; gap: 4px; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer;"
                                        title="Clique para ver detalhes na M3U">
                                        <i class="fas fa-check-circle"></i> Presentes na M3U <%= req.m3uTitle &&
                                            req.m3uTitle.toLowerCase() !==req.title.toLowerCase() ?
                                            `(como "${req.m3uTitle}" )` : '' %>
                                    </span>
                                    <% } else { %>
                                        <span
                                            style="display: inline-flex; align-items: center; gap: 4px; background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            <i class="fas fa-times-circle"></i> Ausentes na M3U
                                        </span>
                                        <% } %>
                            </div>
                            <% } %>
                                <div class="info-item"><i class="fas fa-calendar-day"></i> Lançamento: <%= req.year
                                        || 'N/A' %>
                                </div>
                                <div class="info-item"><i class="fas fa-tag"></i>
                                    <%= req.action %>
                                </div>
                                <% if(req.season) { %>
                                    <div class="info-item"><i class="fas fa-list-ol"></i> T: <%= req.season %> | <%= req.episode ? 'E: ' + req.episode : 'Completa' %>
                                    </div>
                                <% } %>



                                                <div class="info-item"><i class="fas fa-user-tag"></i>
                                                    <%= req.reseller %>
                                                </div>
                                                <div class="info-item" style="color: var(--status-approved);">
                                                    <i class="fab fa-whatsapp"></i>
                                                    <%= req.whatsapp %>
                                                            <div class="info-item"><i class="far fa-calendar-alt"></i>
                                                                <%= req.date %>
                                                            </div>
                                                </div>

                                                <div class="card-actions">
                                                     <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                                                          <button class="btn btn-tmdb"
                                                              onclick="window.open('https://www.themoviedb.org/search?query=<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '_blank')">
                                                              <i class="fas fa-search"></i> TMDB
                                                          </button>
                                                          <button class="btn btn-justwatch"
                                                              onclick="window.open('https://www.justwatch.com/br/busca?q=<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '_blank')">
                                                              <i class="fas fa-play"></i> JW
                                                          </button>
                                                          <button class="btn btn-palantir"
                                                              style="<%= req.tmdb_id ? '' : 'display: none;' %>"
                                                              onclick="searchPalantir(<%= req.id %>, '<%= req.tmdb_id %>', '<%= encodeURIComponent(req.title).replace(/'/g, "\\'") %>', '<%= req.type || 'movie' %>')">
                                                              <i class="fas fa-satellite-dish"></i> Palantir
                                                          </button>
                                                     </div>
                                                    <button class="btn btn-chat-history"
                                                        style="<%= hasChatHistory ? 'display: flex;' : 'display: none;' %>"
                                                        onclick="openChatModal('<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '<%= encodeURIComponent(chatDescription).replace(/'/g, "%27") %>')">
                                                            <i class="fas fa-comments"></i> Conversa / Histórico
                                                    </button>
                                                    <button class="btn btn-details-action"
                                                        style="margin-bottom: 5px; width: 100%; <%= allReqs.length > 1 ? 'background: rgba(59, 130, 246, 0.08); color: #60a5fa; border-color: rgba(59, 130, 246, 0.3);' : 'background: rgba(245, 158, 11, 0.08); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);' %>"
                                                        data-details="<%= encodeURIComponent(JSON.stringify(allReqs)) %>"
                                                        onclick="openDetailsModal(this.dataset.details)">
                                                        <% if (allReqs.length > 1) { %>
                                                            <i class="fas fa-list"></i> Histórico de Pedidos
                                                        <% } else { %>
                                                            <i class="fas fa-cog"></i> Opções do Pedido
                                                        <% } %>
                                                    </button>
                                                    <div class="btn-group approval-btn-group"
                                                        id="btnGroup-<%= req.id %>"
                                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; <%= hasAnyPending ? '' : 'display: none;' %>">
                                                        <button class="btn btn-approve"
                                                            onclick="updateStatus(<%= req.id %>, 'approved', null, <%= countPending > 1 %>)">
                                                            <%= countPending > 1 ? 'Aprovar Pendentes' : 'Aprovar' %>
                                                        </button>
                                                        <button class="btn btn-reject"
                                                            onclick="openRejectModal(<%= req.id %>, '<%= req.type %>', <%= countPending > 1 %>)">
                                                            <%= countPending > 1 ? 'Rejeitar Pendentes' : 'Rejeitar' %>
                                                        </button>
                                                    </div>
                                                </div>
                    </div>
            </article>
            <% }); %>
    </main>

    <!-- Modal de Rejeição -->
    <div id="rejectModal" class="modal-overlay" style="z-index: 3200;">
        <div class="modal-content">
            <h3 class="modal-header">MOTIVO DA REJEIÇÃO DO PEDIDO</h3>
            <div class="quick-buttons">
                <button class="btn-quick" onclick="setReason('REPETIDO')">REPETIDO</button>
                <button class="btn-quick" onclick="setReason('ANTIGO')">ANTIGO</button>
                <button class="btn-quick" onclick="setReason('INDISPONIVEL')">INDISPONÍVEL</button>
                <button class="btn-quick" onclick="setReason('ERRO')">ERRO</button>
                <button class="btn-quick" onclick="setReason('JACONSTA')">JÁ CONSTA</button>
                <button class="btn-quick" onclick="setReason('EXTERNO')">EXTERNO</button>
                <button class="btn-quick" onclick="setReason('RECENTE')">RECENTE</button>
                <button class="btn-quick" onclick="setReason('DUBLADO')">DUBLADO</button>
            </div>
            <textarea id="rejectionText" rows="15" placeholder="Ou digite um motivo personalizado..."></textarea>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;"
                    onclick="closeRejectModal()">CANCELAR</button>
                <button class="btn btn-reject" style="background: var(--status-rejected); color: #fff;"
                    id="confirmRejectBtn">CONFIRMAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Detalhes Agrupados -->
    <div id="detailsModal" class="modal-overlay" style="z-index: 3000;">
        <div class="modal-content" style="max-width: 1300px; width: 95%;">
            <h3 class="modal-header">📦 Detalhes dos Pedidos Agrupados</h3>
            <div
                style="max-height: 65vh; overflow-y: auto; overflow-x: auto; width: 100%; background: #000; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 0.6rem;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                    <thead style="background: #111; position: sticky; top: 0;">
                        <tr>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Revendedor</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Ação</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Detalhes (Temp/Ep/Erro)</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Data</th>
                            <th style="padding: 12px 15px; color: var(--text-muted); text-align: center; width: 300px;">
                                Ações</th>
                        </tr>
                    </thead>
                    <tbody id="detailsTableBody">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;" onclick="closeDetailsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Opções Unificado -->
    <div id="optionsModal" class="modal-overlay" style="z-index: 3100;">
        <div class="modal-content" style="max-width: 550px; width: 95%;">
            <h3 class="modal-header" id="optionsModalHeader" style="display: flex; align-items: center; gap: 10px;"><i
                    class="fas fa-cog"></i> Opções do Pedido</h3>

            <div
                style="background: #0d0d0d; border: 1px solid var(--border); padding: 12px; border-radius: 8px; margin-bottom: 0.6rem;">
                <p style="font-size: 0.95rem; margin-bottom: 4px;"><strong>Título:</strong> <span id="optionsModalTitle"
                        style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; margin-bottom: 4px;"><strong>Revenda:</strong> <span
                        id="optionsModalReseller" style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; display: flex; align-items: center; gap: 10px;">
                    <strong>Status:</strong>
                    <span id="optionsModalStatusBadge" class="badge-status"
                        style="position: static; padding: 4px 8px; font-size: 0.7rem;"></span>
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button id="optionsBtnPending" class="btn"
                    style="background: transparent; border: 1px solid var(--status-pending); color: var(--status-pending); width: 100%; padding: 12px; font-size: 0.85rem;"
                    onclick="handleOptionsPending()">
                    <i class="fas fa-undo"></i> Retornar para Pendente
                </button>
                <button id="optionsBtnAddNote" class="btn"
                    style="background: transparent; border: 1px solid #f59e0b; color: #f59e0b; width: 100%; padding: 12px; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 8px;"
                    onclick="handleOptionsAddNote()">
                    <i class="fas fa-comment-dots"></i> Pedir Explicação / Add Nota
                </button>
                <button id="optionsBtnDelete" class="btn"
                    style="background: rgba(220, 38, 38, 0.15); border: 1px solid #dc2626; color: #f87171; width: 100%; padding: 12px; font-size: 0.85rem; transition: 0.3s;"
                    onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='white';"
                    onmouseout="this.style.backgroundColor='rgba(220, 38, 38, 0.15)'; this.style.color='#f87171';"
                    onclick="handleOptionsDelete()">
                    <i class="fas fa-trash-alt"></i> Excluir Pedido
                </button>
            </div>

            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeOptionsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Histórico de Conversa (Chat) -->
    <div id="chatModal" class="modal-overlay" style="z-index: 3300;">
        <div class="modal-content" style="max-width: 800px; width: 95%;">
            <h3 class="modal-header">
                <i class="fas fa-comments" style="color: #3b82f6;"></i> Histórico de Conversa
            </h3>

            <p style="font-size: 0.95rem; margin-bottom: 8px; color: #aaa;"><strong>Pedido:</strong> <span
                    id="chatModalTitle" style="color: #fff; font-weight: bold;"></span></p>

            <div id="chatMessagesContainer"
                style="max-height: 60vh; overflow-y: auto; display: flex; flex-direction: column; gap: 8px; padding: 10px; background: #050505; border-radius: 8px; border: 1px solid var(--border);">
                <!-- Mensagens injetadas dinamicamente -->
            </div>

            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeChatModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Adicionar Nota / Pedir Explicação (Customizado) -->
    <div id="noteModal" class="modal-overlay" style="z-index: 3400;">
        <div class="modal-content" style="max-width: 700px; width: 95%;">
            <h3 class="modal-header" id="noteModalHeader"
                style="color: #fff; margin-bottom: 8px; font-weight: 700; display: flex; align-items: center; gap: 10px; border-bottom: none; padding-bottom: 0;">
                <i class="fas fa-comment-dots" style="color: #f59e0b;"></i> Pedir Explicação / Add Nota
            </h3>
            <p style="font-size: 0.9rem; color: #aaa; margin-bottom: 8px;">
                <strong>Pedido:</strong> <span id="noteModalTitle" style="color: #fff;"></span>
            </p>
            <textarea id="noteModalText" rows="6"
                style="width: 100%; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; padding: 12px; font-family: inherit; font-size: 0.9rem; margin-bottom: 8px; resize: vertical;"
                placeholder="Escreva a sua pergunta ou observação para o revendedor..."></textarea>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="btn"
                    style="background: #333; color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    onclick="closeNoteModal()">CANCELAR</button>
                <button class="btn"
                    style="background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    id="noteModalConfirmBtn">SALVAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Playlist M3U -->
