<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --bg-nav: #000000;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
            --status-pending: #f59e0b;
            --status-approved: #10b981;
            --status-rejected: #ef4444;
            --btn-blue: #007bff;
            --btn-justwatch: #fbc02d;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            padding-top: 80px;
            line-height: 1.5;
        }

        .header-fixed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: rgba(0,0,0,0.9);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            border-bottom: 1px solid var(--border);
            z-index: 2000;
        }

        .logo h2 { font-weight: 900; letter-spacing: -1px; }

        .stats-summary {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 20px;
            background: #050505;
        }

        .stat-pill {
            background: var(--bg-card);
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid var(--border);
            font-size: 0.85rem;
            font-weight: 600;
        }

        .stat-pill strong { color: var(--accent-red); margin: 0 4px; }

        .requests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
            padding: 20px;
            max-width: 1600px;
            margin: 0 auto;
        }

        .request-card {
            background: var(--bg-card);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid var(--border);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        .request-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent-red);
            box-shadow: 0 10px 30px rgba(229, 9, 20, 0.2);
        }

        .poster-container {
            position: relative;
            width: 100%;
            height: 320px;
            background: #1a1a1a;
        }

        .poster-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-status {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            background: rgba(0,0,0,0.8);
            backdrop-filter: blur(4px);
            border: 1px solid;
            z-index: 10;
        }

        .status-pending { border-color: var(--status-pending); color: var(--status-pending); }
        .status-approved { border-color: var(--status-approved); color: var(--status-approved); }
        .status-rejected { border-color: var(--status-rejected); color: var(--status-rejected); }

        .card-body { padding: 18px; flex-grow: 1; }
        .card-title { margin: 0 0 12px 0; font-size: 1.15rem; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; color: #fff; }
        .info-item { font-size: 0.85rem; color: var(--text-muted); margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
        .info-item i { width: 16px; text-align: center; color: var(--accent-red); }

        .card-actions { padding: 15px; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 10px; background: #0c0c0c; }
        .btn-group { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        
        .btn { 
            padding: 10px; 
            border-radius: 8px; 
            border: 1px solid transparent; 
            font-weight: 800; 
            cursor: pointer; 
            font-size: 0.75rem; 
            transition: all 0.2s;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        
        .btn-tmdb { background: var(--btn-blue); color: white; width: 100%; }
        .btn-tmdb:hover { background: #0056b3; }

        .btn-justwatch { background: var(--btn-justwatch); color: #000; width: 100%; margin-bottom: 5px; }
        .btn-justwatch:hover { background: #f9a825; }
        
        .btn-approve { background: transparent; border-color: var(--status-approved); color: var(--status-approved); }
        .btn-approve:hover { background: var(--status-approved); color: white; }
        
        .btn-reject { background: transparent; border-color: var(--status-rejected); color: var(--status-rejected); }
        .btn-reject:hover { background: var(--status-rejected); color: white; }

        .tabs { display: flex; gap: 30px; padding: 10px 20px; justify-content: center; margin-bottom: 10px; }
        .tab { text-decoration: none; color: var(--text-muted); font-weight: 700; font-size: 0.9rem; padding-bottom: 8px; border-bottom: 3px solid transparent; transition: 0.3s; }
        .tab.active { color: var(--accent-red); border-bottom-color: var(--accent-red); }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }
        .modal-content {
            background: #1a1a1a;
            padding: 2rem;
            border-radius: 1rem;
            width: 90%;
            max-width: 500px;
            border: 1px solid var(--border);
        }
        .modal-header { margin-bottom: 1.5rem; font-weight: 900; color: var(--accent-red); }
        .quick-buttons { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; margin-bottom: 1rem; }
        .btn-quick { background: #333; color: #fff; padding: 8px; border-radius: 4px; font-size: 0.7rem; border: none; cursor: pointer; }
        .btn-quick:hover { background: var(--accent-red); }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem; }
        
        textarea { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 8px; resize: none; }
        textarea:focus { border-color: var(--accent-red); outline: none; }

        @media (max-width: 600px) {
            .requests-grid { grid-template-columns: 1fr; }
            .header-fixed { padding: 0 1rem; }
        }
    </style>
</head>
<body>
    <header class="header-fixed">
        <div class="logo">
            <h2 style="color: var(--accent-red);">IMPERIO <span style="color: white;">VOD</span></h2>
        </div>
        <div class="user-info">
            <a href="/admin/logout" style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem; font-weight: 600;">
                <i class="fas fa-sign-out-alt"></i> Sair do Painel
            </a>
        </div>
    </header>

    <nav class="tabs">
        <a href="/" class="tab active">SOLICITAÇÕES</a>
        <a href="#" class="tab">REVENDEDORES</a>
        <a href="#" class="tab">CONFIGURAÇÕES</a>
    </nav>

    <div class="stats-summary">
        <div class="stat-pill">📊 PENDENTES: <strong><%= stats.pending %></strong></div>
        <div class="stat-pill">✅ APROVADOS: <strong><%= stats.approved %></strong></div>
        <div class="stat-pill">❌ REJEITADOS: <strong><%= stats.rejected %></strong></div>
    </div>

    <main class="requests-grid">
        <% requests.forEach(req => { %>
            <article class="request-card" id="card-<%= req.id %>">
                <div class="poster-container">
                    <img src="<%= req.poster || 'https://via.placeholder.com/500x750/111/333?text=Nenhum+Poster' %>" class="poster-img" alt="Poster">
                    <span class="badge-status status-<%= req.status %>">
                        <%= req.status === 'pending' ? 'Pendente' : (req.status === 'approved' ? 'Aprovado' : 'Rejeitado') %>
                    </span>
                </div>
                
                <div class="card-body">
                    <h4 class="card-title" title="<%= req.title %>"><%= req.title %></h4>
                    <div class="info-item"><i class="fas fa-compact-disc"></i> <%= req.type === 'series' ? 'Série' : 'Filme' %></div>
                    <div class="info-item"><i class="fas fa-tag"></i> <%= req.action %></div>
                    <% if(req.season) { %><div class="info-item"><i class="fas fa-list-ol"></i> T<%= req.season %> | E<%= req.episode || 'Full' %></div><% } %>
                    <div class="info-item"><i class="fas fa-user-tag"></i> <%= req.reseller %></div>
                    <div class="info-item" style="color: var(--status-approved);">
                        <i class="fab fa-whatsapp"></i> <%= req.whatsapp %>
                    </div>
                    <div class="info-item"><i class="far fa-calendar-alt"></i> <%= req.date %></div>
                </div>

                <div class="card-actions">
                    <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                        <button class="btn btn-tmdb" onclick="window.open('https://www.themoviedb.org/search?query=<%= encodeURIComponent(req.title) %>', '_blank')">
                            <i class="fas fa-search"></i> TMDB
                        </button>
                        <button class="btn btn-justwatch" onclick="window.open('https://www.justwatch.com/br/busca?q=<%= encodeURIComponent(req.title) %>', '_blank')">
                            <i class="fas fa-play"></i> JW
                        </button>
                    </div>
                    <div class="btn-group">
                        <button class="btn btn-approve" onclick="updateStatus(<%= req.id %>, 'approved')">Aprovar</button>
                        <button class="btn btn-reject" onclick="openRejectModal(<%= req.id %>)">Rejeitar</button>
                    </div>
                </div>
            </article>
        <% }); %>
    </main>

    <!-- Modal de Rejeição -->
    <div id="rejectModal" class="modal-overlay">
        <div class="modal-content">
            <h3 class="modal-header">MOTIVO DA REJEIÇÃO DO PEDIDO</h3>
            <div class="quick-buttons">
                <button class="btn-quick" onclick="setReason('REPETIDO')">REPETIDO</button>
                <button class="btn-quick" onclick="setReason('ANTIGO')">ANTIGO</button>
                <button class="btn-quick" onclick="setReason('INDISPONIVEL')">INDISPONÍVEL</button>
                <button class="btn-quick" onclick="setReason('ERRO')">ERRO</button>
                <button class="btn-quick" onclick="setReason('JACONSTA')">JÁ CONSTA</button>
                <button class="btn-quick" onclick="setReason('EXTERNO')">EXTERNO</button>
                <button class="btn-quick" onclick="setReason('RECENTE')">RECENTE</button>
            </div>
            <textarea id="rejectionText" rows="4" placeholder="Ou digite um motivo personalizado..."></textarea>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;" onclick="closeRejectModal()">CANCELAR</button>
                <button class="btn btn-reject" style="background: var(--status-rejected); color: #fff;" id="confirmRejectBtn">CONFIRMAR</button>
            </div>
        </div>
    </div>

    <script>
        let currentRequestId = null;
        let currentRequestType = null; // Para armazenar o tipo (movie/series)

        function openRejectModal(id, type) {
            currentRequestId = id;
            currentRequestType = type; // Armazena o tipo do pedido
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectionText').value = '';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            currentRequestId = null;
            currentRequestType = null;
        }

        function setReason(textKey) {
            let reasonText = '';
            switch (textKey) {
                case 'REPETIDO':
                    reasonText = 'Pedido Repetido.\n\nFavor não repetir os pedidos para não congestionar a fila.';
                    break;
                case 'ANTIGO':
                    if (currentRequestType === 'movie') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, FILMES produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nFilmes anteriores a 1980 serão rejeitados.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else if (currentRequestType === 'series') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, SÉRIES produzidas antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nSéries muito antigas serão rejeitadas.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else { // Default para tipo genérico ou não especificado
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, CONTEÚDOS produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    }
                    break;
                case 'INDISPONIVEL':
                    reasonText = 'Conteúdo Indisponível dublado ou legendado.';
                    break;
                case 'ERRO':
                    reasonText = `Poderia fornecer detalhes adicionais sobre o erro?\n\nPreciso identificar a obra (filme ou série), o número do episódio e o momento exato da falha.\n\nPor exemplo: 'No filme X ou no episódio Y da 1ª temporada, ocorre um erro a partir dos 10:30'.\n\nAlém disso, descreva o que aparece na tela (código de erro, travamento ou tela preta).`;
                    break;
                case 'JACONSTA':
                    reasonText = 'Já Consta no Servidor.\n\nFavor pesquisar nas categorias All ou todos em nas categorias individuais antes de solicitar os conteúdos.';
                    break;
                case 'EXTERNO':
                    reasonText = `Erro de reprodução normalmente é codec do aplicativo em versões muito antigas.\n\nComo Configurar o VLC PLAYER EXTERNO:\n\nVá para Configurações do aplicativo (Settings) onde tem um simbolo de engrenagem.\n\nProcure por "Player" ou "Player Padrão", "Jogador externo" ou "Leitor externo".\n\nSelecione "VLC" ou "Player Externo".\n\nSalve as configurações.\n\nQuando abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.\n\nMarque "Sempre" para definir como padrão.\n\nSe não tiver instalado o VLC a playstore vai se abrir.\n\nInstale o VLC Media Player da Play Store.\n\nTente abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.`;
                    break;
                case 'RECENTE':
                    reasonText = 'Filme lançado recentemente no Cinema.\n\nSomente disponível em 1080 FullHD depois de 3 a 5 meses ao sair nos Streamings.\n\nFavor aguardar, o conteúdo será atualizado automaticamente.';
                    break;
                default:
                    reasonText = '';
            }
            document.getElementById('rejectionText').value = reasonText;
        }

        document.getElementById('confirmRejectBtn').onclick = () => {
            const reason = document.getElementById('rejectionText').value;
            if(!reason) return alert('Por favor, informe um motivo.');
            updateStatus(currentRequestId, 'rejected', reason);
            closeRejectModal();
        };

        async function updateStatus(id, status, reason = null) {
            if (!reason && !confirm(`Deseja realmente alterar o status para ${status.toUpperCase()}?`)) return;

            try {
                const response = await fetch(`/api/requests/${id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, rejectionReason: reason })
                });

                if (response.ok) {
                    const card = document.getElementById(`card-${id}`);
                    const badge = card.querySelector('.badge-status');
                    
                    // Atualiza Visual
                    badge.className = `badge-status status-${status}`;
                    badge.innerText = status;
                    
                    alert('Status atualizado com sucesso!');
                    location.reload(); // Recarrega para atualizar os contadores no topo
                } else {
                    alert('Erro ao atualizar status.');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Falha na comunicação com o servidor.');
            }
        }
    </script>
</body>
</html>