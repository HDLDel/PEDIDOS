                <button class="btn" style="background: #8b5cf6; color: #fff; border: none; padding: 10px 24px; border-radius: 8px; font-weight: 600; cursor: pointer;" id="btnPalantirDownload" onclick="startPalantirDownload()">
                    <i class="fas fa-download"></i> Baixar Selecionados (<span id="palantirSelectedCount">0</span>)
