        function setReason(textKey) {
            let reasonText = '';
            switch (textKey) {
                case 'REPETIDO':
                    reasonText = 'Pedido Repetido.\n\nFavor não repetir os pedidos para não congestionar a fila.';
                    break;
                case 'ANTIGO':
                    if (currentRequestType === 'movie') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, FILMES produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nFilmes anteriores a 1980 serão rejeitados.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else if (currentRequestType === 'series') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, SÉRIES produzidas antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nSéries muito antigas serão rejeitadas.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else { // Default para tipo genérico ou não especificado
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, CONTEÚDOS produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    }
                    break;
                case 'INDISPONIVEL':
                    reasonText = 'Conteúdo Indisponível dublado ou legendado.';
                    break;
                case 'ERRO':
                    reasonText = `Poderia fornecer detalhes adicionais sobre o erro?\n\nPreciso identificar a obra (filme ou série), o número do episódio e o momento exato da falha.\n\nPor exemplo: 'No filme X ou no episódio Y da 1ª temporada, ocorre um erro a partir dos 10:30'.\n\nAlém disso, descreva o que aparece na tela (código de erro, travamento ou tela preta).`;
                    break;
                case 'JACONSTA':
                    reasonText = 'Já Consta no Servidor.\n\nFavor pesquisar nas categorias All ou todos em nas categorias individuais antes de solicitar os conteúdos.';
                    break;
                case 'EXTERNO':
                    reasonText = `Erro de reprodução normalmente é codec do aplicativo em versões muito antigas.\n\nComo Configurar o VLC PLAYER EXTERNO:\n\nVá para Configurações do aplicativo (Settings) onde tem um simbolo de engrenagem.\n\nProcure por "Player" ou "Player Padrão", "Jogador externo" ou "Leitor externo".\n\nSelecione "VLC" ou "Player Externo".\n\nSalve as configurações.\n\nQuando abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.\n\nMarque "Sempre" para definir como padrão.\n\nSe não tiver instalado o VLC a playstore vai se abrir.\n\nInstale o VLC Media Player da Play Store.\n\nTente abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.`;
                    break;
                case 'RECENTE':
                    reasonText = 'Filme lançado recentemente no Cinema.\n\nSomente disponível em 1080 FullHD depois de 3 a 5 meses ao sair nos Streamings.\n\nFavor aguardar, o conteúdo será atualizado automaticamente.';
                    break;
                case 'DUBLADO':
                    reasonText = `*🚨 Pedido Rejeitado — Motivo: Conteúdo Incompleto / Sem Dublagem Integral*\n\nInfelizmente, este conteúdo não existe totalmente dublado em português. A dublagem oficial foi realizada apenas até uma parte da obra e, após isso, a exibição no Brasil foi interrompida (geralmente por baixa audiência na TV ou falta de retorno financeiro), deixando o restante dos episódios sem tradução na nossa língua.\n\nEsse problema é muito comum em novelas turcas, mexicanas, doramas e séries/filmes asiáticos pelos seguintes motivos:\n\n*Formato longo e extenso:* Muitas dessas produções estrangeiras (especialmente novelas diárias) possuem centenas de episódios. O processo de dublagem profissional é extremamente caro e demorado, exigindo um investimento que as distribuidoras muitas vezes não conseguem pagar por inteiro.\n\n*Abandono de transmissão:* Quando uma emissora ou plataforma de streaming traz uma produção de nicho para o Brasil e o público não corresponde ao esperado, o projeto é cancelado no meio do caminho para evitar prejuízos.\n\n*Lançamento internacional lento:* Por conta do volume massivo de capítulos, o mercado global prioriza o lançamento de versões apenas legendadas para manter a transmissão ágil. A dublagem, quando acontece, é feita a passos muito lentos por distribuidoras locais.\n\n*Resumo:* O restante dos episódios só está disponível no idioma original com legendas. Como o nosso catálogo foca em conteúdos completos/dublados conforme solicitado, o pedido não poderá ser atendido.\n\nSem detalhes adicionais. Agradecemos a compreensão.`;
                    break;
                default:
                    reasonText = '';
            }
            document.getElementById('rejectionText').value = reasonText;
        }

        document.getElementById('confirmRejectBtn').onclick = () => {
            const reason = document.getElementById('rejectionText').value;
            if (!reason) return alert('Por favor, informe um motivo.');
            updateStatus(currentRequestId, 'rejected', reason, currentSyncAll);
            closeRejectModal();
        };

        async function updateStatus(id, status, reason = null, syncAll = true) {
            if (!reason && !confirm(`Deseja realmente alterar o status para ${status.toUpperCase()}?`)) return;

            try {
                const response = await fetch(`/api/requests/${id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, rejectionReason: reason, syncAll })
                });

                if (response.ok) {
                    const reqData = await response.json(); // Recebe o objeto do banco de dados atualizado

                    const updateCardElement = (cardEl, targetData) => {
                        cardEl.dataset.status = targetData.status;
                        const badge = cardEl.querySelector('.badge-status');
                        if (badge) {
                            badge.className = `badge-status status-${targetData.status}`;
                            badge.innerText = targetData.status === 'pending' ? 'Pendente' : (targetData.status === 'approved' ? 'Aprovado' : 'Rejeitado');
                        }

                        // Gerenciamento dos botões de ação e do botão de conversa
                        const actions = cardEl.querySelector('.card-actions');
                        if (actions) {
                            // Remove o botão de conversa existente para evitar duplicações
                            const existingChatBtn = Array.from(actions.querySelectorAll('button')).find(btn => btn.innerHTML.includes('Conversa / Histórico'));
                            if (existingChatBtn) {
                                existingChatBtn.remove();
                            }

                            // Se houver histórico de conversa, recria o botão de forma dinâmica
                            const hasChatHistory = !!(targetData.rejectionReason || targetData.description);
                            if (hasChatHistory) {
                                let chatDescription = targetData.description || '';
                                if (targetData.rejectionReason && !chatDescription.includes('[Rejeitado pelo Admin')) {
                                    chatDescription = (chatDescription ? chatDescription + '\n' : '') + `[Rejeitado pelo Admin - Motivo: ${targetData.rejectionReason}]`;
                                }

                                const chatBtn = document.createElement('button');
                                chatBtn.className = 'btn';
                                chatBtn.style = 'background: rgba(37, 99, 235, 0.15); border: 1px solid #2563eb; color: #3b82f6; margin-bottom: 8px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;';
                                chatBtn.innerHTML = `<i class="fas fa-comments"></i> Conversa / Histórico`;

                                const titleEsc = encodeURIComponent(targetData.title || '').replace(/'/g, "%27");
                                const descEsc = encodeURIComponent(chatDescription).replace(/'/g, "%27");
                                chatBtn.onclick = () => openChatModal(titleEsc, descEsc);

                                const firstChild = actions.firstElementChild;
                                if (firstChild) {
                                    actions.insertBefore(chatBtn, firstChild.nextElementSibling);
                                } else {
                                    actions.appendChild(chatBtn);
                                }
                            }

                            const cardId = parseInt(cardEl.dataset.id);
                            const btnGroup = document.getElementById(`btnGroup-${cardId}`);

                            if (targetData.status === 'pending') {
                                if (btnGroup) btnGroup.remove();

                                const detailsBtn = cardEl.querySelector('[data-details]');
                                let hasMultiplePending = false;
                                if (detailsBtn) {
                                    try {
                                        const details = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                                        hasMultiplePending = details.filter(sub => sub.status === 'pending').length > 1;
                                    } catch (e) { }
                                }

                                const newBtnGroup = document.createElement('div');
                                newBtnGroup.className = 'btn-group';
                                newBtnGroup.id = `btnGroup-${cardId}`;
                                newBtnGroup.style = 'display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%;';

                                newBtnGroup.innerHTML = `
                                    <button class="btn btn-approve" onclick="updateStatus(${cardId}, 'approved', null, ${hasMultiplePending})">
                                        ${hasMultiplePending ? 'Aprovar Pendentes' : 'Aprovar'}
                                    </button>
                                    <button class="btn btn-reject" onclick="openRejectModal(${cardId}, '${targetData.type}', ${hasMultiplePending})">
                                        ${hasMultiplePending ? 'Rejeitar Pendentes' : 'Rejeitar'}
                                    </button>
                                `;
                                actions.appendChild(newBtnGroup);
                            } else {
                                if (btnGroup) btnGroup.remove();
                            }
                        }
                    };

                    if (syncAll) {
                        const card = document.getElementById(`card-${id}`);
                        if (card) {
                            updateCardElement(card, reqData);

                            const detailsBtn = card.querySelector('[data-details]');
                            if (detailsBtn) {
                                try {
                                    const details = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                                    details.forEach(sub => {
                                        sub.status = reqData.status;
                                        if (reqData.status === 'rejected' && reqData.rejectionReason) {
                                            sub.rejectionReason = reqData.rejectionReason;
                                        }
                                    });
                                    detailsBtn.dataset.details = encodeURIComponent(JSON.stringify(details));

                                    const groupedBadgeSpan = card.querySelector('.badge-grouped span');
                                    if (groupedBadgeSpan) groupedBadgeSpan.remove();
                                } catch (e) {
                                    console.error(e);
                                }
                            }
                        }

                        document.querySelectorAll('.request-card').forEach(c => {
                            const detailsBtn = c.querySelector('[data-details]');
                            if (detailsBtn) {
                                try {
                                    const details = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                                    const containsTarget = details.some(sub => sub.id === id);
                                    if (containsTarget) {
                                        details.forEach(sub => {
                                            sub.status = reqData.status;
                                            if (reqData.status === 'rejected' && reqData.rejectionReason) {
                                                sub.rejectionReason = reqData.rejectionReason;
                                            }
                                            updateModalRow(sub.id, reqData);
                                        });
                                        detailsBtn.dataset.details = encodeURIComponent(JSON.stringify(details));
                                        updateCardElement(c, reqData);
                                        const groupedBadgeSpan = c.querySelector('.badge-grouped span');
                                        if (groupedBadgeSpan) groupedBadgeSpan.remove();
                                    }
                                } catch (e) {
                                    console.error(e);
                                }
                            }
                        });
                    } else {
                        const card = document.getElementById(`card-${id}`);
                        if (card) {
                            updateCardElement(card, reqData);
                        }

                        updateModalRow(id, reqData);

                        document.querySelectorAll('.request-card').forEach(c => {
                            const detailsBtn = c.querySelector('[data-details]');
                            if (detailsBtn) {
                                try {
                                    const details = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                                    let updatedAny = false;
                                    details.forEach(sub => {
                                        if (sub.id === id) {
                                            sub.status = reqData.status;
                                            if (reqData.status === 'rejected' && reqData.rejectionReason) {
                                                sub.rejectionReason = reqData.rejectionReason;
                                            }
                                            updatedAny = true;
                                        }
                                    });
                                    if (updatedAny) {
                                        detailsBtn.dataset.details = encodeURIComponent(JSON.stringify(details));

                                        const hasAnyPending = details.some(sub => sub.status === 'pending');
                                        if (!hasAnyPending) {
                                            updateCardElement(c, reqData);
                                            const groupedBadgeSpan = c.querySelector('.badge-grouped span');
                                            if (groupedBadgeSpan) groupedBadgeSpan.remove();
                                        } else {
                                            const pendingCount = details.filter(sub => sub.status === 'pending').length;
                                            const groupedBadgeSpan = c.querySelector('.badge-grouped span');
                                            if (groupedBadgeSpan) {
                                                groupedBadgeSpan.innerText = pendingCount;
                                            }
                                        }
                                    }
                                } catch (e) {
                                    console.error(e);
                                }
                            }
                        });
                    }

                    await refreshStats();
                    applyFilters();
                } else {
                    alert('Erro ao atualizar status.');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Falha na comunicação com o servidor.');
            }
        }

        function updateModalRow(rowId, targetData) {
            const modalRow = document.getElementById(`modal-row-${rowId}`);
            if (modalRow) {
                const cells = modalRow.getElementsByTagName('td');
                if (cells.length > 0) {
                    const actionCell = cells[cells.length - 1];
                    const badgeText = targetData.status === 'approved' ? 'Aprovado' : 'Rejeitado';

                    const card = document.getElementById(`card-${rowId}`) || document.querySelector(`.request-card[data-details*="${rowId}"]`);
                    let reqType = 'movie';
                    let reqTitle = '';
                    let reqReseller = '';
                    if (card) {
                        reqType = card.dataset.category || 'movie';
                        reqTitle = encodeURIComponent(card.dataset.title || '');
                        reqReseller = encodeURIComponent(card.dataset.reseller || '');
                    }

                    const hasChat = !!(targetData.rejectionReason || targetData.description);
                    let chatDescription = targetData.description || '';
                    if (targetData.rejectionReason && !chatDescription.includes('[Rejeitado pelo Admin')) {
                        chatDescription = (chatDescription ? chatDescription + '\n' : '') + `[Rejeitado pelo Admin - Motivo: ${targetData.rejectionReason}]`;
                    }

                    actionCell.innerHTML = `
                        <div style="display: flex; gap: 8px; align-items: center; justify-content: center; width: 100%;">
                            <span class="badge-status status-${targetData.status}" style="position: static; padding: 5px 8px; font-size: 0.75rem; font-weight: 700; text-transform: uppercase;">${badgeText}</span>
                            ${hasChat ? `
                            <button class="btn" style="background: rgba(37, 99, 235, 0.15); border: 1px solid #2563eb; color: #3b82f6; padding: 6px 10px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: 0.2s;" 
                                    onmouseover="this.style.background='#2563eb'; this.style.color='white';"
                                    onmouseout="this.style.background='rgba(37, 99, 235, 0.15)'; this.style.color='#3b82f6';"
                                    onclick="openChatModal('${reqTitle}', '${encodeURIComponent(chatDescription)}')">
                                <i class="fas fa-comment-dots"></i>
                            </button>
                            ` : ''}
                            <button class="btn" style="background: #222; border: 1px solid #444; color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 0.75rem; cursor: pointer; transition: 0.2s;" 
                                    onmouseover="this.style.background='#333';"
                                    onmouseout="this.style.background='#222';"
                                    onclick="openOptionsModal(${rowId}, '${reqType}', '${targetData.status}', '${reqTitle}', '${reqReseller}', false)">
                                <i class="fas fa-cog"></i>
                            </button>
                        </div>
                    `;
                }
            }
        }

        async function deleteRequest(id, syncAll = true) {
            if (!confirm(syncAll ? 'Deseja realmente excluir este pedido e todos os seus agrupados permanentemente?' : 'Deseja realmente excluir este pedido individual permanentemente?')) return;

            try {
                let idsToDelete = [id];
                if (syncAll) {
                    const card = document.getElementById(`card-${id}`);
                    if (card) {
                        const detailsBtn = card.querySelector('[data-details]');
                        if (detailsBtn) {
                            const data = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                            idsToDelete = data.map(r => r.id);
                        }
                    }
                }

                let successCount = 0;
                for (const deleteId of idsToDelete) {
                    const response = await fetch(`/api/requests/${deleteId}`, {
                        method: 'DELETE'
                    });
                    if (response.ok) {
                        successCount++;
                    }
                }

                if (successCount > 0) {
                    alert('Pedido(s) excluído(s) com sucesso!');
                    location.reload();
                } else {
                    alert('Erro ao excluir pedido(s).');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Falha na comunicação com o servidor.');
            }
        }

        let optionsRequestId = null;
        let optionsRequestType = null;
        let optionsRequestStatus = null;
        let optionsSyncAll = true;

        function openOptionsModal(id, type, status, title, reseller, syncAll = true) {
            optionsRequestId = id;
            optionsRequestType = type;
            optionsRequestStatus = status;
            optionsSyncAll = syncAll;

            // Set content details
            document.getElementById('optionsModalTitle').innerText = decodeURIComponent(title);
            document.getElementById('optionsModalReseller').innerText = decodeURIComponent(reseller);

            // Configure status badge
            const badge = document.getElementById('optionsModalStatusBadge');
            badge.className = `badge-status status-${status}`;
            badge.innerText = status === 'pending' ? 'Pendente' : (status === 'approved' ? 'Aprovado' : 'Rejeitado');

            // Configure actions visibility
            document.getElementById('optionsBtnPending').style.display = status === 'pending' ? 'none' : 'flex';
            document.getElementById('optionsBtnAddNote').style.display = status === 'pending' ? 'flex' : 'none';

            // Delete button text
            const deleteBtn = document.getElementById('optionsBtnDelete');
            deleteBtn.innerHTML = syncAll ? '<i class="fas fa-trash-alt"></i> Excluir Pedido e Agrupados' : '<i class="fas fa-trash-alt"></i> Excluir Pedido';

            document.getElementById('optionsModal').style.display = 'flex';
        }

        function closeOptionsModal() {
            document.getElementById('optionsModal').style.display = 'none';
        }

        function openChatModal(title, encodedDescription) {
            const description = decodeURIComponent(encodedDescription);
            document.getElementById('chatModalTitle').innerText = decodeURIComponent(title);

            const container = document.getElementById('chatMessagesContainer');
            container.innerHTML = '';

            // Separar as mensagens por bloco de resposta
            const blocks = description.split(/(?=\[Rejeitado pelo Admin|\[Resposta do Revendedor)/g);

            blocks.forEach(block => {
                const trimmed = block.trim();
                if (!trimmed) return;

                let isReseller = trimmed.startsWith('[Resposta do Revendedor');
                let isRejection = trimmed.startsWith('[Rejeitado pelo Admin');

                let bubbleStyle = '';
                let headerText = '';
                let contentText = '';

                if (isReseller) {
                    bubbleStyle = 'background: rgba(37, 99, 235, 0.15); border-left: 3px solid #2563eb; color: #e2e8f0; align-self: flex-end; width: 90%;';
                    const match = trimmed.match(/\[Resposta do Revendedor em ([^\]]+)\]:\s*([\s\S]*)/);
                    if (match) {
                        headerText = `👤 Revendedor (${match[1]})`;
                        contentText = match[2];
                    } else {
                        headerText = `👤 Resposta do Revendedor`;
                        contentText = trimmed;
                    }
                } else if (isRejection) {
                    bubbleStyle = 'background: rgba(239, 68, 68, 0.15); border-left: 3px solid #ef4444; color: #e2e8f0; align-self: flex-start; width: 90%;';
                    const match = trimmed.match(/\[Rejeitado pelo Admin - Motivo: ([^\]]+)\]\s*([\s\S]*)/);
                    if (match) {
                        headerText = `🚨 Rejeição - Motivo: ${match[1]}`;
                        contentText = match[2] || 'Sem detalhes adicionais.';
                    } else {
                        headerText = `🚨 Rejeitado pelo Admin`;
                        contentText = trimmed;
                    }
                } else {
                    bubbleStyle = 'background: rgba(255, 255, 255, 0.05); border-left: 3px solid #555; color: #ccc; align-self: flex-start; width: 90%;';
                    headerText = `📝 Observações do Pedido`;
                    contentText = trimmed;
                }

                container.innerHTML += `
                    <div style="padding: 10px 12px; border-radius: 8px; font-size: 0.85rem; word-break: break-word; line-height: 1.4; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); ${bubbleStyle}">
                        <div style="font-weight: bold; font-size: 0.75rem; color: #fff; opacity: 0.9; margin-bottom: 2px;">${headerText}</div>
                        <div style="white-space: pre-wrap;">${contentText}</div>
                    </div>
                `;
            });

            if (container.innerHTML === '') {
                container.innerHTML = '<div style="color: #666; text-align: center; font-size: 0.85rem; padding: 20px;">Nenhuma mensagem registrada.</div>';
            }

            document.getElementById('chatModal').style.display = 'flex';
        }

        function closeChatModal() {
            document.getElementById('chatModal').style.display = 'none';
        }



        function handleOptionsPending() {
            closeOptionsModal();
            openNoteModal('pending', (note) => {
                updateStatus(optionsRequestId, 'pending', note || null, optionsSyncAll);
            });
        }

        function handleOptionsAddNote() {
            closeOptionsModal();
            openNoteModal('add_note', (note) => {
                updateStatus(optionsRequestId, 'pending', note, optionsSyncAll);
            });
        }

        let noteModalAction = null;
        function openNoteModal(actionType, confirmCallback) {
            noteModalAction = actionType;
            const cardTitle = document.getElementById('optionsModalTitle').innerText;
            document.getElementById('noteModalTitle').innerText = cardTitle;

            const header = document.getElementById('noteModalHeader');
            const textarea = document.getElementById('noteModalText');

            if (actionType === 'pending') {
                header.innerHTML = '<i class="fas fa-undo" style="color: #f59e0b;"></i> Retornar para Pendente';
                textarea.placeholder = "Deseja deixar uma pergunta ou observação? (Opcional, deixe em branco se não quiser adicionar nota)...";
                textarea.value = '';
            } else {
                header.innerHTML = '<i class="fas fa-comment-dots" style="color: #f59e0b;"></i> Pedir Explicação / Add Nota';
                textarea.placeholder = "Escreva aqui a sua pergunta ou observação detalhada para o revendedor...";
                textarea.value = '';
            }

            document.getElementById('noteModalConfirmBtn').onclick = () => {
                const note = textarea.value.trim();
                if (actionType === 'add_note' && !note) {
                    alert('Por favor, digite a sua observação.');
                    return;
                }
                confirmCallback(note);
                closeNoteModal();
            };

            document.getElementById('noteModal').style.display = 'flex';
        }

        function closeNoteModal() {
            document.getElementById('noteModal').style.display = 'none';
        }

        function handleOptionsDelete() {
            closeOptionsModal();
            deleteRequest(optionsRequestId, optionsSyncAll);
        }

        // Lógica do Botão Voltar ao Topo
        const backToTopBtn = document.getElementById('backToTop');

        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTopBtn.classList.add('show');
            } else {
                backToTopBtn.classList.remove('show');
            }
        });

        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });

        function toggleTheme() {
            const isLight = document.documentElement.classList.toggle('light-theme');
            document.body.classList.toggle('light-theme', isLight);
            try {
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
            } catch (e) {
                console.error('Falha ao salvar o tema:', e);
            }
            updateThemeIcon(isLight);
        }

        function updateThemeIcon(isLight) {
            const icon = document.getElementById('themeIcon');
            if (icon) {
                if (isLight) {
                    icon.className = 'fas fa-moon';
                    icon.style.color = '#374151';
                } else {
                    icon.className = 'fas fa-sun';
                    icon.style.color = '#f59e0b';
                }
            }
        }

        // Aplica o filtro de status inicial (Pendentes) ao carregar a página
        document.addEventListener('DOMContentLoaded', () => {
            applyFilters();
            const isLight = document.documentElement.classList.contains('light-theme');
            updateThemeIcon(isLight);
        });
    </script>
</body>

</html>