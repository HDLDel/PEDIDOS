<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script>
        (function () {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light') {
                    document.documentElement.classList.add('light-theme');
                    document.addEventListener('DOMContentLoaded', () => {
                        document.body.classList.add('light-theme');
                    });
                }
            } catch (e) {
                console.error('Falha ao acessar o localStorage:', e);
            }
        })();
    </script>
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --bg-nav: #000000;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
            --status-pending: #f59e0b;
            --status-approved: #10b981;
            --status-rejected: #ef4444;
            --btn-blue: #007bff;
            --btn-justwatch: #fbc02d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            padding-top: 80px;
            line-height: 1.5;
        }

        .header-fixed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            z-index: 2000;
        }

        .whatsapp-status-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--bg-card);
            transition: 0.3s;
        }

        .wa-on {
            color: #10b981;
            border-color: #10b981;
        }

        .wa-off {
            color: #ef4444;
            border-color: #ef4444;
        }

        .wa-qr {
            color: #f59e0b;
            border-color: #f59e0b;
        }

        .wa-m3u {
            color: #3b82f6;
            border-color: #3b82f6;
        }

        .wa-m3u:hover {
            background: rgba(59, 130, 246, 0.1);
        }

        .logo h2 {
            font-weight: 900;
            letter-spacing: -1px;
        }

        .stats-summary {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 20px;
            background: #080808;
        }

        .stat-pill {
            background: var(--bg-card);
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid var(--border);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .stat-pill.active {
            border-color: var(--accent-red);
            background: rgba(229, 9, 20, 0.1);
        }

        .stat-pill strong {
            color: var(--accent-red);
            margin: 0 4px;
        }

        .requests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            padding: 20px 3rem;
            max-width: 100%;
            margin: 0 auto;
        }

        .request-card {
            background: var(--bg-card);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid var(--border);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        .request-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent-red);
            box-shadow: 0 10px 30px rgba(229, 9, 20, 0.2);
        }

        .poster-container {
            position: relative;
            width: 100%;
            aspect-ratio: 2/3;
            height: auto;
            background: #1a1a1a;
        }

        .poster-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-status {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            border: 1px solid;
            z-index: 10;
        }

        .status-pending {
            border-color: var(--status-pending);
            color: var(--status-pending);
        }

        .status-approved {
            border-color: var(--status-approved);
            color: var(--status-approved);
        }

        .status-rejected {
            border-color: var(--status-rejected);
            color: var(--status-rejected);
        }

        .card-body {
            padding: 18px;
            flex-grow: 1;
        }

        .card-title {
            margin: 0 0 12px 0;
            font-size: 1.15rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #fff;
        }

        .info-item {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .info-item i {
            width: 16px;
            text-align: center;
            color: var(--accent-red);
        }

        .card-actions {
            padding: 15px;
            border-top: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #0c0c0c;
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid transparent;
            font-weight: 800;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-tmdb {
            background: var(--btn-blue);
            color: white;
            width: 100%;
        }

        .btn-tmdb:hover {
            background: #0056b3;
        }

        .btn-justwatch {
            background: var(--btn-justwatch);
            color: #000;
            width: 100%;
            margin-bottom: 5px;
        }

        .btn-justwatch:hover {
            background: #f9a825;
        }

        .btn-approve {
            background: transparent;
            border-color: var(--status-approved);
            color: var(--status-approved);
        }

        .btn-approve:hover {
            background: var(--status-approved);
            color: white;
        }

        .btn-reject {
            background: transparent;
            border-color: var(--status-rejected);
            color: var(--status-rejected);
        }

        .btn-reject:hover {
            background: var(--status-rejected);
            color: white;
        }

        .tabs {
            display: flex;
            gap: 30px;
            padding: 10px 20px;
            justify-content: center;
            margin-bottom: 10px;
        }

        .tab {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            padding-bottom: 8px;
            border-bottom: 3px solid transparent;
            transition: 0.3s;
            cursor: pointer;
        }

        .tab.active {
            color: var(--accent-red);
            border-bottom-color: var(--accent-red);
        }

        .request-card.hidden {
            display: none;
        }

        /* Toolbar (Search & Sort) */
        .toolbar {
            display: flex;
            gap: 15px;
            padding: 0 3rem 10px;
            max-width: 100%;
            margin: 0 auto;
        }

        .toolbar input,
        .toolbar select {
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #080808;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            transition: 0.3s;
        }

        .toolbar input {
            flex: 1;
        }

        .toolbar input:focus,
        .toolbar select:focus {
            border-color: var(--accent-red);
            box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.2);
        }

        @media (max-width: 600px) {
            .toolbar {
                flex-direction: column;
                padding: 0 1rem 20px;
            }
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #1a1a1a;
            padding: 2rem;
            border-radius: 1rem;
            width: 90%;
            max-width: 900px;
            border: 1px solid var(--border);
        }

        .modal-header {
            margin-bottom: 1.5rem;
            font-weight: 900;
            color: var(--accent-red);
        }

        .quick-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 1.5rem;
        }

        .btn-quick {
            background: #333;
            color: #fff;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 0.8rem;
            border: 1px solid #444;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
        }

        .btn-quick:hover {
            background: var(--accent-red);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 1.5rem;
        }

        textarea {
            width: 100%;
            background: #000;
            border: 1px solid var(--border);
            color: #fff;
            padding: 20px;
            border-radius: 8px;
            resize: vertical;
            min-height: 450px;
            font-family: inherit;
            font-size: 1.05rem;
            line-height: 1.6;
        }

        textarea:focus {
            border-color: var(--accent-red);
            outline: none;
        }

        /* Botão Voltar ao Topo */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background-color: var(--accent-red);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
            z-index: 2500;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            transform: translateY(-5px);
            background-color: #ff0f1a;
        }

        @media (max-width: 600px) {
            .requests-grid {
                grid-template-columns: 1fr;
            }

            .header-fixed {
                padding: 0 1rem;
            }
        }
    </style>
</head>

<body>
    <header class="header-fixed">
        <div class="logo">
            <h2 style="color: var(--accent-red);">IMPERIO <span style="color: white;">APPS</span></h2>
        </div>
        <div class="user-info" style="display: flex; align-items: center; gap: 20px;">
            <a href="/admin/whatsapp" id="waStatusBtn" class="whatsapp-status-btn wa-off"
                style="text-decoration: none;">
                <i class="fab fa-whatsapp"></i> <span>OFFLINE</span>
            </a>
            <a href="/admin/botbot" id="bbStatusBtn" class="whatsapp-status-btn wa-off" style="text-decoration: none;">
                <i class="fas fa-robot"></i> <span>BOTBOT</span>
            </a>
            <button id="m3uSyncBtn" class="whatsapp-status-btn wa-m3u"
                style="border: none; cursor: pointer; text-decoration: none;" onclick="openM3uModal()">
                <i class="fas fa-list-ul"></i> <span>M3U PLAYLIST</span>
            </button>
            <button id="themeToggleBtn"
                style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s; margin-left: 5px;"
                onclick="toggleTheme()" title="Alternar Tema">
                <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
            </button>
            <a href="/admin/logout"
                style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 5px;">
                <i class="fas fa-sign-out-alt"></i> Sair do Painel
            </a>
        </div>
    </header>

    <nav class="tabs">
        <a onclick="filterCategory('all')" id="tab-all" class="tab active">TODOS (<span id="count-all">0</span>)</a>
        <a onclick="filterCategory('series')" id="tab-series" class="tab">SÉRIES (<span id="count-series">0</span>)</a>
        <a onclick="filterCategory('movie')" id="tab-movie" class="tab">FILMES (<span id="count-movie">0</span>)</a>
        <a onclick="filterCategory('error')" id="tab-error" class="tab">ERROS (<span id="count-error">0</span>)</a>
        <a href="/admin/resellers" class="tab">GESTÃO DE REVENDAS</a>
    </nav>

    <div class="stats-summary">
        <div onclick="filterStatus('pending')" id="stat-pending" class="stat-pill active">📊 PENDENTES: <strong>
                <%= stats.pending %>
            </strong></div>
        <div onclick="filterStatus('approved')" id="stat-approved" class="stat-pill">✅ APROVADOS: <strong>
                <%= stats.approved %>
            </strong></div>
        <div onclick="filterStatus('rejected')" id="stat-rejected" class="stat-pill">❌ REJEITADOS: <strong>
                <%= stats.rejected %>
            </strong></div>
        <div onclick="filterStatus('all')" id="stat-all" class="stat-pill">📋 TODOS</div>
    </div>

    <!-- Barra de Busca e Ordenação -->
    <div class="toolbar">
        <input type="text" id="searchInput" placeholder="Buscar por título do pedido ou nome da revenda..."
            onkeyup="applyFilters()">
        <select id="m3uFilterSelect" onchange="applyFilters()">
            <option value="all" selected>Todos (M3U)</option>
            <option value="present">Presentes na M3U</option>
            <option value="absent">Ausentes na M3U</option>
        </select>
        <select id="sortSelect" onchange="sortCards()">
            <option value="oldest" selected>Mais Antigos (Data de Pedido)</option>
            <option value="newest">Mais Recentes (Data de Pedido)</option>
            <option value="yearDesc">Ano de Lançamento (Novo - Antigo)</option>
            <option value="yearAsc">Ano de Lançamento (Antigo - Novo)</option>
            <option value="resellerAsc">Revendedor (A - Z)</option>
            <option value="resellerDesc">Revendedor (Z - A)</option>
        </select>
    </div>

    <main class="requests-grid">
        <% requests.forEach(req=> { %>
            <article class="request-card" id="card-<%= req.id %>" data-id="<%= req.id %>"
                data-category="<%= req.requestType === 'error' ? 'error' : req.type %>" data-status="<%= req.status %>"
                data-title="<%= (req.title || '').toLowerCase() %>"
                data-reseller="<%= (req.reseller || '').toLowerCase() %>" data-year="<%= req.year || 0 %>"
                data-in-m3u="<%= req.inM3u ? 'true' : 'false' %>">

                <% let allReqs=[req]; if (req.subRequests) allReqs=allReqs.concat(req.subRequests); let
                    countDub=allReqs.filter(r=> r.audioPreference === 'Dublado' && r.requestType !== 'error').length;
                    let countLeg = allReqs.filter(r => r.audioPreference === 'Legendado' && r.requestType !==
                    'error').length;
                    let countErr = allReqs.filter(r => r.requestType === 'error').length;
                    let countPending = allReqs.filter(r => r.status === 'pending').length;
                    %>
                    <div class="poster-container">
                        <img src="<%= req.poster || 'https://via.placeholder.com/500x750?text=Sem+Poster' %>"
                            class="poster-img" alt="Poster">
                        <span class="badge-status status-<%= req.status %>">
                            <%= req.status==='pending' ? 'Pendente' : (req.status==='approved' ? 'Aprovado'
                                : 'Rejeitado' ) %>
                        </span>
                        <% if (allReqs.length> 1) { %>
                            <div class="badge-grouped"
                                style="position: absolute; top: 15px; left: 15px; background: rgba(59, 130, 246, 0.9); color: white; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 800; z-index: 10; border: 1px solid #3b82f6;">
                                <i class="fas fa-layer-group"></i>
                                <%= allReqs.length %> AGRUPADOS
                                    <% if (countPending> 0) { %><span
                                            style="background: #ef4444; border-radius: 50%; padding: 2px 5px; margin-left: 5px;">
                                            <%= countPending %>
                                        </span>
                                        <% } %>
                            </div>
                            <% } %>

                                <div
                                    style="position: absolute; bottom: 10px; left: 10px; display: flex; flex-direction: column; gap: 5px; z-index: 10;">
                                    <% if (countDub> 0) { %><span
                                            style="background: rgba(16, 185, 129, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #10b981;"><i
                                                class="fas fa-microphone"></i>
                                            <%= countDub %> DUB
                                        </span>
                                        <% } %>
                                            <% if (countLeg> 0) { %><span
                                                    style="background: rgba(245, 158, 11, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #f59e0b;"><i
                                                        class="fas fa-closed-captioning"></i>
                                                    <%= countLeg %> LEG
                                                </span>
                                                <% } %>
                                                    <% if (countErr> 0) { %><span
                                                            style="background: rgba(239, 68, 68, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #ef4444;"><i
                                                                class="fas fa-exclamation-triangle"></i>
                                                            <%= countErr %> ERRO
                                                        </span>
                                                        <% } %>
                                </div>
                    </div>

                    <div class="card-body">
                        <h4 class="card-title" title="<%= req.title %>">
                            <%= req.title %>
                        </h4>
                        <% if (req.requestType !=='error' && typeof hasM3uData !=='undefined' && hasM3uData) { %>
                            <div style="margin-bottom: 10px;">
                                <% if (req.inM3u) { %>
                                    <span
                                        style="display: inline-flex; align-items: center; gap: 4px; background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;"
                                        title="Na playlist M3U como: <%= req.m3uTitle %>">
                                        <i class="fas fa-check-circle"></i> Presentes na M3U <%= req.m3uTitle &&
                                            req.m3uTitle.toLowerCase() !==req.title.toLowerCase() ?
                                            `(como "${req.m3uTitle}" )` : '' %>
                                    </span>
                                    <% } else { %>
                                        <span
                                            style="display: inline-flex; align-items: center; gap: 4px; background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 700;">
                                            <i class="fas fa-times-circle"></i> Ausentes na M3U
                                        </span>
                                        <% } %>
                            </div>
                            <% } %>
                                <div class="info-item"><i class="fas fa-calendar-day"></i> Lançamento: <%= req.year
                                        || 'N/A' %>
                                </div>
                                <div class="info-item"><i class="fas fa-tag"></i>
                                    <%= req.action %>
                                </div>
                                <% if(req.season) { %>
                                    <div class="info-item"><i class="fas fa-list-ol"></i> T<%= req.season %> | E<%=
                                                req.episode || 'Full' %>
                                    </div>
                                    <% } %>

                                        <% if(req.audioPreference) { %>
                                            <div class="info-item"><i class="fas fa-volume-up"></i> Áudio: <strong>
                                                    <%= req.audioPreference %>
                                                </strong></div>
                                            <% } %>

                                                <div class="info-item"><i class="fas fa-user-tag"></i>
                                                    <%= req.reseller %>
                                                </div>
                                                <div class="info-item" style="color: var(--status-approved);">
                                                    <i class="fab fa-whatsapp"></i>
                                                    <%= req.whatsapp %>
                                                    <% let hasChatHistory=!!(req.rejectionReason || req.description); let replyCount=0; if (req.description) { replyCount=(req.description.match(/\[Resposta do Revendedor/g) || []).length; } let chatDescription=req.description || '' ; if (req.rejectionReason && !chatDescription.includes('[Rejeitado pelo Admin')) { chatDescription=(chatDescription ? chatDescription + '\n' : '' ) + `[Rejeitado pelo Admin - Motivo: ${req.rejectionReason}]`; } %>
                                                            <div class="info-item"><i class="far fa-calendar-alt"></i>
                                                                <%= req.date %>
                                                            </div>
                                                </div>

                                                <div class="card-actions">
                                                    <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                                                        <button class="btn btn-tmdb"
                                                            onclick="window.open('https://www.themoviedb.org/search?query=<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '_blank')">
                                                            <i class="fas fa-search"></i> TMDB
                                                        </button>
                                                        <button class="btn btn-justwatch"
                                                            onclick="window.open('https://www.justwatch.com/br/busca?q=<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '_blank')">
                                                            <i class="fas fa-play"></i> JW
                                                        </button>
                                                    </div>
                                                    <% if (hasChatHistory) { %>
                                                        <button class="btn"
                                                            style="background: rgba(37, 99, 235, 0.15); border: 1px solid #2563eb; color: #3b82f6; margin-bottom: 8px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;"
                                                            onclick="openChatModal('<%= encodeURIComponent(req.title).replace(/'/g, "%27") %>', '<%= encodeURIComponent(chatDescription).replace(/'/g, "%27") %>')">
                                                                <i class="fas fa-comments"></i> Conversa / Histórico
                                                        </button>
                                                        <% } %>
                                                            <% if (allReqs.length> 1) { %>
                                                                <button class="btn"
                                                                    style="background: #3b82f6; color: white; margin-bottom: 5px; width: 100%;"
                                                                    data-details="<%= encodeURIComponent(JSON.stringify([req, ...req.subRequests])) %>"
                                                                    onclick="openDetailsModal(this.dataset.details)">
                                                                    <i class="fas fa-list"></i> Histórico de Pedidos
                                                                </button>
                                                                <% } else { %>
                                                                    <button class="btn"
                                                                        style="background: #f59e0b; color: #000; margin-bottom: 5px; width: 100%;"
                                                                        data-details="<%= encodeURIComponent(JSON.stringify([req])) %>"
                                                                        onclick="openDetailsModal(this.dataset.details)">
                                                                        <i class="fas fa-cog"></i> Opções do Pedido
                                                                    </button>
                                                                    <% } %>
                                                                        <% if (req.status==='pending' ) { %>
                                                                            <div class="btn-group"
                                                                                id="btnGroup-<%= req.id %>"
                                                                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%;">
                                                                                <button class="btn btn-approve"
                                                                                    onclick="updateStatus(<%= req.id %>, 'approved', null, <%= countPending > 1 %>)">
                                                                                    <%= countPending > 1 ? 'Aprovar Pendentes' : 'Aprovar' %>
                                                                                </button>
                                                                                <button class="btn btn-reject"
                                                                                    onclick="openRejectModal(<%= req.id %>, '<%= req.type %>', <%= countPending > 1 %>)">
                                                                                    <%= countPending > 1 ? 'Rejeitar Pendentes' : 'Rejeitar' %>
                                                                                </button>
                                                                            </div>
                                                                            <% } %>
                                                </div>
                    </div>
            </article>
            <% }); %>
    </main>

    <!-- Modal de Rejeição -->
    <div id="rejectModal" class="modal-overlay" style="z-index: 3200;">
        <div class="modal-content">
            <h3 class="modal-header">MOTIVO DA REJEIÇÃO DO PEDIDO</h3>
            <div class="quick-buttons">
                <button class="btn-quick" onclick="setReason('REPETIDO')">REPETIDO</button>
                <button class="btn-quick" onclick="setReason('ANTIGO')">ANTIGO</button>
                <button class="btn-quick" onclick="setReason('INDISPONIVEL')">INDISPONÍVEL</button>
                <button class="btn-quick" onclick="setReason('ERRO')">ERRO</button>
                <button class="btn-quick" onclick="setReason('JACONSTA')">JÁ CONSTA</button>
                <button class="btn-quick" onclick="setReason('EXTERNO')">EXTERNO</button>
                <button class="btn-quick" onclick="setReason('RECENTE')">RECENTE</button>
                <button class="btn-quick" onclick="setReason('DUBLADO')">DUBLADO</button>
            </div>
            <textarea id="rejectionText" rows="15" placeholder="Ou digite um motivo personalizado..."></textarea>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;"
                    onclick="closeRejectModal()">CANCELAR</button>
                <button class="btn btn-reject" style="background: var(--status-rejected); color: #fff;"
                    id="confirmRejectBtn">CONFIRMAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Detalhes Agrupados -->
    <div id="detailsModal" class="modal-overlay" style="z-index: 3000;">
        <div class="modal-content" style="max-width: 950px; width: 95%;">
            <h3 class="modal-header">📦 Detalhes dos Pedidos Agrupados</h3>
            <div
                style="max-height: 400px; overflow-y: auto; background: #000; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 1.5rem;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                    <thead style="background: #111; position: sticky; top: 0;">
                        <tr>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Revendedor</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Ação</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Detalhes (Temp/Ep/Erro)</th>
                            <th style="padding: 12px 15px; color: var(--text-muted);">Data</th>
                            <th style="padding: 12px 15px; color: var(--text-muted); text-align: center; width: 300px;">
                                Ações</th>
                        </tr>
                    </thead>
                    <tbody id="detailsTableBody">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;" onclick="closeDetailsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Opções Unificado -->
    <div id="optionsModal" class="modal-overlay" style="z-index: 3100;">
        <div class="modal-content" style="max-width: 450px;">
            <h3 class="modal-header" id="optionsModalHeader" style="display: flex; align-items: center; gap: 10px;"><i
                    class="fas fa-cog"></i> Opções do Pedido</h3>

            <div
                style="background: #0d0d0d; border: 1px solid var(--border); padding: 15px; border-radius: 8px; margin-bottom: 1.5rem;">
                <p style="font-size: 0.95rem; margin-bottom: 8px;"><strong>Título:</strong> <span id="optionsModalTitle"
                        style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; margin-bottom: 8px;"><strong>Revenda:</strong> <span
                        id="optionsModalReseller" style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; display: flex; align-items: center; gap: 10px;">
                    <strong>Status:</strong>
                    <span id="optionsModalStatusBadge" class="badge-status"
                        style="position: static; padding: 4px 8px; font-size: 0.7rem;"></span>
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button id="optionsBtnPending" class="btn"
                    style="background: transparent; border: 1px solid var(--status-pending); color: var(--status-pending); width: 100%; padding: 12px; font-size: 0.85rem;"
                    onclick="handleOptionsPending()">
                    <i class="fas fa-undo"></i> Retornar para Pendente
                </button>
                <button id="optionsBtnAddNote" class="btn"
                    style="background: transparent; border: 1px solid #f59e0b; color: #f59e0b; width: 100%; padding: 12px; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 8px;"
                    onclick="handleOptionsAddNote()">
                    <i class="fas fa-comment-dots"></i> Pedir Explicação / Add Nota
                </button>
                <button id="optionsBtnDelete" class="btn"
                    style="background: rgba(220, 38, 38, 0.15); border: 1px solid #dc2626; color: #f87171; width: 100%; padding: 12px; font-size: 0.85rem; transition: 0.3s;"
                    onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='white';"
                    onmouseout="this.style.backgroundColor='rgba(220, 38, 38, 0.15)'; this.style.color='#f87171';"
                    onclick="handleOptionsDelete()">
                    <i class="fas fa-trash-alt"></i> Excluir Pedido
                </button>
            </div>

            <div class="modal-footer" style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeOptionsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Histórico de Conversa (Chat) -->
    <div id="chatModal" class="modal-overlay" style="z-index: 3300;">
        <div class="modal-content"
            style="max-width: 500px; background: #0d0d0d; border: 1px solid #222; box-shadow: 0 10px 25px rgba(0,0,0,0.8);">
            <h3 class="modal-header"
                style="display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #222; padding-bottom: 15px;">
                <i class="fas fa-comments" style="color: #3b82f6;"></i> Histórico de Conversa
            </h3>

            <p style="font-size: 0.95rem; margin-bottom: 15px; color: #aaa;"><strong>Pedido:</strong> <span
                    id="chatModalTitle" style="color: #fff; font-weight: bold;"></span></p>

            <div id="chatMessagesContainer"
                style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 10px; background: #050505; border-radius: 8px; border: 1px solid #1a1a1a;">
                <!-- Mensagens injetadas dinamicamente -->
            </div>

            <div class="modal-footer"
                style="margin-top: 1.5rem; border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: flex-end;">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeChatModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Adicionar Nota / Pedir Explicação (Customizado) -->
    <div id="noteModal" class="modal-overlay" style="z-index: 3400;">
        <div class="modal-content"
            style="max-width: 500px; background: #111; border: 1px solid #333; padding: 25px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
            <h3 class="modal-header" id="noteModalHeader"
                style="color: #fff; margin-bottom: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; border-bottom: none; padding-bottom: 0;">
                <i class="fas fa-comment-dots" style="color: #f59e0b;"></i> Pedir Explicação / Add Nota
            </h3>
            <p style="font-size: 0.9rem; color: #aaa; margin-bottom: 15px;">
                <strong>Pedido:</strong> <span id="noteModalTitle" style="color: #fff;"></span>
            </p>
            <textarea id="noteModalText" rows="6"
                style="width: 100%; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; padding: 12px; font-family: inherit; font-size: 0.9rem; margin-bottom: 20px; resize: vertical;"
                placeholder="Escreva a sua pergunta ou observação para o revendedor..."></textarea>
            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="btn"
                    style="background: #333; color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    onclick="closeNoteModal()">CANCELAR</button>
                <button class="btn"
                    style="background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    id="noteModalConfirmBtn">SALVAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Playlist M3U -->
    <div id="m3uModal" class="modal-overlay" style="z-index: 3150;">
        <div class="modal-content"
            style="max-width: 500px; background: #111; border: 1px solid #333; padding: 25px; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
            <h3 class="modal-header"
                style="color: #fff; margin-bottom: 15px; font-weight: 700; display: flex; align-items: center; gap: 10px; border-bottom: none; padding-bottom: 0;">
                <i class="fas fa-list-ul" style="color: #3b82f6;"></i> Sincronizar Playlist M3U
            </h3>

            <div
                style="background: #0d0d0d; border: 1px solid var(--border); padding: 15px; border-radius: 8px; margin-bottom: 1.5rem; font-size: 0.9rem;">
                <p style="margin-bottom: 8px; color: #aaa;"><strong>Última Sincronização:</strong> <span
                        id="m3uLastSync" style="color: #fff;">Carregando...</span></p>
                <p style="margin-bottom: 8px; color: #aaa;"><strong>Estatísticas:</strong> <span id="m3uStats"
                        style="color: #fff;">Carregando...</span></p>
            </div>

            <div style="margin-bottom: 20px;">
                <label for="m3uSourceInput"
                    style="display: block; font-size: 0.9rem; color: #ccc; margin-bottom: 8px; font-weight: 600;">Link
                    da Playlist M3U ou Caminho do Arquivo:</label>
                <input type="text" id="m3uSourceInput"
                    style="width: 100%; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; padding: 12px; font-family: inherit; font-size: 0.9rem;"
                    placeholder="http://exemplo.com/lista.m3u ou exemplo.m3u">
            </div>

            <div id="m3uLoadingMsg"
                style="display: none; align-items: center; gap: 10px; color: #f59e0b; font-size: 0.9rem; margin-bottom: 20px;">
                <i class="fas fa-spinner fa-spin"></i> <span>Processando playlist M3U... Isso pode demorar alguns
                    segundos.</span>
            </div>

            <div style="display: flex; justify-content: flex-end; gap: 10px;">
                <button class="btn"
                    style="background: #333; color: #fff; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    onclick="closeM3uModal()">FECHAR</button>
                <button class="btn"
                    style="background: #dc2626; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    id="m3uClearBtn" onclick="runM3uClear()">LIMPAR LISTA</button>
                <button class="btn"
                    style="background: #2563eb; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;"
                    id="m3uSyncConfirmBtn" onclick="runM3uSync()">SINCRONIZAR AGORA</button>
            </div>
        </div>
    </div>

    <button id="backToTop" class="back-to-top" title="Voltar ao topo">
        <i class="fas fa-chevron-up"></i>
    </button>

    <script>
        let currentRequestId = null;
        let currentRequestType = null; // Para armazenar o tipo (movie/series)
        let currentSyncAll = true;
        let activeCategory = 'all';
        let activeStatus = 'pending';
        let checkStatusInterval = null;

        async function openM3uModal() {
            document.getElementById('m3uModal').style.display = 'flex';
            document.getElementById('m3uLoadingMsg').style.display = 'none';
            document.getElementById('m3uSyncConfirmBtn').disabled = false;

            // Buscar status atual do servidor
            try {
                const res = await fetch('/api/m3u/status');
                const data = await res.json();
                if (data.success) {
                    document.getElementById('m3uSourceInput').value = data.source || 'exemplo.m3u';
                    document.getElementById('m3uLastSync').innerText = data.lastSync || 'Nunca sincronizado';
                    if (data.stats && typeof data.stats.movies !== 'undefined') {
                        document.getElementById('m3uStats').innerText = `${data.stats.movies} filmes, ${data.stats.series} séries`;
                    } else {
                        document.getElementById('m3uStats').innerText = 'Sem dados de estatísticas';
                    }
                }
            } catch (e) {
                console.error("Erro ao obter status M3U:", e);
            }
        }

        function closeM3uModal() {
            document.getElementById('m3uModal').style.display = 'none';
        }

        async function runM3uSync() {
            const source = document.getElementById('m3uSourceInput').value.trim();
            if (!source) {
                alert('Por favor, informe a URL ou caminho da playlist.');
                return;
            }

            const confirmBtn = document.getElementById('m3uSyncConfirmBtn');
            const loadingMsg = document.getElementById('m3uLoadingMsg');

            confirmBtn.disabled = true;
            loadingMsg.style.display = 'flex';

            try {
                const res = await fetch('/api/m3u/sync', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ source })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Sincronização M3U concluída com sucesso! A página será recarregada.');
                    window.location.reload();
                } else {
                    alert('Erro na sincronização: ' + (data.error || 'Erro desconhecido'));
                    confirmBtn.disabled = true;
                    confirmBtn.disabled = false;
                    loadingMsg.style.display = 'none';
                }
            } catch (e) {
                alert('Falha crítica na sincronização: ' + e.message);
                confirmBtn.disabled = false;
                loadingMsg.style.display = 'none';
            }
        }

        async function runM3uClear() {
            if (!confirm('Deseja realmente limpar todos os dados importados da M3U? Isso removerá o indicador de presença dos pedidos.')) return;
            const clearBtn = document.getElementById('m3uClearBtn');
            clearBtn.disabled = true;
            try {
                const res = await fetch('/api/m3u/clear', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    }
                });
                const data = await res.json();
                if (data.success) {
                    alert('Dados da M3U limpos com sucesso! A página será recarregada.');
                    window.location.reload();
                } else {
                    alert('Erro ao limpar dados: ' + (data.error || 'Erro desconhecido'));
                    clearBtn.disabled = false;
                }
            } catch (e) {
                alert('Falha crítica ao limpar dados: ' + e.message);
                clearBtn.disabled = false;
            }
        }

        async function checkWaStatus() {
            try {
                const res = await fetch('/api/whatsapp/status');
                const data = await res.json();
                const btn = document.getElementById('waStatusBtn');
                const btnText = btn.querySelector('span');

                btn.className = 'whatsapp-status-btn ' + (data.status === 'ready' ? 'wa-on' : (data.status === 'qr' ? 'wa-qr' : 'wa-off'));
                btnText.innerText = 'WA LOCAL ' + data.status.toUpperCase();

                const resBb = await fetch('/api/botbot/status');
                const dataBb = await resBb.json();
                const bbBtn = document.getElementById('bbStatusBtn');
                const bbBtnText = bbBtn.querySelector('span');
                bbBtn.className = 'whatsapp-status-btn ' + (dataBb.status === 'ready' ? 'wa-on' : 'wa-off');
                bbBtnText.innerText = 'BOTBOT ' + dataBb.status.toUpperCase();
            } catch (e) {
                console.error("Erro ao verificar status das APIs:", e);
            }
        }

        setInterval(checkWaStatus, 5000); // Atualiza status a cada 5 segundos

        function applyFilters() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();
            const m3uFilter = document.getElementById('m3uFilterSelect').value;

            document.querySelectorAll('.request-card').forEach(card => {
                const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
                const statusMatch = activeStatus === 'all' || card.dataset.status === activeStatus;

                const titleMatch = card.dataset.title.includes(searchQuery);
                const resellerMatch = card.dataset.reseller.includes(searchQuery);
                const searchMatch = !searchQuery || titleMatch || resellerMatch;

                const m3uMatch = m3uFilter === 'all' ||
                    (m3uFilter === 'present' && card.dataset.inM3u === 'true') ||
                    (m3uFilter === 'absent' && card.dataset.inM3u === 'false');

                if (categoryMatch && statusMatch && searchMatch && m3uMatch) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });

            // Atualiza os contadores das categorias das abas em tempo real
            updateCategoryCounters();
        }

        function updateCategoryCounters() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();

            let countAll = 0;
            let countSeries = 0;
            let countMovie = 0;
            let countError = 0;

            document.querySelectorAll('.request-card').forEach(card => {
                const statusMatch = activeStatus === 'all' || card.dataset.status === activeStatus;
                const titleMatch = card.dataset.title.includes(searchQuery);
                const resellerMatch = card.dataset.reseller.includes(searchQuery);
                const searchMatch = !searchQuery || titleMatch || resellerMatch;

                if (statusMatch && searchMatch) {
                    countAll++;
                    if (card.dataset.category === 'series') countSeries++;
                    else if (card.dataset.category === 'movie') countMovie++;
                    else if (card.dataset.category === 'error') countError++;
                }
            });

            document.getElementById('count-all').innerText = countAll;
            document.getElementById('count-series').innerText = countSeries;
            document.getElementById('count-movie').innerText = countMovie;
            document.getElementById('count-error').innerText = countError;
        }

        function sortCards() {
            const grid = document.querySelector('.requests-grid');
            const cards = Array.from(grid.querySelectorAll('.request-card'));
            const sortType = document.getElementById('sortSelect').value;

            const getYear = (dateStr) => {
                if (!dateStr || dateStr === '0') return 0;
                const parts = dateStr.split('/');
                return parts.length === 3 ? parseInt(parts[2]) : parseInt(dateStr) || 0;
            };

            cards.sort((a, b) => {
                if (sortType === 'newest') return parseInt(b.dataset.id) - parseInt(a.dataset.id);
                if (sortType === 'oldest') return parseInt(a.dataset.id) - parseInt(b.dataset.id);
                if (sortType === 'yearDesc') return getYear(b.dataset.year) - getYear(a.dataset.year);
                if (sortType === 'yearAsc') return getYear(a.dataset.year) - getYear(b.dataset.year);
                if (sortType === 'resellerAsc') return a.dataset.reseller.localeCompare(b.dataset.reseller);
                if (sortType === 'resellerDesc') return b.dataset.reseller.localeCompare(a.dataset.reseller);
            });

            // Re-anexa os cards na nova ordem (o navegador move os elementos automaticamente)
            cards.forEach(card => grid.appendChild(card));
        }

        function filterCategory(category) {
            activeCategory = category;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(`tab-${category}`).classList.add('active');
            applyFilters();
        }

        function filterStatus(status) {
            activeStatus = status;
            document.querySelectorAll('.stat-pill').forEach(p => p.classList.remove('active'));
            document.getElementById(`stat-${status}`).classList.add('active');
            applyFilters();
        }

        async function refreshStats() {
            try {
                const res = await fetch('/api/stats');
                const stats = await res.json();
                document.querySelector('#stat-pending strong').innerText = stats.pending;
                document.querySelector('#stat-approved strong').innerText = stats.approved;
                document.querySelector('#stat-rejected strong').innerText = stats.rejected;
            } catch (error) {
                console.error('Erro ao atualizar estatísticas:', error);
            }
        }

        function openRejectModal(id, type, syncAll = true) {
            currentRequestId = id;
            currentRequestType = type;
            currentSyncAll = syncAll;
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectionText').value = '';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            currentRequestId = null;
            currentRequestType = null;
        }

        function openDetailsModal(encodedData) {
            const data = JSON.parse(decodeURIComponent(encodedData));
            const header = document.querySelector('#detailsModal .modal-header');
            if (header) {
                header.innerHTML = data.length > 1 ? '📦 Histórico de Pedidos Agrupados' : '⚙️ Opções do Pedido';
            }
            const tbody = document.getElementById('detailsTableBody');
            tbody.innerHTML = '';

            data.forEach(req => {
                let cleanDesc = req.description || '';
                if (cleanDesc && (cleanDesc.includes('[Rejeitado pelo Admin') || cleanDesc.includes('[Resposta do Revendedor'))) {
                    const idx = cleanDesc.search(/\[Rejeitado pelo Admin|\[Resposta do Revendedor/);
                    if (idx !== -1) {
                        cleanDesc = cleanDesc.substring(0, idx).trim();
                    }
                }

                let extraInfo = '';
                if (req.season) extraInfo += `T${req.season} `;
                if (req.episode) extraInfo += `E${req.episode} `;
                if (req.audioPreference && req.requestType !== 'error') extraInfo += `🎤 ${req.audioPreference} `;
                if (cleanDesc) extraInfo += `<br><span style="color: #bbb; font-size: 0.8rem;"><i class="far fa-comment-dots"></i> ${cleanDesc}</span>`;
                else if (req.requestType === 'error') extraInfo += `<br>⚠️ Erro reportado`;

                let actionsHtml = '';
                const hasChat = !!(req.rejectionReason || req.description);
                let chatDesc = req.description || '';
                if (req.rejectionReason && !chatDesc.includes('[Rejeitado pelo Admin')) {
                    chatDesc = (chatDesc ? chatDesc + '\n' : '') + `[Rejeitado pelo Admin - Motivo: ${req.rejectionReason}]`;
                }

                if (req.status === 'pending') {
                    actionsHtml = `
                        <div style="display: flex; gap: 8px; align-items: center; justify-content: center; width: 100%;">
                            <button class="btn btn-approve" style="background: transparent; border: 1px solid var(--status-approved); color: var(--status-approved); padding: 6px 12px; border-radius: 6px; font-size: 0.75rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 4px; transition: 0.2s;" 
                                    onmouseover="this.style.background='var(--status-approved)'; this.style.color='white';" 
                                    onmouseout="this.style.background='transparent'; this.style.color='var(--status-approved)';"
                                    onclick="updateStatus(${req.id}, 'approved', null, false)">
                                <i class="fas fa-check"></i> Aprovar
                            </button>
