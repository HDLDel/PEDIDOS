    <!-- Modal Lock (Manutenção) -->
    <div id="lockModal" class="modal-overlay" style="z-index: 3600;">
        <div class="modal-content" style="max-width: 550px; width: 95%;">
            <div class="modal-header">
                <h3><i class="fas fa-lock"></i> LOCK DE MANUTENÇÃO</h3>
                <button class="modal-close" onclick="closeLockModal()">&times;</button>
            </div>
            <div style="padding: 20px;">
                <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin-bottom: 20px;">
                    <input type="checkbox" id="lockEnabled" style="width: 20px; height: 20px; cursor: pointer;">
                    <span style="font-weight: 600; font-size: 14px;">Bloquear login de revendedores</span>
                </label>
                <label style="display: block; margin-bottom: 8px; font-size: 12px; font-weight: 600; color: var(--text-muted);">MENSAGEM EXIBIDA</label>
                <textarea id="lockMessage" rows="3" style="width: 100%; padding: 10px 12px; border: 1px solid var(--border); border-radius: 8px; background: #111; color: var(--text); font-size: 13px; resize: vertical; box-sizing: border-box;"></textarea>
                <div style="margin-top: 20px; display: flex; gap: 10px; justify-content: flex-end;">
                    <button onclick="closeLockModal()" style="padding: 8px 20px; border: 1px solid var(--border); border-radius: 8px; background: transparent; color: var(--text-muted); cursor: pointer; font-size: 13px;">CANCELAR</button>
                    <button onclick="saveLock()" style="padding: 8px 20px; border: none; border-radius: 8px; background: var(--accent-red); color: white; cursor: pointer; font-weight: 600; font-size: 13px;">SALVAR</button>
                </div>
