                <div style="margin-bottom: 12px;">
                    <label for="palantirUrlInput"
                        style="display: block; font-size: 0.85rem; color: #aaa; margin-bottom: 6px; font-weight: 600;">PALANTIR_API_URL:</label>
                    <input type="text" id="palantirUrlInput"
                        style="width: 100%; background: #000; border: 1px solid #333; border-radius: 8px; color: #fff; padding: 10px 12px; font-family: inherit; font-size: 0.9rem;"
