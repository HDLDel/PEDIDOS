<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --bg-nav: #000000;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
            --status-pending: #f59e0b;
            --status-approved: #10b981;
            --status-rejected: #ef4444;
            --btn-blue: #007bff;
            --btn-justwatch: #fbc02d;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background-color: var(--bg-main);
            color: var(--text-primary);
            font-family: 'Inter', sans-serif;
            padding-top: 80px;
            line-height: 1.5;
        }

        .header-fixed {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 70px;
            background: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(10px);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 2rem;
            border-bottom: 1px solid var(--border);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
            z-index: 2000;
        }

        .whatsapp-status-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 15px;
            border-radius: 50px;
            font-size: 0.8rem;
            font-weight: 700;
            cursor: pointer;
            border: 1px solid var(--border);
            background: var(--bg-card);
            transition: 0.3s;
        }

        .wa-on {
            color: #10b981;
            border-color: #10b981;
        }

        .wa-off {
            color: #ef4444;
            border-color: #ef4444;
        }

        .wa-qr {
            color: #f59e0b;
            border-color: #f59e0b;
        }

        .logo h2 {
            font-weight: 900;
            letter-spacing: -1px;
        }

        .stats-summary {
            display: flex;
            justify-content: center;
            gap: 15px;
            padding: 20px;
            background: #080808;
        }

        .stat-pill {
            background: var(--bg-card);
            padding: 8px 16px;
            border-radius: 50px;
            border: 1px solid var(--border);
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
        }

        .stat-pill.active {
            border-color: var(--accent-red);
            background: rgba(229, 9, 20, 0.1);
        }

        .stat-pill strong {
            color: var(--accent-red);
            margin: 0 4px;
        }

        .requests-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 25px;
            padding: 20px 3rem;
            max-width: 100%;
            margin: 0 auto;
        }

        .request-card {
            background: var(--bg-card);
            border-radius: 15px;
            overflow: hidden;
            border: 1px solid var(--border);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
        }

        .request-card:hover {
            transform: translateY(-8px);
            border-color: var(--accent-red);
            box-shadow: 0 10px 30px rgba(229, 9, 20, 0.2);
        }

        .poster-container {
            position: relative;
            width: 100%;
            aspect-ratio: 2/3;
            height: auto;
            background: #1a1a1a;
        }

        .poster-img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .badge-status {
            position: absolute;
            top: 15px;
            right: 15px;
            padding: 6px 12px;
            border-radius: 6px;
            font-size: 11px;
            font-weight: 900;
            text-transform: uppercase;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(4px);
            border: 1px solid;
            z-index: 10;
        }

        .status-pending {
            border-color: var(--status-pending);
            color: var(--status-pending);
        }

        .status-approved {
            border-color: var(--status-approved);
            color: var(--status-approved);
        }

        .status-rejected {
            border-color: var(--status-rejected);
            color: var(--status-rejected);
        }

        .card-body {
            padding: 18px;
            flex-grow: 1;
        }

        .card-title {
            margin: 0 0 12px 0;
            font-size: 1.15rem;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #fff;
        }

        .info-item {
            font-size: 0.85rem;
            color: var(--text-muted);
            margin-bottom: 6px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .info-item i {
            width: 16px;
            text-align: center;
            color: var(--accent-red);
        }

        .card-actions {
            padding: 15px;
            border-top: 1px solid var(--border);
            display: flex;
            flex-direction: column;
            gap: 10px;
            background: #0c0c0c;
        }

        .btn-group {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 10px;
        }

        .btn {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid transparent;
            font-weight: 800;
            cursor: pointer;
            font-size: 0.75rem;
            transition: all 0.2s;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-tmdb {
            background: var(--btn-blue);
            color: white;
            width: 100%;
        }

        .btn-tmdb:hover {
            background: #0056b3;
        }

        .btn-justwatch {
            background: var(--btn-justwatch);
            color: #000;
            width: 100%;
            margin-bottom: 5px;
        }

        .btn-justwatch:hover {
            background: #f9a825;
        }

        .btn-approve {
            background: transparent;
            border-color: var(--status-approved);
            color: var(--status-approved);
        }

        .btn-approve:hover {
            background: var(--status-approved);
            color: white;
        }

        .btn-reject {
            background: transparent;
            border-color: var(--status-rejected);
            color: var(--status-rejected);
        }

        .btn-reject:hover {
            background: var(--status-rejected);
            color: white;
        }

        .tabs {
            display: flex;
            gap: 30px;
            padding: 10px 20px;
            justify-content: center;
            margin-bottom: 10px;
        }

        .tab {
            text-decoration: none;
            color: var(--text-muted);
            font-weight: 700;
            font-size: 0.9rem;
            padding-bottom: 8px;
            border-bottom: 3px solid transparent;
            transition: 0.3s;
            cursor: pointer;
        }

        .tab.active {
            color: var(--accent-red);
            border-bottom-color: var(--accent-red);
        }

        .request-card.hidden {
            display: none;
        }

        /* Toolbar (Search & Sort) */
        .toolbar {
            display: flex;
            gap: 15px;
            padding: 0 3rem 10px;
            max-width: 100%;
            margin: 0 auto;
        }

        .toolbar input,
        .toolbar select {
            padding: 12px 15px;
            border-radius: 8px;
            border: 1px solid var(--border);
            background: #080808;
            color: var(--text-primary);
            font-family: inherit;
            font-size: 0.95rem;
            outline: none;
            transition: 0.3s;
        }

        .toolbar input {
            flex: 1;
        }

        .toolbar input:focus,
        .toolbar select:focus {
            border-color: var(--accent-red);
            box-shadow: 0 0 0 2px rgba(229, 9, 20, 0.2);
        }

        @media (max-width: 600px) {
            .toolbar {
                flex-direction: column;
                padding: 0 1rem 20px;
            }
        }

        /* Modal Styles */
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }

        .modal-content {
            background: #1a1a1a;
            padding: 2rem;
            border-radius: 1rem;
            width: 90%;
            max-width: 900px;
            border: 1px solid var(--border);
        }

        .modal-header {
            margin-bottom: 1.5rem;
            font-weight: 900;
            color: var(--accent-red);
        }

        .quick-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 1.5rem;
        }

        .btn-quick {
            background: #333;
            color: #fff;
            padding: 10px 15px;
            border-radius: 6px;
            font-size: 0.8rem;
            border: 1px solid #444;
            cursor: pointer;
            transition: all 0.2s;
            font-weight: 600;
        }

        .btn-quick:hover {
            background: var(--accent-red);
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 1.5rem;
        }

        textarea {
            width: 100%;
            background: #000;
            border: 1px solid var(--border);
            color: #fff;
            padding: 20px;
            border-radius: 8px;
            resize: vertical;
            min-height: 450px;
            font-family: inherit;
            font-size: 1.05rem;
            line-height: 1.6;
        }

        textarea:focus {
            border-color: var(--accent-red);
            outline: none;
        }

        /* Botão Voltar ao Topo */
        .back-to-top {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 50px;
            height: 50px;
            background-color: var(--accent-red);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            cursor: pointer;
            border: none;
            box-shadow: 0 4px 15px rgba(229, 9, 20, 0.4);
            z-index: 2500;
            opacity: 0;
            visibility: hidden;
            transition: all 0.3s ease;
        }

        .back-to-top.show {
            opacity: 1;
            visibility: visible;
        }

        .back-to-top:hover {
            transform: translateY(-5px);
            background-color: #ff0f1a;
        }

        @media (max-width: 600px) {
            .requests-grid {
                grid-template-columns: 1fr;
            }

            .header-fixed {
                padding: 0 1rem;
            }
        }
    </style>
</head>

<body>
    <header class="header-fixed">
        <div class="logo">
            <h2 style="color: var(--accent-red);">IMPERIO <span style="color: white;">APPS</span></h2>
        </div>
        <div class="user-info" style="display: flex; align-items: center; gap: 20px;">
            <a href="/admin/whatsapp" id="waStatusBtn" class="whatsapp-status-btn wa-off"
                style="text-decoration: none;">
                <i class="fab fa-whatsapp"></i> <span>OFFLINE</span>
            </a>
            <a href="/admin/botbot" id="bbStatusBtn" class="whatsapp-status-btn wa-off" style="text-decoration: none;">
                <i class="fas fa-robot"></i> <span>BOTBOT</span>
            </a>
            <a href="/admin/logout"
                style="color: var(--text-muted); text-decoration: none; font-size: 0.85rem; font-weight: 600;">
                <i class="fas fa-sign-out-alt"></i> Sair do Painel
            </a>
        </div>
    </header>

    <nav class="tabs">
        <a onclick="filterCategory('all')" id="tab-all" class="tab active">TODOS</a>
        <a onclick="filterCategory('series')" id="tab-series" class="tab">SÉRIES</a>
        <a onclick="filterCategory('movie')" id="tab-movie" class="tab">FILMES</a>
        <a onclick="filterCategory('error')" id="tab-error" class="tab">ERROS REPORTADOS</a>
        <a href="/admin/resellers" class="tab">GESTÃO DE REVENDAS</a>
    </nav>

    <div class="stats-summary">
        <div onclick="filterStatus('all')" id="stat-all" class="stat-pill active">📋 TODOS</div>
        <div onclick="filterStatus('pending')" id="stat-pending" class="stat-pill">📊 PENDENTES: <strong>
                <%= stats.pending %>
            </strong></div>
        <div onclick="filterStatus('approved')" id="stat-approved" class="stat-pill">✅ APROVADOS: <strong>
                <%= stats.approved %>
            </strong></div>
        <div onclick="filterStatus('rejected')" id="stat-rejected" class="stat-pill">❌ REJEITADOS: <strong>
                <%= stats.rejected %>
            </strong></div>
    </div>

    <!-- Barra de Busca e Ordenação -->
    <div class="toolbar">
        <input type="text" id="searchInput" placeholder="Buscar por título do pedido ou nome da revenda..."
            onkeyup="applyFilters()">
        <select id="sortSelect" onchange="sortCards()">
            <option value="newest">Mais Recentes (Data de Pedido)</option>
            <option value="oldest">Mais Antigos (Data de Pedido)</option>
            <option value="yearDesc">Ano de Lançamento (Novo - Antigo)</option>
            <option value="yearAsc">Ano de Lançamento (Antigo - Novo)</option>
            <option value="resellerAsc">Revendedor (A - Z)</option>
            <option value="resellerDesc">Revendedor (Z - A)</option>
        </select>
    </div>

    <main class="requests-grid">
        <% requests.forEach(req=> { %>
            <article class="request-card" id="card-<%= req.id %>" data-id="<%= req.id %>"
                data-category="<%= req.requestType === 'error' ? 'error' : req.type %>" data-status="<%= req.status %>"
                data-title="<%= (req.title || '').toLowerCase() %>"
                data-reseller="<%= (req.reseller || '').toLowerCase() %>" data-year="<%= req.year || 0 %>">

                <% let allReqs=[req]; if (req.subRequests) allReqs=allReqs.concat(req.subRequests); let
                    countDub=allReqs.filter(r=> r.audioPreference === 'Dublado' && r.requestType !== 'error').length;
                    let countLeg = allReqs.filter(r => r.audioPreference === 'Legendado' && r.requestType !==
                    'error').length;
                    let countErr = allReqs.filter(r => r.requestType === 'error').length;
                    let countPending = allReqs.filter(r => r.status === 'pending').length;
                    %>
                    <div class="poster-container">
                        <img src="<%= req.poster || 'https://via.placeholder.com/500x750?text=Sem+Poster' %>"
                            class="poster-img" alt="Poster">
                        <span class="badge-status status-<%= req.status %>">
                            <%= req.status==='pending' ? 'Pendente' : (req.status==='approved' ? 'Aprovado'
                                : 'Rejeitado' ) %>
                        </span>
                                <% if (allReqs.length> 1) { %>
                                    <div class="badge-grouped"
                                        style="position: absolute; top: 15px; left: 15px; background: rgba(59, 130, 246, 0.9); color: white; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 800; z-index: 10; border: 1px solid #3b82f6;">
                                        <i class="fas fa-layer-group"></i>
                                        <%= allReqs.length %> AGRUPADOS
                                            <% if (countPending> 0) { %><span
                                                    style="background: #ef4444; border-radius: 50%; padding: 2px 5px; margin-left: 5px;">
                                                    <%= countPending %>
                                                </span>
                                                <% } %>
                                    </div>
                                    <% } %>

                                        <div
                                            style="position: absolute; bottom: 10px; left: 10px; display: flex; flex-direction: column; gap: 5px; z-index: 10;">
                                            <% if (countDub> 0) { %><span
                                                    style="background: rgba(16, 185, 129, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #10b981;"><i
                                                        class="fas fa-microphone"></i>
                                                    <%= countDub %> DUB
                                                </span>
                                                <% } %>
                                                    <% if (countLeg> 0) { %><span
                                                            style="background: rgba(245, 158, 11, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #f59e0b;"><i
                                                                class="fas fa-closed-captioning"></i>
                                                            <%= countLeg %> LEG
                                                        </span>
                                                        <% } %>
                                                            <% if (countErr> 0) { %><span
                                                                    style="background: rgba(239, 68, 68, 0.95); color: white; padding: 3px 6px; border-radius: 4px; font-size: 10px; font-weight: bold; border: 1px solid #ef4444;"><i
                                                                        class="fas fa-exclamation-triangle"></i>
                                                                    <%= countErr %> ERRO
                                                                </span>
                                                                <% } %>
                                        </div>
                    </div>

                    <div class="card-body">
                        <h4 class="card-title" title="<%= req.title %>">
                            <%= req.title %>
                        </h4>
                        <div class="info-item"><i class="fas fa-calendar-day"></i> Lançamento: <%= req.year || 'N/A' %>
                        </div>
                        <div class="info-item"><i class="fas fa-tag"></i>
                            <%= req.action %>
                        </div>
                        <% if(req.season) { %>
                            <div class="info-item"><i class="fas fa-list-ol"></i> T<%= req.season %> | E<%= req.episode
                                        || 'Full' %>
                            </div>
                            <% } %>

                                <% if(req.audioPreference) { %>
                                    <div class="info-item"><i class="fas fa-volume-up"></i> Áudio: <strong>
                                            <%= req.audioPreference %>
                                        </strong></div>
                                    <% } %>

                                        <div class="info-item"><i class="fas fa-user-tag"></i>
                                            <%= req.reseller %>
                                        </div>
                                        <div class="info-item" style="color: var(--status-approved);">
                                            <i class="fab fa-whatsapp"></i>
                                            <%= req.whatsapp %>
                                        </div>
                                        <% if(req.rejectionReason) { %>
                                            <div class="info-item" style="color: <%= req.status === 'pending' ? '#f59e0b' : '#ef4444' %>; font-size: 0.8rem; background: <%= req.status === 'pending' ? 'rgba(245, 158, 11, 0.05)' : 'rgba(239, 68, 68, 0.05)' %>; padding: 6px 10px; border-radius: 6px; margin-top: 8px; border-left: 3px solid <%= req.status === 'pending' ? '#f59e0b' : '#ef4444' %>; white-space: pre-wrap; width: 100%; display: block; font-weight: normal;">
                                                <i class="fas <%= req.status === 'pending' ? 'fa-comment-dots' : 'fa-exclamation-circle' %>" style="margin-right: 5px;"></i><strong><%= req.status === 'pending' ? 'Nota p/ Revendedor:' : 'Motivo da Rejeição:' %></strong><br><span style="color: #e2e8f0;"><%= req.rejectionReason %></span>
                                            </div>
                                            <% } %>
                                                <% 
                                                    let hasChatHistory = req.description && (req.description.includes('[Rejeitado pelo Admin') || req.description.includes('[Resposta do Revendedor')); 
                                                    let replyCount = 0;
                                                    if (req.description) {
                                                        replyCount = (req.description.match(/\[Resposta do Revendedor/g) || []).length;
                                                    }
                                                %>
                                                <% if (req.description && !hasChatHistory) { %>
                                                    <div class="info-item" style="color: #3b82f6; font-size: 0.8rem; background: rgba(59, 130, 246, 0.05); padding: 6px 10px; border-radius: 6px; margin-top: 8px; border-left: 3px solid #3b82f6; white-space: pre-wrap; width: 100%; display: block; font-weight: normal;">
                                                        <i class="fas fa-comment-dots" style="margin-right: 5px;"></i><strong>Observação/Erro do Revendedor:</strong><br><span style="color: #e2e8f0;"><%= req.description %></span>
                                                    </div>
                                                <% } %>
                                                <div class="info-item"><i class="far fa-calendar-alt"></i>
                                                    <%= req.date %>
                                                </div>
                                                <% if (replyCount > 0) { %>
                                                    <div class="info-item" style="color: <%= replyCount >= 2 ? '#ef4444' : '#f59e0b' %>; font-weight: bold; margin-top: 4px;">
                                                        <i class="fas fa-history"></i> Contestações: <%= replyCount %>/2 <%= replyCount >= 2 ? '(Limite Atingido)' : '' %>
                                                    </div>
                                                <% } %>
                    </div>

                    <div class="card-actions">
                        <% if (hasChatHistory) { %>
                            <button class="btn"
                                style="background: rgba(37, 99, 235, 0.15); border: 1px solid #2563eb; color: #3b82f6; margin-bottom: 8px; width: 100%; display: flex; align-items: center; justify-content: center; gap: 8px;"
                                onclick="openChatModal('<%= encodeURIComponent(req.title) %>', '<%= encodeURIComponent(req.description) %>')">
                                <i class="fas fa-comments"></i> Conversa / Histórico
                            </button>
                        <% } %>
                        <div style="display: flex; gap: 5px; margin-bottom: 5px;">
                            <button class="btn btn-tmdb"
                                onclick="window.open('https://www.themoviedb.org/search?query=<%= encodeURIComponent(req.title) %>', '_blank')">
                                <i class="fas fa-search"></i> TMDB
                            </button>
                            <button class="btn btn-justwatch"
                                onclick="window.open('https://www.justwatch.com/br/busca?q=<%= encodeURIComponent(req.title) %>', '_blank')">
                                <i class="fas fa-play"></i> JW
                            </button>
                        </div>
                        <% if (allReqs.length> 1) { %>
                            <button class="btn"
                                style="background: #3b82f6; color: white; margin-bottom: 5px; width: 100%;"
                                data-details="<%= encodeURIComponent(JSON.stringify([req, ...req.subRequests])) %>"
                                onclick="openDetailsModal(this.dataset.details)">
                                <i class="fas fa-list"></i> Histórico / Resolver
                            </button>
                            <% } %>
                                <% if (req.status==='pending' ) { %>
                                    <div class="btn-group" id="btnGroup-<%= req.id %>"
                                        style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%;">
                                        <button class="btn btn-approve"
                                            onclick="updateStatus(<%= req.id %>, 'approved', null, true)">
                                            <%= allReqs.length> 1 ? 'Aprovar Todos' : 'Aprovar' %>
                                        </button>
                                        <button class="btn btn-reject"
                                            onclick="openRejectModal(<%= req.id %>, '<%= req.type %>', true)">
                                            <%= allReqs.length> 1 ? 'Rejeitar Todos' : 'Rejeitar' %>
                                        </button>
                                    </div>
                                    <% } else { %>
                                        <button class="btn"
                                            style="background: var(--bg-main); border: 1px solid var(--border); color: var(--text-primary); width: 100%;"
                                            onclick="openOptionsModal(<%= req.id %>, '<%= req.type %>', '<%= req.status %>', '<%= encodeURIComponent(req.title) %>', '<%= encodeURIComponent(req.reseller) %>', true)">
                                            <i class="fas fa-cog"></i> Opções do Pedido
                                        </button>
                                        <% } %>
                    </div>
            </article>
            <% }); %>
    </main>

    <!-- Modal de Rejeição -->
    <div id="rejectModal" class="modal-overlay">
        <div class="modal-content">
            <h3 class="modal-header">MOTIVO DA REJEIÇÃO DO PEDIDO</h3>
            <div class="quick-buttons">
                <button class="btn-quick" onclick="setReason('REPETIDO')">REPETIDO</button>
                <button class="btn-quick" onclick="setReason('ANTIGO')">ANTIGO</button>
                <button class="btn-quick" onclick="setReason('INDISPONIVEL')">INDISPONÍVEL</button>
                <button class="btn-quick" onclick="setReason('ERRO')">ERRO</button>
                <button class="btn-quick" onclick="setReason('JACONSTA')">JÁ CONSTA</button>
                <button class="btn-quick" onclick="setReason('EXTERNO')">EXTERNO</button>
                <button class="btn-quick" onclick="setReason('RECENTE')">RECENTE</button>
            </div>
            <textarea id="rejectionText" rows="15" placeholder="Ou digite um motivo personalizado..."></textarea>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;"
                    onclick="closeRejectModal()">CANCELAR</button>
                <button class="btn btn-reject" style="background: var(--status-rejected); color: #fff;"
                    id="confirmRejectBtn">CONFIRMAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Detalhes Agrupados -->
    <div id="detailsModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 700px;">
            <h3 class="modal-header">📦 Detalhes dos Pedidos Agrupados</h3>
            <div
                style="max-height: 400px; overflow-y: auto; background: #000; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 1.5rem;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem;">
                    <thead style="background: #111; position: sticky; top: 0;">
                        <tr>
                            <th style="padding: 10px; color: var(--text-muted);">Revendedor</th>
                            <th style="padding: 10px; color: var(--text-muted);">Ação</th>
                            <th style="padding: 10px; color: var(--text-muted);">Detalhes (Temp/Ep/Erro)</th>
                            <th style="padding: 10px; color: var(--text-muted);">Data</th>
                            <th style="padding: 10px; color: var(--text-muted); text-align: center;">Ações</th>
                        </tr>
                    </thead>
                    <tbody id="detailsTableBody">
                    </tbody>
                </table>
            </div>
            <div class="modal-footer">
                <button class="btn" style="background: #333; color: #fff;" onclick="closeDetailsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Opções Unificado -->
    <div id="optionsModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 450px;">
            <h3 class="modal-header" id="optionsModalHeader" style="display: flex; align-items: center; gap: 10px;"><i
                    class="fas fa-cog"></i> Opções do Pedido</h3>

            <div
                style="background: #0d0d0d; border: 1px solid var(--border); padding: 15px; border-radius: 8px; margin-bottom: 1.5rem;">
                <p style="font-size: 0.95rem; margin-bottom: 8px;"><strong>Título:</strong> <span id="optionsModalTitle"
                        style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; margin-bottom: 8px;"><strong>Revenda:</strong> <span
                        id="optionsModalReseller" style="color: #fff;"></span></p>
                <p style="font-size: 0.95rem; display: flex; align-items: center; gap: 10px;">
                    <strong>Status:</strong>
                    <span id="optionsModalStatusBadge" class="badge-status"
                        style="position: static; padding: 4px 8px; font-size: 0.7rem;"></span>
                </p>
            </div>

            <div style="display: flex; flex-direction: column; gap: 10px;">
                <button id="optionsBtnApprove" class="btn btn-approve"
                    style="width: 100%; padding: 12px; font-size: 0.85rem;" onclick="handleOptionsApprove()">
                    <i class="fas fa-check"></i> Aprovar Pedido
                </button>
                <button id="optionsBtnReject" class="btn btn-reject"
                    style="width: 100%; padding: 12px; font-size: 0.85rem;" onclick="handleOptionsReject()">
                    <i class="fas fa-times"></i> Rejeitar Pedido
                </button>
                <button id="optionsBtnPending" class="btn"
                    style="background: transparent; border: 1px solid var(--status-pending); color: var(--status-pending); width: 100%; padding: 12px; font-size: 0.85rem;"
                    onclick="handleOptionsPending()">
                    <i class="fas fa-undo"></i> Retornar para Pendente
                </button>
                <button id="optionsBtnAddNote" class="btn"
                    style="background: transparent; border: 1px solid #f59e0b; color: #f59e0b; width: 100%; padding: 12px; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 8px;"
                    onclick="handleOptionsAddNote()">
                    <i class="fas fa-comment-dots"></i> Pedir Explicação / Add Nota
                </button>
                <button id="optionsBtnDelete" class="btn"
                    style="background: rgba(220, 38, 38, 0.15); border: 1px solid #dc2626; color: #f87171; width: 100%; padding: 12px; font-size: 0.85rem; transition: 0.3s;"
                    onmouseover="this.style.backgroundColor='#dc2626'; this.style.color='white';"
                    onmouseout="this.style.backgroundColor='rgba(220, 38, 38, 0.15)'; this.style.color='#f87171';"
                    onclick="handleOptionsDelete()">
                    <i class="fas fa-trash-alt"></i> Excluir Pedido
                </button>
            </div>

            <div class="modal-footer" style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeOptionsModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <!-- Modal de Histórico de Conversa (Chat) -->
    <div id="chatModal" class="modal-overlay" style="z-index: 1100;">
        <div class="modal-content"
            style="max-width: 500px; background: #0d0d0d; border: 1px solid #222; box-shadow: 0 10px 25px rgba(0,0,0,0.8);">
            <h3 class="modal-header"
                style="display: flex; align-items: center; gap: 10px; border-bottom: 1px solid #222; padding-bottom: 15px;">
                <i class="fas fa-comments" style="color: #3b82f6;"></i> Histórico de Conversa</h3>

            <p style="font-size: 0.95rem; margin-bottom: 15px; color: #aaa;"><strong>Pedido:</strong> <span
                    id="chatModalTitle" style="color: #fff; font-weight: bold;"></span></p>

            <div id="chatMessagesContainer"
                style="max-height: 300px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding: 10px; background: #050505; border-radius: 8px; border: 1px solid #1a1a1a;">
                <!-- Mensagens injetadas dinamicamente -->
            </div>

            <div class="modal-footer"
                style="margin-top: 1.5rem; border-top: 1px solid #222; padding-top: 15px; display: flex; justify-content: flex-end;">
                <button class="btn" style="background: #333; color: #fff; padding: 10px 20px;"
                    onclick="closeChatModal()">FECHAR</button>
            </div>
        </div>
    </div>

    <button id="backToTop" class="back-to-top" title="Voltar ao topo">
        <i class="fas fa-chevron-up"></i>
    </button>

    <script>
        let currentRequestId = null;
        let currentRequestType = null; // Para armazenar o tipo (movie/series)
        let currentSyncAll = true;
        let activeCategory = 'all';
        let activeStatus = 'all';
        let checkStatusInterval = null;

        async function checkWaStatus() {
            try {
                const res = await fetch('/api/whatsapp/status');
                const data = await res.json();
                const btn = document.getElementById('waStatusBtn');
                const btnText = btn.querySelector('span');

                btn.className = 'whatsapp-status-btn ' + (data.status === 'ready' ? 'wa-on' : (data.status === 'qr' ? 'wa-qr' : 'wa-off'));
                btnText.innerText = 'WA LOCAL ' + data.status.toUpperCase();

                const resBb = await fetch('/api/botbot/status');
                const dataBb = await resBb.json();
                const bbBtn = document.getElementById('bbStatusBtn');
                const bbBtnText = bbBtn.querySelector('span');
                bbBtn.className = 'whatsapp-status-btn ' + (dataBb.status === 'ready' ? 'wa-on' : 'wa-off');
                bbBtnText.innerText = 'BOTBOT ' + dataBb.status.toUpperCase();
            } catch (e) {
                console.error("Erro ao verificar status das APIs:", e);
            }
        }

        setInterval(checkWaStatus, 5000); // Atualiza status a cada 5 segundos

        function applyFilters() {
            const searchQuery = document.getElementById('searchInput').value.toLowerCase().trim();

            document.querySelectorAll('.request-card').forEach(card => {
                const categoryMatch = activeCategory === 'all' || card.dataset.category === activeCategory;
                const statusMatch = activeStatus === 'all' || card.dataset.status === activeStatus;

                const titleMatch = card.dataset.title.includes(searchQuery);
                const resellerMatch = card.dataset.reseller.includes(searchQuery);
                const searchMatch = !searchQuery || titleMatch || resellerMatch;

                if (categoryMatch && statusMatch && searchMatch) {
                    card.classList.remove('hidden');
                } else {
                    card.classList.add('hidden');
                }
            });
        }

        function sortCards() {
            const grid = document.querySelector('.requests-grid');
            const cards = Array.from(grid.querySelectorAll('.request-card'));
            const sortType = document.getElementById('sortSelect').value;

            const getYear = (dateStr) => {
                if (!dateStr || dateStr === '0') return 0;
                const parts = dateStr.split('/');
                return parts.length === 3 ? parseInt(parts[2]) : parseInt(dateStr) || 0;
            };

            cards.sort((a, b) => {
                if (sortType === 'newest') return parseInt(b.dataset.id) - parseInt(a.dataset.id);
                if (sortType === 'oldest') return parseInt(a.dataset.id) - parseInt(b.dataset.id);
                if (sortType === 'yearDesc') return getYear(b.dataset.year) - getYear(a.dataset.year);
                if (sortType === 'yearAsc') return getYear(a.dataset.year) - getYear(b.dataset.year);
                if (sortType === 'resellerAsc') return a.dataset.reseller.localeCompare(b.dataset.reseller);
                if (sortType === 'resellerDesc') return b.dataset.reseller.localeCompare(a.dataset.reseller);
            });

            // Re-anexa os cards na nova ordem (o navegador move os elementos automaticamente)
            cards.forEach(card => grid.appendChild(card));
        }

        function filterCategory(category) {
            activeCategory = category;
            document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
            document.getElementById(`tab-${category}`).classList.add('active');
            applyFilters();
        }

        function filterStatus(status) {
            activeStatus = status;
            document.querySelectorAll('.stat-pill').forEach(p => p.classList.remove('active'));
            document.getElementById(`stat-${status}`).classList.add('active');
            applyFilters();
        }

        async function refreshStats() {
            try {
                const res = await fetch('/api/stats');
                const stats = await res.json();
                document.querySelector('#stat-pending strong').innerText = stats.pending;
                document.querySelector('#stat-approved strong').innerText = stats.approved;
                document.querySelector('#stat-rejected strong').innerText = stats.rejected;
            } catch (error) {
                console.error('Erro ao atualizar estatísticas:', error);
            }
        }

        function openRejectModal(id, type, syncAll = true) {
            currentRequestId = id;
            currentRequestType = type;
            currentSyncAll = syncAll;
            document.getElementById('rejectModal').style.display = 'flex';
            document.getElementById('rejectionText').value = '';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
            currentRequestId = null;
            currentRequestType = null;
        }

        function openDetailsModal(encodedData) {
            const data = JSON.parse(decodeURIComponent(encodedData));
            const tbody = document.getElementById('detailsTableBody');
            tbody.innerHTML = '';

            data.forEach(req => {
                let extraInfo = '';
                if (req.season) extraInfo += `T${req.season} `;
                if (req.episode) extraInfo += `E${req.episode} `;
                if (req.audioPreference && req.requestType !== 'error') extraInfo += `🎤 ${req.audioPreference} `;
                if (req.description) extraInfo += `<br><span style="color: #bbb; font-size: 0.8rem;"><i class="far fa-comment-dots"></i> ${req.description}</span>`;
                else if (req.requestType === 'error') extraInfo += `<br>⚠️ Erro reportado`;

                let actionsHtml = `
                    <div style="display: flex; gap: 8px; align-items: center; justify-content: center;">
                        <span class="badge-status status-${req.status}" style="position: static; padding: 4px 6px; font-size: 0.65rem;">${req.status === 'pending' ? 'Pendente' : (req.status === 'approved' ? 'Aprovado' : 'Rejeitado')}</span>
                        ${(req.description && req.description.includes('[Resposta do Revendedor')) ? `
                        <button class="btn" style="background: #2563eb; color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 0.7rem; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center;" 
                                onclick="openChatModal('${encodeURIComponent(req.title)}', '${encodeURIComponent(req.description)}')">
                            <i class="fas fa-comment-dots"></i>
                        </button>
                        ` : ''}
                        <button class="btn" style="background: #222; border: 1px solid #444; color: #fff; padding: 6px 10px; border-radius: 6px; font-size: 0.7rem;" 
                                onclick="openOptionsModal(${req.id}, '${req.type}', '${req.status}', '${encodeURIComponent(req.title)}', '${encodeURIComponent(req.reseller)}', false)">
                            <i class="fas fa-cog"></i>
                        </button>
                    </div>
                `;

                tbody.innerHTML += `
                    <tr>
                        <td style="padding: 10px; border-bottom: 1px solid #333; color: #fff;">${req.reseller}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #333; color: #fff;">${req.action}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #333; color: var(--text-muted);">${extraInfo || '-'}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #333; color: var(--text-muted);">${req.date} ${req.time}</td>
                        <td style="padding: 10px; border-bottom: 1px solid #333; display: flex; gap: 12px; justify-content: center; align-items: center;">${actionsHtml}</td>
                    </tr>
                `;
            });

            document.getElementById('detailsModal').style.display = 'flex';
        }

        function closeDetailsModal() {
            document.getElementById('detailsModal').style.display = 'none';
        }

        function setReason(textKey) {
            let reasonText = '';
            switch (textKey) {
                case 'REPETIDO':
                    reasonText = 'Pedido Repetido.\n\nFavor não repetir os pedidos para não congestionar a fila.';
                    break;
                case 'ANTIGO':
                    if (currentRequestType === 'movie') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, FILMES produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nFilmes anteriores a 1980 serão rejeitados.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else if (currentRequestType === 'series') {
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, SÉRIES produzidas antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nSéries muito antigas serão rejeitadas.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    } else { // Default para tipo genérico ou não especificado
                        reasonText = `Informamos que, por critérios de qualidade técnica e de padronização do acervo, CONTEÚDOS produzidos antes do ano de 2000 têm baixíssima ou zero prioridade na fila de adição.\n\nEssa medida se faz necessária devido a limitações relacionadas à disponibilidade da mídia, resolução de imagem, formatos e compatibilidade com os padrões atuais de reprodução, garantindo assim uma melhor experiência ao público.\n\nAgradecemos a compreensão.`;
                    }
                    break;
                case 'INDISPONIVEL':
                    reasonText = 'Conteúdo Indisponível dublado ou legendado.';
                    break;
                case 'ERRO':
                    reasonText = `Poderia fornecer detalhes adicionais sobre o erro?\n\nPreciso identificar a obra (filme ou série), o número do episódio e o momento exato da falha.\n\nPor exemplo: 'No filme X ou no episódio Y da 1ª temporada, ocorre um erro a partir dos 10:30'.\n\nAlém disso, descreva o que aparece na tela (código de erro, travamento ou tela preta).`;
                    break;
                case 'JACONSTA':
                    reasonText = 'Já Consta no Servidor.\n\nFavor pesquisar nas categorias All ou todos em nas categorias individuais antes de solicitar os conteúdos.';
                    break;
                case 'EXTERNO':
                    reasonText = `Erro de reprodução normalmente é codec do aplicativo em versões muito antigas.\n\nComo Configurar o VLC PLAYER EXTERNO:\n\nVá para Configurações do aplicativo (Settings) onde tem um simbolo de engrenagem.\n\nProcure por "Player" ou "Player Padrão", "Jogador externo" ou "Leitor externo".\n\nSelecione "VLC" ou "Player Externo".\n\nSalve as configurações.\n\nQuando abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.\n\nMarque "Sempre" para definir como padrão.\n\nSe não tiver instalado o VLC a playstore vai se abrir.\n\nInstale o VLC Media Player da Play Store.\n\nTente abrir um canal ou filme ou serie, escolha "VLC" na lista de apps.`;
                    break;
                case 'RECENTE':
                    reasonText = 'Filme lançado recentemente no Cinema.\n\nSomente disponível em 1080 FullHD depois de 3 a 5 meses ao sair nos Streamings.\n\nFavor aguardar, o conteúdo será atualizado automaticamente.';
                    break;
                default:
                    reasonText = '';
            }
            document.getElementById('rejectionText').value = reasonText;
        }

        document.getElementById('confirmRejectBtn').onclick = () => {
            const reason = document.getElementById('rejectionText').value;
            if (!reason) return alert('Por favor, informe um motivo.');
            updateStatus(currentRequestId, 'rejected', reason, currentSyncAll);
            closeRejectModal();
        };

        async function updateStatus(id, status, reason = null, syncAll = true) {
            if (!reason && !confirm(`Deseja realmente alterar o status para ${status.toUpperCase()}?`)) return;

            try {
                const response = await fetch(`/api/requests/${id}/status`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status, rejectionReason: reason, syncAll })
                });

                if (response.ok) {
                    if (syncAll) {
                        const card = document.getElementById(`card-${id}`);
                        if (card) {
                            card.dataset.status = status;
                            const badge = card.querySelector('.badge-status');
                            badge.className = `badge-status status-${status}`;
                            badge.innerText = status === 'pending' ? 'Pendente' : (status === 'approved' ? 'Aprovado' : 'Rejeitado');

                            if (status === 'rejected' && reason) {
                                const body = card.querySelector('.card-body');
                                let reasonDiv = body.querySelector('.rejection-info');
                                if (!reasonDiv) {
                                    reasonDiv = document.createElement('div');
                                    reasonDiv.className = 'info-item rejection-info';
                                    reasonDiv.style = 'color: var(--status-rejected); font-weight: bold; margin-top: 5px; display: flex; align-items: flex-start; gap: 10px; white-space: pre-wrap;';
                                    body.appendChild(reasonDiv);
                                }
                                reasonDiv.innerHTML = `<i class="fas fa-exclamation-circle" style="margin-top: 4px;"></i><span>${reason}</span>`;
                            }

                            const btnGroup = document.getElementById(`btnGroup-${id}`);
                            if (btnGroup) btnGroup.remove();
                        }
                        await refreshStats();
                        applyFilters();
                    } else {
                        // Ação Individual Granular: Para garantir a sincronia e recriar os grupos e botões
                        // perfeitamente como o Admin espera, damos refresh sutil na página.
                        location.reload();
                    }
                } else {
                    alert('Erro ao atualizar status.');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Falha na comunicação com o servidor.');
            }
        }

        async function deleteRequest(id, syncAll = true) {
            if (!confirm(syncAll ? 'Deseja realmente excluir este pedido e todos os seus agrupados permanentemente?' : 'Deseja realmente excluir este pedido individual permanentemente?')) return;

            try {
                let idsToDelete = [id];
                if (syncAll) {
                    const card = document.getElementById(`card-${id}`);
                    if (card) {
                        const detailsBtn = card.querySelector('[data-details]');
                        if (detailsBtn) {
                            const data = JSON.parse(decodeURIComponent(detailsBtn.dataset.details));
                            idsToDelete = data.map(r => r.id);
                        }
                    }
                }

                let successCount = 0;
                for (const deleteId of idsToDelete) {
                    const response = await fetch(`/api/requests/${deleteId}`, {
                        method: 'DELETE'
                    });
                    if (response.ok) {
                        successCount++;
                    }
                }

                if (successCount > 0) {
                    alert('Pedido(s) excluído(s) com sucesso!');
                    location.reload();
                } else {
                    alert('Erro ao excluir pedido(s).');
                }
            } catch (error) {
                console.error('Erro:', error);
                alert('Falha na comunicação com o servidor.');
            }
        }

        let optionsRequestId = null;
        let optionsRequestType = null;
        let optionsRequestStatus = null;
        let optionsSyncAll = true;

        function openOptionsModal(id, type, status, title, reseller, syncAll = true) {
            optionsRequestId = id;
            optionsRequestType = type;
            optionsRequestStatus = status;
            optionsSyncAll = syncAll;

            // Set content details
            document.getElementById('optionsModalTitle').innerText = decodeURIComponent(title);
            document.getElementById('optionsModalReseller').innerText = decodeURIComponent(reseller);

            // Configure status badge
            const badge = document.getElementById('optionsModalStatusBadge');
            badge.className = `badge-status status-${status}`;
            badge.innerText = status === 'pending' ? 'Pendente' : (status === 'approved' ? 'Aprovado' : 'Rejeitado');

            // Configure actions visibility
            document.getElementById('optionsBtnApprove').style.display = status === 'approved' ? 'none' : 'flex';
            document.getElementById('optionsBtnReject').style.display = status === 'rejected' ? 'none' : 'flex';
            document.getElementById('optionsBtnPending').style.display = status === 'pending' ? 'none' : 'flex';
            document.getElementById('optionsBtnAddNote').style.display = status === 'pending' ? 'flex' : 'none';

            // Delete button text
            const deleteBtn = document.getElementById('optionsBtnDelete');
            deleteBtn.innerHTML = syncAll ? '<i class="fas fa-trash-alt"></i> Excluir Pedido e Agrupados' : '<i class="fas fa-trash-alt"></i> Excluir Pedido';

            document.getElementById('optionsModal').style.display = 'flex';
        }

        function closeOptionsModal() {
            document.getElementById('optionsModal').style.display = 'none';
        }

        function openChatModal(title, encodedDescription) {
            const description = decodeURIComponent(encodedDescription);
            document.getElementById('chatModalTitle').innerText = decodeURIComponent(title);

            const container = document.getElementById('chatMessagesContainer');
            container.innerHTML = '';

            // Separar as mensagens por bloco de resposta
            const blocks = description.split(/(?=\[Rejeitado pelo Admin|\[Resposta do Revendedor)/g);

            blocks.forEach(block => {
                const trimmed = block.trim();
                if (!trimmed) return;

                let isReseller = trimmed.startsWith('[Resposta do Revendedor');
                let isRejection = trimmed.startsWith('[Rejeitado pelo Admin');

                let bubbleStyle = '';
                let headerText = '';
                let contentText = '';

                if (isReseller) {
                    bubbleStyle = 'background: rgba(37, 99, 235, 0.15); border-left: 3px solid #2563eb; color: #e2e8f0; align-self: flex-end; width: 90%;';
                    const match = trimmed.match(/\[Resposta do Revendedor em ([^\]]+)\]:\s*([\s\S]*)/);
                    if (match) {
                        headerText = `👤 Revendedor (${match[1]})`;
                        contentText = match[2];
                    } else {
                        headerText = `👤 Resposta do Revendedor`;
                        contentText = trimmed;
                    }
                } else if (isRejection) {
                    bubbleStyle = 'background: rgba(239, 68, 68, 0.15); border-left: 3px solid #ef4444; color: #e2e8f0; align-self: flex-start; width: 90%;';
                    const match = trimmed.match(/\[Rejeitado pelo Admin - Motivo: ([^\]]+)\]\s*([\s\S]*)/);
                    if (match) {
                        headerText = `🚨 Rejeição - Motivo: ${match[1]}`;
                        contentText = match[2] || 'Sem detalhes adicionais.';
                    } else {
                        headerText = `🚨 Rejeitado pelo Admin`;
                        contentText = trimmed;
                    }
                } else {
                    bubbleStyle = 'background: rgba(255, 255, 255, 0.05); border-left: 3px solid #555; color: #ccc; align-self: flex-start; width: 90%;';
                    headerText = `📝 Observações do Pedido`;
                    contentText = trimmed;
                }

                container.innerHTML += `
                    <div style="padding: 10px 12px; border-radius: 8px; font-size: 0.85rem; word-break: break-word; line-height: 1.4; display: flex; flex-direction: column; gap: 4px; box-shadow: 0 2px 5px rgba(0,0,0,0.2); ${bubbleStyle}">
                        <div style="font-weight: bold; font-size: 0.75rem; color: #fff; opacity: 0.9; margin-bottom: 2px;">${headerText}</div>
                        <div style="white-space: pre-wrap;">${contentText}</div>
                    </div>
                `;
            });

            if (container.innerHTML === '') {
                container.innerHTML = '<div style="color: #666; text-align: center; font-size: 0.85rem; padding: 20px;">Nenhuma mensagem registrada.</div>';
            }

            document.getElementById('chatModal').style.display = 'flex';
        }

        function closeChatModal() {
            document.getElementById('chatModal').style.display = 'none';
        }

        function handleOptionsApprove() {
            closeOptionsModal();
            updateStatus(optionsRequestId, 'approved', null, optionsSyncAll);
        }

        function handleOptionsReject() {
            closeOptionsModal();
            openRejectModal(optionsRequestId, optionsRequestType, optionsSyncAll);
        }

        function handleOptionsPending() {
            closeOptionsModal();
            const note = prompt("Deseja deixar uma pergunta ou observação para o revendedor? (Deixe em branco para apenas retornar para Pendente):");
            if (note === null) return; // cancelou
            updateStatus(optionsRequestId, 'pending', note || null, optionsSyncAll);
        }

        function handleOptionsAddNote() {
            closeOptionsModal();
            const note = prompt("Digite a sua pergunta ou observação para o revendedor (ex: 'Me explica o erro reportado' ou 'Qual o problema com o áudio?'):");
            if (!note || note.trim() === '') return;
            updateStatus(optionsRequestId, 'pending', note, optionsSyncAll);
        }

        function handleOptionsDelete() {
            closeOptionsModal();
            deleteRequest(optionsRequestId, optionsSyncAll);
        }

        // Lógica do Botão Voltar ao Topo
        const backToTopBtn = document.getElementById('backToTop');

        window.addEventListener('scroll', () => {
            if (window.pageYOffset > 300) {
                backToTopBtn.classList.add('show');
            } else {
                backToTopBtn.classList.remove('show');
            }
        });

        backToTopBtn.addEventListener('click', () => {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        });
    </script>
</body>

</html>