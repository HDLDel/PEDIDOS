<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conectar WhatsApp - VOD Premium</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script>
        (function() {
            try {
                const theme = localStorage.getItem('theme');
                if (theme === 'light') {
                    document.documentElement.classList.add('light-theme');
                    document.addEventListener('DOMContentLoaded', () => {
                        document.body.classList.add('light-theme');
                    });
                }
            } catch (e) {
                console.error('Falha ao acessar o localStorage:', e);
            }
        })();
    </script>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
        }
        body { background-color: var(--bg-main); color: var(--text-primary); font-family: 'Inter', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .container { background: var(--bg-card); padding: 3rem; border-radius: 1.5rem; border: 1px solid var(--border); text-align: center; max-width: 500px; width: 90%; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
        .qr-container { background: white; padding: 15px; border-radius: 1rem; display: inline-block; margin: 2rem 0; min-width: 280px; min-height: 280px; display: flex; align-items: center; justify-content: center; }
        .qr-container img { width: 250px; height: 250px; display: block; }
        .status-badge { display: inline-block; padding: 8px 20px; border-radius: 50px; font-weight: 800; font-size: 0.9rem; margin-bottom: 1rem; text-transform: uppercase; }
        .status-disconnected { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid #ef4444; }
        .status-qr { background: rgba(245, 158, 11, 0.1); color: #f59e0b; border: 1px solid #f59e0b; }
        .status-ready { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; }
        .status-loading { background: rgba(59, 130, 246, 0.1); color: #3b82f6; border: 1px solid #3b82f6; }
        .btn-back { display: block; margin-top: 2rem; color: var(--text-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: 0.3s; }
        .btn-back:hover { color: var(--text-primary); }
        .btn-reset { background: #333; color: #fff; border: none; padding: 10px 20px; border-radius: 8px; cursor: pointer; font-weight: 700; margin-top: 1rem; transition: 0.2s; }
        .btn-reset:hover { background: #444; }
    </style>
</head>
<body>
    <div class="container">
        <div style="display: flex; justify-content: flex-end; margin-bottom: -20px; margin-top: -15px;">
            <button id="themeToggleBtn" style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s;" onclick="toggleTheme()" title="Alternar Tema">
                <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
            </button>
        </div>
        <div id="statusBadge" class="status-badge status-disconnected">Aguardando...</div>
        <h2 id="statusTitle">WhatsApp</h2>
        <p id="statusDesc" style="color: var(--text-muted); margin-top: 0.5rem; height: 3lh;">Iniciando serviço...</p>
        
        <div class="qr-container" id="qrContainer">
            <div style="color: #000; font-weight: 600;"><i class="fas fa-circle-notch fa-spin"></i> Preparando navegador...</div>
        </div>

        <div style="display: flex; gap: 10px; justify-content: center; margin-top: 1rem; flex-wrap: wrap;">
            <button class="btn-reset" onclick="resetConnection()"><i class="fas fa-sync-alt"></i> Reiniciar</button>
            <button class="btn-reset" style="background: #ef4444;" onclick="logoutConnection()"><i class="fas fa-power-off"></i> Desconectar</button>
            <button class="btn-reset" style="background: #3b82f6;" onclick="resendAllNotifications()"><i class="fas fa-paper-plane"></i> Reenviar Tudo</button>
        </div>
        <a href="/" class="btn-back"><i class="fas fa-arrow-left"></i> Voltar ao Painel</a>
    </div>

    <script>
        async function fetchStatus() {
            try {
                const res = await fetch('/api/whatsapp/status');
                const data = await res.json();
                updateUI(data);
            } catch (e) { console.error("Erro na API de status"); }
        }

        function updateUI(data) {
            const badge = document.getElementById('statusBadge');
            const title = document.getElementById('statusTitle');
            const desc = document.getElementById('statusDesc');
            const qrBox = document.getElementById('qrContainer');

            badge.className = 'status-badge status-' + data.status;
            badge.innerText = data.status.replace('_', ' ').toUpperCase();

            if (data.status === 'qr' && data.qr) {
                qrBox.innerHTML = `<img src="${data.qr}" alt="QR Code">`;
                title.innerText = "Escaneie agora";
                desc.innerText = "Abra o WhatsApp > Configurações > Dispositivos Conectados e aponte a câmera.";
            } else if (data.status === 'ready') {
                qrBox.innerHTML = `<i class="fas fa-check-circle" style="font-size: 8rem; color: #10b981;"></i>`;
                title.innerText = "Conectado!";
                desc.innerText = "Seu sistema está pronto para enviar as notificações automáticas.";
            } else if (data.status === 'loading' || data.status === 'authenticated') {
                qrBox.innerHTML = `<i class="fas fa-spinner fa-spin" style="font-size: 5rem; color: #3b82f6;"></i>`;
                title.innerText = "Autenticando...";
                desc.innerText = "Validando sessão e carregando mensagens. Por favor, aguarde.";
            } else {
                qrBox.innerHTML = `<i class="fas fa-robot" style="font-size: 5rem; color: #444;"></i>`;
                title.innerText = "Preparando...";
                desc.innerText = "O servidor está iniciando uma nova instância do navegador.";
            }
        }

        async function resetConnection() {
            if(!confirm("Deseja forçar o encerramento da sessão atual?")) return;
            document.getElementById('qrContainer').innerHTML = '<div style="color: #000;">Reiniciando...</div>';
            await fetch('/api/whatsapp/reset', { method: 'POST' });
        }

        async function logoutConnection() {
            if(!confirm("Deseja encerrar a sua sessão atual do WhatsApp?\n\nIsso removerá a conexão e você precisará ler o QR Code novamente.")) return;
            document.getElementById('qrContainer').innerHTML = '<div style="color: #000;"><i class="fas fa-spinner fa-spin"></i> Desconectando...</div>';
            await fetch('/api/whatsapp/reset', { method: 'POST' });
        }

        async function resendAllNotifications() {
            if(!confirm("Deseja reenviar a notificação dos ÚLTIMOS 50 pedidos processados? \n\nIsso rodará em segundo plano.")) return;
            try {
                const res = await fetch('/api/notifications/resend-all', { method: 'POST' });
                const data = await res.json();
                alert(data.message || 'Processo iniciado com sucesso!');
            } catch (e) { alert('Erro ao iniciar reenvio.'); }
        }

        setInterval(fetchStatus, 3000);
        fetchStatus();

        function toggleTheme() {
            const isLight = document.documentElement.classList.toggle('light-theme');
            document.body.classList.toggle('light-theme', isLight);
            try {
                localStorage.setItem('theme', isLight ? 'light' : 'dark');
            } catch (e) {
                console.error('Falha ao salvar o tema:', e);
            }
            updateThemeIcon(isLight);
        }

        function updateThemeIcon(isLight) {
            const icon = document.getElementById('themeIcon');
            if (icon) {
                if (isLight) {
                    icon.className = 'fas fa-moon';
                    icon.style.color = '#374151';
                } else {
                    icon.className = 'fas fa-sun';
                    icon.style.color = '#f59e0b';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const isLight = document.documentElement.classList.contains('light-theme');
            updateThemeIcon(isLight);
        });
    </script>
</body>
</html>