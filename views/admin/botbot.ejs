<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conectar BotBot - VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
        }
        body { background-color: var(--bg-main); color: var(--text-primary); font-family: 'Inter', sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .container { background: var(--bg-card); padding: 3rem; border-radius: 1.5rem; border: 1px solid var(--border); text-align: center; max-width: 500px; width: 90%; box-shadow: 0 20px 50px rgba(0,0,0,0.5); }
        .qr-container { background: #1a1a1a; padding: 15px; border-radius: 1rem; display: inline-block; margin: 2rem 0; min-width: 280px; min-height: 200px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--border); }
        .status-badge { display: inline-block; padding: 8px 20px; border-radius: 50px; font-weight: 800; font-size: 0.9rem; margin-bottom: 1rem; text-transform: uppercase; }
        .status-ready { background: rgba(16, 185, 129, 0.1); color: #10b981; border: 1px solid #10b981; }
        .btn-back { display: block; margin-top: 2rem; color: var(--text-muted); text-decoration: none; font-weight: 600; font-size: 0.9rem; transition: 0.3s; }
        .btn-back:hover { color: var(--text-primary); }
    </style>
</head>
<body>
    <div class="container">
        <div id="statusBadge" class="status-badge status-ready">API PRONTA</div>
        <h2 id="statusTitle">BotBot API v2</h2>
        <p id="statusDesc" style="color: var(--text-muted); margin-top: 0.5rem; height: 3lh;">Serviço em nuvem ativo como notificador principal. Não é necessário QR Code.</p>
        
        <div class="qr-container" id="qrContainer">
            <i class="fas fa-robot" style="font-size: 6rem; color: #10b981;"></i>
        </div>

        <a href="/admin/dashboard" class="btn-back"><i class="fas fa-arrow-left"></i> Voltar ao Painel</a>
    </div>

    <script>
        async function fetchStatus() {
            // Apenas para confirmar e ativar os badges no front, caso necessário
            await fetch('/api/botbot/status');
        }
        fetchStatus();
    </script>
</body>
</html>