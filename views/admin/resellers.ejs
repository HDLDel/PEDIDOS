<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Revendedores - VOD Premium</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <script>
        (function() {
            const theme = localStorage.getItem('theme');
            if (theme === 'light') {
                document.documentElement.classList.add('light-theme');
                document.addEventListener('DOMContentLoaded', () => {
                    document.body.classList.add('light-theme');
                });
            }
        })();
    </script>
    <style>
        :root {
            --bg-main: #0a0a0a;
            --bg-card: #141414;
            --accent-red: #e50914;
            --text-primary: #ffffff;
            --text-muted: #b3b3b3;
            --border: #2b2b2b;
        }
        body { background-color: var(--bg-main); color: var(--text-primary); font-family: 'Inter', sans-serif; padding-top: 20px; }
        .container { max-width: 1200px; margin: 0 auto; padding: 2rem; }
        header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem; }
        .btn-back { background: #333; color: white; padding: 0.6rem 1.2rem; border-radius: 0.5rem; text-decoration: none; font-weight: 700; font-size: 0.85rem; }
        .reseller-table { width: 100%; border-collapse: collapse; background: var(--bg-card); border-radius: 12px; overflow: hidden; border: 1px solid var(--border); }
        .reseller-table th, .reseller-table td { padding: 1.2rem; text-align: left; border-bottom: 1px solid var(--border); }
        .reseller-table th { background: #000; color: var(--accent-red); text-transform: uppercase; font-size: 0.8rem; letter-spacing: 1px; }
        .modal-overlay {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.85);
            z-index: 3000;
            align-items: center;
            justify-content: center;
        }
        .modal-content {
            background: #1a1a1a;
            padding: 2rem;
            border-radius: 1rem;
            width: 90%;
            max-width: 500px;
            border: 1px solid var(--border);
        }
        .modal-content h3 { color: var(--accent-red); margin-bottom: 1.5rem; }
        .form-group { margin-bottom: 1rem; }
        .form-group label { display: block; margin-bottom: 0.5rem; font-size: 0.8rem; color: var(--text-muted); }
        .form-group input { width: 100%; background: #000; border: 1px solid var(--border); color: #fff; padding: 10px; border-radius: 6px; }
        .modal-footer { display: flex; justify-content: flex-end; gap: 10px; margin-top: 1.5rem; }
        .btn-save { background: var(--accent-red); color: #fff; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; font-weight: 700; }
        .btn-cancel { background: #333; color: #fff; border: none; padding: 10px 20px; border-radius: 6px; cursor: pointer; }
        .reseller-table tr:hover { background: #1a1a1a; }
        .reseller-name { font-weight: 700; font-size: 1.1rem; }
        .reseller-info { color: var(--text-muted); font-size: 0.9rem; }
        .badge-requests { background: rgba(229, 9, 20, 0.1); color: var(--accent-red); padding: 4px 8px; border-radius: 6px; font-weight: 800; font-size: 0.8rem; }
        .actions { display: flex; gap: 10px; }
        .btn-action { background: transparent; border: 1px solid var(--border); color: var(--text-primary); padding: 6px 10px; border-radius: 6px; cursor: pointer; transition: all 0.2s; }
        .btn-delete:hover { background: var(--accent-red); border-color: var(--accent-red); }
        .whatsapp-link { color: #10b981; text-decoration: none; }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1><i class="fas fa-users-cog"></i> Gestão de Revendedores</h1>
            <div style="display: flex; align-items: center; gap: 15px;">
                <button id="themeToggleBtn" style="background: transparent; border: none; color: var(--text-primary); font-size: 1.15rem; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; width: 35px; height: 35px; border-radius: 50%; transition: background 0.3s;" onclick="toggleTheme()" title="Alternar Tema">
                    <i class="fas fa-sun" id="themeIcon" style="color: #f59e0b;"></i>
                </button>
                <a href="/admin/dashboard" class="btn-back"><i class="fas fa-arrow-left"></i> Voltar à Dashboard</a>
            </div>
        </header>

        <table class="reseller-table">
            <thead>
                <tr>
                    <th>Revendedor</th>
                    <th>Contato</th>
                    <th>Pedidos</th>
                    <th>Cadastrado em</th>
                    <th>Ações</th>
                </tr>
            </thead>
            <tbody>
                <% resellers.forEach(res => { %>
                    <tr id="reseller-<%= res.id %>">
                        <td>
                            <div class="reseller-name"><%= res.name %></div>
                            <div class="reseller-info"><%= res.email %></div>
                        </td>
                        <td>
                            <div class="reseller-info"><i class="fas fa-phone"></i> <%= res.phone %></div>
                            <a href="https://wa.me/<%= res.whatsapp.replace(/\D/g, '') %>" target="_blank" class="whatsapp-link">
                                <i class="fab fa-whatsapp"></i> WhatsApp
                            </a>
                        </td>
                        <td>
                            <span class="badge-requests" title="Total de pedidos"><%= res.totalRequests %> Pedidos</span>
                            <button class="btn-action" style="margin-left: 10px; font-size: 0.7rem;" 
                                    onclick="clearRequests(<%= res.id %>, '<%= res.name %>')" title="Limpar todos os pedidos">
                                <i class="fas fa-broom"></i> Limpar
                            </button>
                        </td>
                        <td class="reseller-info">
                            <%= res.created_at ? new Date(res.created_at).toLocaleDateString('pt-BR') : 'N/A' %>
                        </td>
                        <td class="actions">
                            <button class="btn-action" 
                                onclick="openEditModal({id: <%= res.id %>, name: '<%= res.name %>', email: '<%= res.email %>', phone: '<%= res.phone %>', whatsapp: '<%= res.whatsapp %>', password: '<%= res.password %>'})" 
                                title="Editar Dados">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="btn-action btn-delete" onclick="deleteReseller(<%= res.id %>, '<%= res.name %>')" title="Excluir Revendedor">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- Modal de Edição -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-content">
            <h3>Editar Revendedor</h3>
            <form id="editForm">
                <input type="hidden" id="edit-id">
                <div class="form-group">
                    <label>Nome</label>
                    <input type="text" id="edit-name" required>
                </div>
                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" id="edit-email" required>
                </div>
                <div class="form-group">
                    <label>Telefone</label>
                    <input type="text" id="edit-phone">
                </div>
                <div class="form-group">
                    <label>WhatsApp</label>
                    <input type="text" id="edit-whatsapp">
                </div>
                <div class="form-group">
                    <label>Senha</label>
                    <input type="password" id="edit-password" placeholder="Nova senha">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-cancel" onclick="closeEditModal()">Cancelar</button>
                    <button type="submit" class="btn-save">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(data) {
            document.getElementById('edit-id').value = data.id;
            document.getElementById('edit-name').value = data.name;
            document.getElementById('edit-email').value = data.email;
            document.getElementById('edit-phone').value = data.phone;
            document.getElementById('edit-whatsapp').value = data.whatsapp;
            document.getElementById('edit-password').value = data.password;
            document.getElementById('editModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }

        async function clearRequests(id, name) {
            if (!confirm(`Deseja apagar TODOS os pedidos de ${name}?\nEsta ação não pode ser desfeita.`)) return;
            try {
                const res = await fetch(`/api/resellers/${id}/requests`, { method: 'DELETE' });
                if (res.ok) { location.reload(); } else { alert('Erro ao limpar pedidos.'); }
            } catch (e) { alert('Erro na comunicação.'); }
        }

        async function deleteReseller(id, name) {
            if (!confirm(`Deseja REALMENTE excluir o revendedor ${name}?\nIsso apagará permanentemente o acesso dele.`)) return;

            try {
                const res = await fetch(`/api/resellers/${id}`, { method: 'DELETE' });
                if (res.ok) {
                    document.getElementById(`reseller-${id}`).remove();
                } else {
                    alert('Erro ao excluir revendedor.');
                }
            } catch (e) {
                alert('Erro na comunicação com o servidor.');
            }
        }

        document.getElementById('editForm').onsubmit = async (e) => {
            e.preventDefault();
            const id = document.getElementById('edit-id').value;
            const payload = {
                name: document.getElementById('edit-name').value,
                email: document.getElementById('edit-email').value,
                phone: document.getElementById('edit-phone').value,
                whatsapp: document.getElementById('edit-whatsapp').value,
                password: document.getElementById('edit-password').value
            };

            try {
                const res = await fetch(`/api/resellers/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                if (res.ok) {
                    location.reload();
                } else {
                    alert('Erro ao atualizar dados.');
                }
            } catch (e) { alert('Erro na comunicação.'); }
        };

        function toggleTheme() {
            const isLight = document.body.classList.toggle('light-theme');
            localStorage.setItem('theme', isLight ? 'light' : 'dark');
            updateThemeIcon(isLight);
        }

        function updateThemeIcon(isLight) {
            const icon = document.getElementById('themeIcon');
            if (icon) {
                if (isLight) {
                    icon.className = 'fas fa-moon';
                    icon.style.color = '#374151';
                } else {
                    icon.className = 'fas fa-sun';
                    icon.style.color = '#f59e0b';
                }
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            const isLight = document.body.classList.contains('light-theme');
            updateThemeIcon(isLight);
        });
    </script>
</body>
</html>